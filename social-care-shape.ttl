@prefix linkml: <https://w3id.org/linkml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://ns.socialcaredata.io/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sc:ActualPlacementShape a sh:NodeShape ;
    rdfs:comment "The placement actually arranged for the child, including weekly cost, location, provider URN, sibling co-placement and educational continuity. Optional - a Placement may not (yet) have one." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the child's education was continuous (i.e., not disrupted) as a result of this placement." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path sc:isEducationContinuous ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether the total weekly cost includes charges for support or services beyond the core placement fee, such as additional staffing (e.g. 2:1 or waking night cover), therapeutic or clinical input, education provision, or other bespoke support agreed for the child." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path sc:costIncludesAdditionalPackages ],
        [ sh:description "How the placement was sourced." ;
            sh:in ( <https://ns.socialcaredata.io/placement-source#RCCContract> <https://ns.socialcaredata.io/placement-source#OtherRegionalContract> <https://ns.socialcaredata.io/placement-source#DirectAwardOffFramework> <https://ns.socialcaredata.io/placement-source#LocalContractOrFramework> <https://ns.socialcaredata.io/placement-source#BlockContract> <https://ns.socialcaredata.io/placement-source#Remand> <https://ns.socialcaredata.io/placement-source#SecureWelfareHub> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path sc:placementSource ],
        [ sh:description "The type of placement the child received." ;
            sh:in ( <https://ns.socialcaredata.io/placement-type#Foster> <https://ns.socialcaredata.io/placement-type#Residential> <https://ns.socialcaredata.io/placement-type#SupportedAccommodation> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path sc:placementType ],
        [ sh:datatype xsd:date ;
            sh:description "The date the placement started." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:placementStartDate ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the actual placement location was a preferred location." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path sc:isLocationPreferred ],
        [ sh:datatype xsd:string ;
            sh:description "First 3-4 characters of the postcode (UK outward code) for the actual placement location." ;
            sh:maxCount 1 ;
            sh:message "Use the first part of a UK postcode (the outward code) in upper case - for example `AB1`."^^xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path sc:placementLocation ;
            sh:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]?$" ],
        [ sh:description "The reason the placement was not found in the preferred location. Use 'Not applicable' when the placement was in the preferred location." ;
            sh:in ( <https://ns.socialcaredata.io/non-preferred-location-reason#CYPParentalPreference> <https://ns.socialcaredata.io/non-preferred-location-reason#SafeguardingRequirement> <https://ns.socialcaredata.io/non-preferred-location-reason#ProvisionWithinDistanceNotAvailable> <https://ns.socialcaredata.io/non-preferred-location-reason#ProvisionWithinDistanceDoesNotExist> <https://ns.socialcaredata.io/non-preferred-location-reason#CarerMovingOutOfArea> <https://ns.socialcaredata.io/non-preferred-location-reason#LegalReasons> <https://ns.socialcaredata.io/non-preferred-location-reason#NotApplicable> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path sc:nonPreferredLocationReason ],
        [ sh:datatype xsd:string ;
            sh:description "Provider Unique Reference Number, linked to Ofsted registration. Allows the placement to be linked to Ofsted data about the provider." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:providerURN ],
        [ sh:datatype xsd:decimal ;
            sh:description "Total weekly fee paid for the placement, excluding VAT. Expected to be between £100 and £100,000." ;
            sh:maxCount 1 ;
            sh:maxInclusive 100000 ;
            sh:minCount 1 ;
            sh:minInclusive 100 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path sc:totalWeeklyCost ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "How many siblings were actually placed together." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path sc:siblingsPlacedTogether ] ;
    sh:targetClass sc:ActualPlacement .

sc:AddressShape a sh:NodeShape ;
    rdfs:comment "A postal address. Aligned with FHIR Address. UPRN and USRN support property- and street-level disambiguation." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "How this address is used - home, work, temp, etc." ;
            sh:in ( <https://ns.socialcaredata.io/address-use-code#Home> <https://ns.socialcaredata.io/address-use-code#Work> <https://ns.socialcaredata.io/address-use-code#Temp> <https://ns.socialcaredata.io/address-use-code#Old> <https://ns.socialcaredata.io/address-use-code#Billing> ) ;
            sh:maxCount 1 ;
            sh:name "use" ;
            sh:order 6 ;
            sh:path sc:use ],
        [ sh:datatype xsd:string ;
            sh:description "Unique Property Reference Number of the address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path sc:UPRN ],
        [ sh:datatype xsd:string ;
            sh:description "Apartment, suite, unit, building, floor, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:line2 ],
        [ sh:datatype xsd:string ;
            sh:description "Unique Street Reference Number of the address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path sc:USRN ],
        [ sh:datatype xsd:string ;
            sh:description "City, town, or village." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:city ],
        [ sh:datatype xsd:string ;
            sh:description "Street address (e.g. \"1 High Street\") or care-of line." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:line1 ],
        [ sh:datatype xsd:string ;
            sh:description "UK postcode in standard format (e.g. AB1 2CD)." ;
            sh:maxCount 1 ;
            sh:message "Use a UK postcode in upper case, with an optional space - for example `AB1 2CD`."^^xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:postcode ;
            sh:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$" ] ;
    sh:targetClass sc:Address .

sc:AssessmentQuestionShape a sh:NodeShape ;
    rdfs:comment "A generic Question-and-Answer model used to represent both statutory and local, personalised questions." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether this question was mandatory on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path sc:required ],
        [ sh:datatype xsd:string ;
            sh:description "An ID for the question. Standards may define a dictionary of IDs for statutory or well-known questions; for personalised, local questions, this can be anything or left blank." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:questionId ],
        [ sh:description "Indicates how the answer should be parsed (e.g., String, Boolean, Date, Number, Enum). Ensures data like dates or booleans aren't trapped as unparsable text." ;
            sh:in ( <https://ns.socialcaredata.io/answer-type#String> <https://ns.socialcaredata.io/answer-type#Boolean> <https://ns.socialcaredata.io/answer-type#Date> <https://ns.socialcaredata.io/answer-type#Number> <https://ns.socialcaredata.io/answer-type#Enum> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path sc:answerType ],
        [ sh:datatype xsd:string ;
            sh:description "The exact wording of the question as it appears on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:questionText ],
        [ sh:datatype xsd:string ;
            sh:description "The answer to the question." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:answer ],
        [ sh:datatype xsd:string ;
            sh:description "The domain/category of the question." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:category ] ;
    sh:targetClass sc:AssessmentQuestion .

sc:CareActivityShape a sh:NodeShape ;
    rdfs:comment "The description and details of the care component activity." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Flag whether this component is paid via direct payment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:directPayment ],
        [ sh:description "Care Act outcome that this care component is aiming to help the subject person achieve." ;
            sh:in ( <https://ns.socialcaredata.io/care-outcome-type#CANutrition> <https://ns.socialcaredata.io/care-outcome-type#CAHygiene> <https://ns.socialcaredata.io/care-outcome-type#CAToilet> <https://ns.socialcaredata.io/care-outcome-type#CAClothing> <https://ns.socialcaredata.io/care-outcome-type#CAHomeSafety> <https://ns.socialcaredata.io/care-outcome-type#CAHabitableHome> <https://ns.socialcaredata.io/care-outcome-type#CAMaintainingRelationships> <https://ns.socialcaredata.io/care-outcome-type#CAWTEV> <https://ns.socialcaredata.io/care-outcome-type#CACommunityServices> <https://ns.socialcaredata.io/care-outcome-type#CAResponsibilityForOthers> ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path sc:outcome ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the care component." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:activityDescription ] ;
    sh:targetClass sc:CareActivity .

sc:CareActorShape a sh:NodeShape ;
    rdfs:comment "The actor performing a care component." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The type of person performing the component of the plan." ;
            sh:in ( <https://ns.socialcaredata.io/care-actor-type#Self> <https://ns.socialcaredata.io/care-actor-type#Family> <https://ns.socialcaredata.io/care-actor-type#Friend> <https://ns.socialcaredata.io/care-actor-type#Community> <https://ns.socialcaredata.io/care-actor-type#OtherUnpaidCarer> <https://ns.socialcaredata.io/care-actor-type#ProfessionalServices> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path sc:actorType ],
        [ sh:class sc:Identifier ;
            sh:description "The ID of the person performing the item of the plan (Person ID, professional ID, or service ID)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:actorId ] ;
    sh:targetClass sc:CareActor .

sc:CareAssessmentQuestionShape a sh:NodeShape ;
    rdfs:comment "A generic Question-and-Answer model used to represent both statutory Care Act questions and local, personalised fields." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether this question was mandatory on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path sc:required ],
        [ sh:datatype xsd:string ;
            sh:description "An ID for the question. Standards may define a dictionary of IDs for statutory or well-known questions; for personalised, local questions, this can be anything or left blank." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:questionId ],
        [ sh:description "The domain/category of the question." ;
            sh:in ( <https://ns.socialcaredata.io/question-category#PersonalContext> <https://ns.socialcaredata.io/question-category#Health> <https://ns.socialcaredata.io/question-category#Housing> <https://ns.socialcaredata.io/question-category#Finance> <https://ns.socialcaredata.io/question-category#CommunicationNeeds> <https://ns.socialcaredata.io/question-category#CANutrition> <https://ns.socialcaredata.io/question-category#CAHygiene> <https://ns.socialcaredata.io/question-category#CAToilet> <https://ns.socialcaredata.io/question-category#CAClothing> <https://ns.socialcaredata.io/question-category#CAHomeSafety> <https://ns.socialcaredata.io/question-category#CAHabitableHome> <https://ns.socialcaredata.io/question-category#CAMaintainingRelationships> <https://ns.socialcaredata.io/question-category#CAWTEV> <https://ns.socialcaredata.io/question-category#CACommunityServices> <https://ns.socialcaredata.io/question-category#CAResponsibilityForOthers> <https://ns.socialcaredata.io/question-category#Eligibility> <https://ns.socialcaredata.io/question-category#Emergencies> <https://ns.socialcaredata.io/question-category#Other> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path sc:category ],
        [ sh:datatype xsd:string ;
            sh:description "The exact wording of the question as it appears on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:questionText ],
        [ sh:datatype xsd:string ;
            sh:description "The answer to the question." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:answer ],
        [ sh:description "Indicates how the answer should be parsed (e.g., String, Boolean, Date, Number, Enum). Ensures data like dates or booleans aren't trapped as unparsable text." ;
            sh:in ( <https://ns.socialcaredata.io/answer-type#String> <https://ns.socialcaredata.io/answer-type#Boolean> <https://ns.socialcaredata.io/answer-type#Date> <https://ns.socialcaredata.io/answer-type#Number> <https://ns.socialcaredata.io/answer-type#Enum> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path sc:answerType ] ;
    sh:targetClass sc:CareAssessmentQuestion .

sc:CareComponentShape a sh:NodeShape ;
    rdfs:comment "A specific component of a Care Plan, capturing who does what, when, and to achieve which outcomes." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:CareActivity ;
            sh:description "The activity details of this component of the plan." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:activity ],
        [ sh:class sc:Timing ;
            sh:description "The schedule and timing information of this component of the plan." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:time ],
        [ sh:class sc:CareActor ;
            sh:description "The actors performing this component of the plan." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:actor ] ;
    sh:targetClass sc:CareComponent .

sc:CareNeedsAssessmentShape a sh:NodeShape ;
    rdfs:comment "A Care Needs Assessment record, completed when an adult contacts or is referred to a local authority's social services team." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Identifier ;
            sh:description "Identifier for the safeguarding or care service episode during which this assessment / plan was completed." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path sc:serviceEpisodeId ],
        [ sh:description "Status of the document. Lifted from FHIR CarePlan status." ;
            sh:in ( <https://ns.socialcaredata.io/care-document-status#draft> <https://ns.socialcaredata.io/care-document-status#active> <https://ns.socialcaredata.io/care-document-status#on-hold> <https://ns.socialcaredata.io/care-document-status#entered-in-error> <https://ns.socialcaredata.io/care-document-status#ended> <https://ns.socialcaredata.io/care-document-status#completed> <https://ns.socialcaredata.io/care-document-status#revoked> <https://ns.socialcaredata.io/care-document-status#unknown> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path sc:status ],
        [ sh:class sc:Identifier ;
            sh:description "Any care plan linked to this assessment. Quick signpost that a) a plan was made (ie the person was determined to be eligible) and b) where the plan is (so you don't need to search for it)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:planId ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person require an advocate to complete this assessment / plan?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path sc:advocateRequired ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person have the mental and physical capacity to complete this assessment / plan?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path sc:capacityToCompleteAssessment ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date and time that the assessment / plan was completed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path sc:dateCompleted ],
        [ sh:class sc:Review ;
            sh:description "List of reviews." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path sc:review ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person consent to information sharing?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path sc:consentToInformationSharing ],
        [ sh:class sc:CareAssessmentQuestion ;
            sh:description "The set of assessment questions and answers." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:assessmentQuestion ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for the subject person." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sc:personId ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for the professional that authored the assessment/plan. Note that we don't need a serviceID, because you can find the service through the professional." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:professionalId ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for this assessment / plan." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path sc:identifier ] ;
    sh:targetClass sc:CareNeedsAssessment .

sc:CarePlanShape a sh:NodeShape ;
    rdfs:comment "A Care Plan record, created immediately after an assessment if the person is found to be eligible." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Identifier ;
            sh:description "Identifier for the safeguarding or care service episode during which this assessment / plan was completed." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path sc:serviceEpisodeId ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person require an advocate to complete this assessment / plan?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path sc:advocateRequired ],
        [ sh:description "Status of the document. Lifted from FHIR CarePlan status." ;
            sh:in ( <https://ns.socialcaredata.io/care-document-status#draft> <https://ns.socialcaredata.io/care-document-status#active> <https://ns.socialcaredata.io/care-document-status#on-hold> <https://ns.socialcaredata.io/care-document-status#entered-in-error> <https://ns.socialcaredata.io/care-document-status#ended> <https://ns.socialcaredata.io/care-document-status#completed> <https://ns.socialcaredata.io/care-document-status#revoked> <https://ns.socialcaredata.io/care-document-status#unknown> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path sc:status ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person have the mental and physical capacity to complete this assessment / plan?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path sc:capacityToCompleteAssessment ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date and time that the assessment / plan was completed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path sc:dateCompleted ],
        [ sh:class sc:CareComponent ;
            sh:description "Components of the care package." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:careComponent ],
        [ sh:class sc:Review ;
            sh:description "List of reviews." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path sc:review ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person consent to information sharing?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path sc:consentToInformationSharing ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for the subject person." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sc:personId ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for the professional that authored the assessment/plan. Note that we don't need a serviceID, because you can find the service through the professional." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:professionalId ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for this assessment / plan." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path sc:identifier ],
        [ sh:class sc:Identifier ;
            sh:description "Assessment that led to this plan." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:assessmentId ] ;
    sh:targetClass sc:CarePlan .

sc:CommunicationShape a sh:NodeShape ;
    rdfs:comment "Professional recording of a person's communication requirements and language proficiencies." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Language ;
            sh:description "Specific language(s) spoken or understood by the person, optionally annotated with proficiency." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:language ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text describing professionally recorded communication needs or reasonable adjustments (e.g. BSL interpreter needed, uses communication board)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:specialCommunicationNeeds ] ;
    sh:targetClass sc:Communication .

sc:ContactShape a sh:NodeShape ;
    rdfs:comment "Contact details, such as a home, work, or other contact channel grouping." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "One or more telephone numbers." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:telephone ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the contact type (for example, \"Home\", \"Work\", \"Other\")." ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:contactName ],
        [ sh:datatype xsd:string ;
            sh:description "One or more email addresses." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:email ] ;
    sh:targetClass sc:Contact .

sc:FindingShape a sh:NodeShape ;
    rdfs:comment "An observation or measurement made during the course of a service episode about the subject and their circumstances. May be recorded as a structured Observation, a quantitative Measurement, and/or free text." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A finding that cannot be represented as an Observation or Measurement." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:text ],
        [ sh:class sc:Observation ;
            sh:description "Qualitative observation(s) about the subject or their circumstances." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:observation ],
        [ sh:class sc:Measurement ;
            sh:description "Quantitative measurement(s) about the subject or their circumstances." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:measurement ] ;
    sh:targetClass sc:Finding .

sc:FoundationalInformationShape a sh:NodeShape ;
    rdfs:comment "Information that is relevant across both assessments and plans." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Does the person have the mental and physical capacity to complete this assessment / plan?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path sc:capacityToCompleteAssessment ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for the safeguarding or care service episode during which this assessment / plan was completed." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path sc:serviceEpisodeId ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person require an advocate to complete this assessment / plan?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path sc:advocateRequired ],
        [ sh:datatype xsd:boolean ;
            sh:description "Does the person consent to information sharing?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path sc:consentToInformationSharing ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for the professional that authored the assessment/plan. Note that we don't need a serviceID, because you can find the service through the professional." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:professionalId ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date and time that the assessment / plan was completed." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:dateCompleted ],
        [ sh:class sc:Review ;
            sh:description "List of reviews." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path sc:review ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for this assessment / plan." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:class sc:Identifier ;
            sh:description "Identifier for the subject person." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:personId ] ;
    sh:targetClass sc:FoundationalInformation .

sc:IdentifierShape a sh:NodeShape ;
    rdfs:comment "A single identifier for a person or entity, comprising the value and the system in whose namespace the value is unique. Aligned with FHIR Identifier and the NHS PDS UNIQUE_REFERENCE definition." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The identifier value, unique within the issuing system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:value ],
        [ sh:description "The URI of the system or namespace within which the identifier is unique (e.g. https://fhir.nhs.uk/Id/nhs-number)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path sc:system ] ;
    sh:targetClass sc:Identifier .

sc:LanguageShape a sh:NodeShape ;
    rdfs:comment "A specific language the person is proficient in, including proficiency level." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The level of proficiency or fluency in the language (e.g., 'fluent', 'native', 'basic')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:proficiencyLevel ],
        [ sh:datatype xsd:string ;
            sh:description "A code or name representing the language (e.g., 'en', 'eng', 'bsl', 'British Sign Language')." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:languageCode ] ;
    sh:targetClass sc:Language .

sc:LifeEventShape a sh:NodeShape ;
    rdfs:comment "A significant, time-bound occurrence in an individual's life that may have implications for their safety, wellbeing or development - for example attendance at A&E, a child being reported as missing, or an exclusion from school. Life events are not inherently positive or negative but can signal levels of risk, vulnerability or changing need." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Details about the location of the episode or life event." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path sc:location ],
        [ sh:class sc:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:description "Code(s) for the type of life event." ;
            sh:in ( <https://ns.socialcaredata.io/event-code#Birth> <https://ns.socialcaredata.io/event-code#Death> <https://ns.socialcaredata.io/event-code#AeAttendance> <https://ns.socialcaredata.io/event-code#SchoolExclusion> <https://ns.socialcaredata.io/event-code#SchoolSuspension> <https://ns.socialcaredata.io/event-code#MissingPerson> <https://ns.socialcaredata.io/event-code#SafeguardingConcern> <https://ns.socialcaredata.io/event-code#Referral> <https://ns.socialcaredata.io/event-code#Homeless> ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 1 ;
            sh:path sc:eventType ],
        [ sh:class sc:Identifier ;
            sh:description "References (by Identifier) to Services associated with the entity." ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sc:relatedService ],
        [ sh:class sc:Timing ;
            sh:description "Details about the timing of the episode or life event." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:timeInformation ],
        [ sh:class sc:SubjectPerson ;
            sh:description "References to the Person(s) the episode or life event concerns." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:subjectPerson ],
        [ sh:class sc:RelatedProfessional ;
            sh:description "References to the Professional(s) involved, qualified by involvement." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path sc:relatedProfessional ] ;
    sh:targetClass sc:LifeEvent .

sc:MeasurementShape a sh:NodeShape ;
    rdfs:comment "A quantitative measurement of something related to the subject or their circumstances (for example \"Authorised Absences\" or \"Referrals\")." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "A decimal number representing the value of the measurement." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "value" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:measurementValue ],
        [ sh:description "The unit of measurement." ;
            sh:in ( <https://ns.socialcaredata.io/measurement-unit#Count> <https://ns.socialcaredata.io/measurement-unit#Pct> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "unit" ;
            sh:order 1 ;
            sh:path sc:unit ],
        [ sh:description "The type of measurement." ;
            sh:in ( <https://ns.socialcaredata.io/measurement-type#Attendance> <https://ns.socialcaredata.io/measurement-type#AuthorisedAbsences> <https://ns.socialcaredata.io/measurement-type#UnauthorisedAbsences> <https://ns.socialcaredata.io/measurement-type#CaringHoursPerWeek> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 2 ;
            sh:path sc:measurementType ] ;
    sh:targetClass sc:Measurement .

sc:NameShape a sh:NodeShape ;
    rdfs:comment "Container for a person's name parts, aligned with FHIR HumanName. A person may have multiple names with different uses." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Any preferred given or middle name used by the person - for example, \"Joe\" where their legal first name is \"Joseph\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:preferredName ],
        [ sh:datatype xsd:string ;
            sh:description "The first name and any middle names." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:givenName ],
        [ sh:description "The purpose of this name instance - usual, official, former, etc." ;
            sh:in ( <https://ns.socialcaredata.io/name-use-code#Usual> <https://ns.socialcaredata.io/name-use-code#Official> <https://ns.socialcaredata.io/name-use-code#Temp> <https://ns.socialcaredata.io/name-use-code#Nickname> <https://ns.socialcaredata.io/name-use-code#Anonymous> <https://ns.socialcaredata.io/name-use-code#Old> <https://ns.socialcaredata.io/name-use-code#Maiden> ) ;
            sh:maxCount 1 ;
            sh:name "use" ;
            sh:order 3 ;
            sh:path sc:use ],
        [ sh:datatype xsd:string ;
            sh:description "The surname or family name. Multi-valued to support compound or hyphenated family names recorded as separate parts." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:familyName ] ;
    sh:targetClass sc:Name .

sc:ObservationShape a sh:NodeShape ;
    rdfs:comment "A qualitative observation that represents an attribute of the subject or their circumstances (for example \"NEET\" or \"free-school-meals\")." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The type of observation, drawn from the Observation Type Vocabulary (e.g. NEET, free-school-meals, SEND.SpLD). The vocabulary is extensible (some codes carry dynamic sub-parts such as EAL.<ISO 639-1 code>), so it is modelled as an open string rather than a closed enumeration. See the ObservationType enum for the reference list of codes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:observationType ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date at which this observation was made false (if now outdated)." ;
            sh:maxCount 1 ;
            sh:name "endDate" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:endDate ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date at which this observation was first true, as an ISO 8601 date-time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "startDate" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:startDate ] ;
    sh:targetClass sc:Observation .

sc:OrganisationShape a sh:NodeShape ;
    rdfs:comment "An organisation involved in the safeguarding or wellbeing of a person - for example a local authority, an NHS trust, a school, or an education authority. Aligns with the FHIR Organization resource." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Other names the entity is known by." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:alias ],
        [ sh:datatype xsd:boolean ;
            sh:description "Code for the entity's status - whether it is currently active." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path sc:active ],
        [ sh:class sc:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:class sc:Address ;
            sh:description "Physical location(s) of the entity." ;
            sh:name "address" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:address ],
        [ sh:class sc:Identifier ;
            sh:description "References (by Identifier) to Professionals associated with the entity." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path sc:relatedProfessional ],
        [ sh:description "Code(s) for the kind of organisation." ;
            sh:in ( <https://ns.socialcaredata.io/organisation-code#LocalAuthority> <https://ns.socialcaredata.io/organisation-code#NhsTrust> <https://ns.socialcaredata.io/organisation-code#PoliceForce> ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 3 ;
            sh:path sc:organisationType ],
        [ sh:class sc:Contact ;
            sh:description "Contact information for the organisation." ;
            sh:minCount 1 ;
            sh:name "contact" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path sc:contact ],
        [ sh:datatype xsd:string ;
            sh:description "The official name of the organisation or service." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:entityName ],
        [ sh:class sc:Identifier ;
            sh:description "References to Services the organisation provides or contributes to." ;
            sh:minCount 1 ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path sc:relatedService ] ;
    sh:targetClass sc:Organisation .

sc:PartialDateShape a sh:NodeShape ;
    rdfs:comment "Container for a date that may not be fully known or precise, extended with an accuracy indicator. Used for dates of birth and dates of death." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "ISO 8601-formatted date (YYYY-MM-DD)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:date ],
        [ sh:datatype xsd:string ;
            sh:description "A three-character code in day-month-year order indicating which parts of the date are accurate (A), estimated (E), or unknown (U)." ;
            sh:maxCount 1 ;
            sh:message "Use three letters, each one A, E or U - for example `AEU`."^^xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:accuracyIndicator ;
            sh:pattern "^[AEU]{3}$" ] ;
    sh:targetClass sc:PartialDate .

sc:PersonRelationshipShape a sh:NodeShape ;
    rdfs:comment "A typed reference from one person to another. The reference is by Identifier (so the related person may live in a different system) and is qualified by one or more relationship codes." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Identifier ;
            sh:description "Reference to the related person's Identifier (system + value)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:description "One or more codes describing the kind of relationship." ;
            sh:in ( <https://ns.socialcaredata.io/person-relationship-code#FAMMEMB> <https://ns.socialcaredata.io/person-relationship-code#CHILD> <https://ns.socialcaredata.io/person-relationship-code#NCHILD> <https://ns.socialcaredata.io/person-relationship-code#CHLDADOPT> <https://ns.socialcaredata.io/person-relationship-code#DAUADOPT> <https://ns.socialcaredata.io/person-relationship-code#SONADOPT> <https://ns.socialcaredata.io/person-relationship-code#CHLDFOST> <https://ns.socialcaredata.io/person-relationship-code#DAUFOST> <https://ns.socialcaredata.io/person-relationship-code#SONFOST> <https://ns.socialcaredata.io/person-relationship-code#DAUC> <https://ns.socialcaredata.io/person-relationship-code#DAU> <https://ns.socialcaredata.io/person-relationship-code#STPDAU> <https://ns.socialcaredata.io/person-relationship-code#SON> <https://ns.socialcaredata.io/person-relationship-code#SONC> <https://ns.socialcaredata.io/person-relationship-code#STPSON> <https://ns.socialcaredata.io/person-relationship-code#STPCHLD> <https://ns.socialcaredata.io/person-relationship-code#EXT> <https://ns.socialcaredata.io/person-relationship-code#AUNT> <https://ns.socialcaredata.io/person-relationship-code#MAUNT> <https://ns.socialcaredata.io/person-relationship-code#PAUNT> <https://ns.socialcaredata.io/person-relationship-code#UNCLE> <https://ns.socialcaredata.io/person-relationship-code#MUNCLE> <https://ns.socialcaredata.io/person-relationship-code#PUNCLE> <https://ns.socialcaredata.io/person-relationship-code#COUSN> <https://ns.socialcaredata.io/person-relationship-code#MCOUSN> <https://ns.socialcaredata.io/person-relationship-code#PCOUSN> <https://ns.socialcaredata.io/person-relationship-code#NIENEPH> <https://ns.socialcaredata.io/person-relationship-code#NEPHEW> <https://ns.socialcaredata.io/person-relationship-code#NIECE> <https://ns.socialcaredata.io/person-relationship-code#GGRPRN> <https://ns.socialcaredata.io/person-relationship-code#GGRFTH> <https://ns.socialcaredata.io/person-relationship-code#MGGRFTH> <https://ns.socialcaredata.io/person-relationship-code#PGGRFTH> <https://ns.socialcaredata.io/person-relationship-code#GGRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGGRMTH> <https://ns.socialcaredata.io/person-relationship-code#PGGRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGGRPRN> <https://ns.socialcaredata.io/person-relationship-code#PGGRPRN> <https://ns.socialcaredata.io/person-relationship-code#GRPRN> <https://ns.socialcaredata.io/person-relationship-code#GRFTH> <https://ns.socialcaredata.io/person-relationship-code#MGRFTH> <https://ns.socialcaredata.io/person-relationship-code#PGRFTH> <https://ns.socialcaredata.io/person-relationship-code#GRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGRMTH> <https://ns.socialcaredata.io/person-relationship-code#PGRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGRPRN> <https://ns.socialcaredata.io/person-relationship-code#PGRPRN> <https://ns.socialcaredata.io/person-relationship-code#GRNDCHILD> <https://ns.socialcaredata.io/person-relationship-code#GRNDDAU> <https://ns.socialcaredata.io/person-relationship-code#GRNDSON> <https://ns.socialcaredata.io/person-relationship-code#INLAW> <https://ns.socialcaredata.io/person-relationship-code#CHLDINLAW> <https://ns.socialcaredata.io/person-relationship-code#DAUINLAW> <https://ns.socialcaredata.io/person-relationship-code#SONINLAW> <https://ns.socialcaredata.io/person-relationship-code#PRNINLAW> <https://ns.socialcaredata.io/person-relationship-code#FTHINLAW> <https://ns.socialcaredata.io/person-relationship-code#MTHINLAW> <https://ns.socialcaredata.io/person-relationship-code#SIBINLAW> <https://ns.socialcaredata.io/person-relationship-code#BROINLAW> <https://ns.socialcaredata.io/person-relationship-code#SISINLAW> <https://ns.socialcaredata.io/person-relationship-code#PRN> <https://ns.socialcaredata.io/person-relationship-code#NPRN> <https://ns.socialcaredata.io/person-relationship-code#ADOPTP> <https://ns.socialcaredata.io/person-relationship-code#ADOPTF> <https://ns.socialcaredata.io/person-relationship-code#ADOPTM> <https://ns.socialcaredata.io/person-relationship-code#PRNFOST> <https://ns.socialcaredata.io/person-relationship-code#STPPRN> <https://ns.socialcaredata.io/person-relationship-code#FTH> <https://ns.socialcaredata.io/person-relationship-code#NFTH> <https://ns.socialcaredata.io/person-relationship-code#FTHFOST> <https://ns.socialcaredata.io/person-relationship-code#STPFTH> <https://ns.socialcaredata.io/person-relationship-code#MTH> <https://ns.socialcaredata.io/person-relationship-code#NMTH> <https://ns.socialcaredata.io/person-relationship-code#GESTM> <https://ns.socialcaredata.io/person-relationship-code#MTHFOST> <https://ns.socialcaredata.io/person-relationship-code#STPMTH> <https://ns.socialcaredata.io/person-relationship-code#SIB> <https://ns.socialcaredata.io/person-relationship-code#NSIB> <https://ns.socialcaredata.io/person-relationship-code#HSIB> <https://ns.socialcaredata.io/person-relationship-code#STPSIB> <https://ns.socialcaredata.io/person-relationship-code#BRO> <https://ns.socialcaredata.io/person-relationship-code#NBRO> <https://ns.socialcaredata.io/person-relationship-code#HBRO> <https://ns.socialcaredata.io/person-relationship-code#STPBRO> <https://ns.socialcaredata.io/person-relationship-code#SIS> <https://ns.socialcaredata.io/person-relationship-code#NSIS> <https://ns.socialcaredata.io/person-relationship-code#HSIS> <https://ns.socialcaredata.io/person-relationship-code#STPSIS> <https://ns.socialcaredata.io/person-relationship-code#TWIN> <https://ns.socialcaredata.io/person-relationship-code#TWINBRO> <https://ns.socialcaredata.io/person-relationship-code#TWINSIS> <https://ns.socialcaredata.io/person-relationship-code#ITWIN> <https://ns.socialcaredata.io/person-relationship-code#ITWINBRO> <https://ns.socialcaredata.io/person-relationship-code#ITWINSIS> <https://ns.socialcaredata.io/person-relationship-code#FTWIN> <https://ns.socialcaredata.io/person-relationship-code#FTWINBRO> <https://ns.socialcaredata.io/person-relationship-code#FTWINSIS> <https://ns.socialcaredata.io/person-relationship-code#SPS> <https://ns.socialcaredata.io/person-relationship-code#HUSB> <https://ns.socialcaredata.io/person-relationship-code#WIFE> <https://ns.socialcaredata.io/person-relationship-code#FMRSPS> <https://ns.socialcaredata.io/person-relationship-code#DOMPART> <https://ns.socialcaredata.io/person-relationship-code#SIGOTHR> <https://ns.socialcaredata.io/person-relationship-code#FRND> <https://ns.socialcaredata.io/person-relationship-code#NBOR> <https://ns.socialcaredata.io/person-relationship-code#ROOM> <https://ns.socialcaredata.io/person-relationship-code#ONESELF> ) ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path sc:relationship ] ;
    sh:targetClass sc:PersonRelationship .

sc:PersonShape a sh:NodeShape ;
    rdfs:comment "A person who is the subject of care. Core identity, demographic and contact data required to deliver and coordinate care must be present." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Identifier ;
            sh:description "References to the primary professionals related to this person (e.g. care coordinators or a GP). Until the Professional standard is published, recorded using the Identifier structure (system + value)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path sc:primaryContactProfessional ],
        [ sh:class sc:Contact ;
            sh:description "Contact information (multi-valued, optional)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path sc:contact ],
        [ sh:class sc:Communication ;
            sh:description "Professional recording of a person's communication requirements and language proficiencies." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path sc:communication ],
        [ sh:datatype xsd:boolean ;
            sh:description "Subject-of-care Person must record isDeceased." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:isDeceased ],
        [ sh:class sc:Identifier ;
            sh:description "References to other Person records where a cross-system match has been identified. Uses the Identifier structure." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path sc:matchedPersonRef ],
        [ sh:description "Observed phenotypic sex, where recorded." ;
            sh:in ( <https://ns.socialcaredata.io/phenotypic-sex-code#Male> <https://ns.socialcaredata.io/phenotypic-sex-code#Female> <https://ns.socialcaredata.io/phenotypic-sex-code#Indeterminate> <https://ns.socialcaredata.io/phenotypic-sex-code#NotKnown> ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path sc:sexCode ],
        [ sh:description "Subject-of-care Person must have exactly one ethnicityCode (ONS 2021 census 20b)." ;
            sh:in ( <https://ns.socialcaredata.io/ethnicity-code#AsianBangladeshi> <https://ns.socialcaredata.io/ethnicity-code#AsianChinese> <https://ns.socialcaredata.io/ethnicity-code#AsianIndian> <https://ns.socialcaredata.io/ethnicity-code#AsianPakistani> <https://ns.socialcaredata.io/ethnicity-code#AsianOther> <https://ns.socialcaredata.io/ethnicity-code#BlackAfrican> <https://ns.socialcaredata.io/ethnicity-code#BlackCaribbean> <https://ns.socialcaredata.io/ethnicity-code#BlackOther> <https://ns.socialcaredata.io/ethnicity-code#MixedWhiteAsian> <https://ns.socialcaredata.io/ethnicity-code#MixedWhiteBlackAfrican> <https://ns.socialcaredata.io/ethnicity-code#MixedWhiteBlackCaribbean> <https://ns.socialcaredata.io/ethnicity-code#MixedOther> <https://ns.socialcaredata.io/ethnicity-code#WhiteBritish> <https://ns.socialcaredata.io/ethnicity-code#WhiteIrish> <https://ns.socialcaredata.io/ethnicity-code#WhiteGypsyOrIrishTraveller> <https://ns.socialcaredata.io/ethnicity-code#WhiteRoma> <https://ns.socialcaredata.io/ethnicity-code#WhiteOther> <https://ns.socialcaredata.io/ethnicity-code#OtherArab> <https://ns.socialcaredata.io/ethnicity-code#OtherAny> <https://ns.socialcaredata.io/ethnicity-code#DoesNotApply> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path sc:ethnicityCode ],
        [ sh:class sc:Address ;
            sh:description "Subject-of-care Person must have at least one Address." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:address ],
        [ sh:description "Subject-of-care Person must have exactly one genderCode." ;
            sh:in ( <https://ns.socialcaredata.io/gender-code#Male> <https://ns.socialcaredata.io/gender-code#Female> <https://ns.socialcaredata.io/gender-code#Indeterminate> <https://ns.socialcaredata.io/gender-code#NotKnown> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path sc:genderCode ],
        [ sh:class sc:Identifier ;
            sh:description "A reference pointing to the person's self-reported \"About Me\" profile (an in-use standard across health and care allowing individuals to record their wants and needs). Uses the Identifier structure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path sc:aboutMe ],
        [ sh:class sc:PersonRelationship ;
            sh:description "Related people (multi-valued, optional)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path sc:relatedPerson ],
        [ sh:class sc:Identifier ;
            sh:description "Subject-of-care Person must have at least one Identifier." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:class sc:PartialDate ;
            sh:description "Subject-of-care Person must have exactly one dateOfBirth." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:dateOfBirth ],
        [ sh:class sc:Name ;
            sh:description "Subject-of-care Person must have exactly one Name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:name ],
        [ sh:class sc:PartialDate ;
            sh:description "The person's date of death, with an optional accuracy indicator. isDeceased may be true without a known date." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sc:deceasedDate ] ;
    sh:targetClass sc:Person .

sc:PlacementAvailabilityShape a sh:NodeShape ;
    rdfs:comment "The referral request details: how urgently the child needs to be placed, how many siblings should be placed together, whether the preferred location is local, and (if out of area) why." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Whether the child is an unaccompanied asylum-seeking child (UASC)." ;
            sh:in ( <https://ns.socialcaredata.io/uasc-status#Yes> <https://ns.socialcaredata.io/uasc-status#No> <https://ns.socialcaredata.io/uasc-status#NotApplicable> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path sc:uascStatus ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "How many siblings the child should ideally be placed with according to the care plan. 0 if the child has no siblings or is not to be placed with siblings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:siblingCount ],
        [ sh:description "When the child needs to be placed by. Captures urgency rather than an absolute date." ;
            sh:in ( <https://ns.socialcaredata.io/placement-urgency#Today> <https://ns.socialcaredata.io/placement-urgency#WithinFiveDays> <https://ns.socialcaredata.io/placement-urgency#MoreThanFiveDays> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path sc:neededBy ] ;
    sh:targetClass sc:PlacementAvailability .

sc:PlacementRecommendationShape a sh:NodeShape ;
    rdfs:comment "The social worker's recommendation of which categories of placement (foster, residential, supported accommodation) are preferred, suitable but not preferred, unsuitable, or unspecified." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Suitability of supported accommodation for this child." ;
            sh:in ( <https://ns.socialcaredata.io/suitability-level#Preferred> <https://ns.socialcaredata.io/suitability-level#SuitableButNotPreferred> <https://ns.socialcaredata.io/suitability-level#Unsuitable> <https://ns.socialcaredata.io/suitability-level#NotSpecified> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path sc:supportedAccommodationSuitability ],
        [ sh:description "Suitability of residential care for this child." ;
            sh:in ( <https://ns.socialcaredata.io/suitability-level#Preferred> <https://ns.socialcaredata.io/suitability-level#SuitableButNotPreferred> <https://ns.socialcaredata.io/suitability-level#Unsuitable> <https://ns.socialcaredata.io/suitability-level#NotSpecified> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path sc:residentialCareSuitability ],
        [ sh:description "Suitability of foster care for this child, as judged by the social worker." ;
            sh:in ( <https://ns.socialcaredata.io/suitability-level#Preferred> <https://ns.socialcaredata.io/suitability-level#SuitableButNotPreferred> <https://ns.socialcaredata.io/suitability-level#Unsuitable> <https://ns.socialcaredata.io/suitability-level#NotSpecified> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path sc:fosterCareSuitability ] ;
    sh:targetClass sc:PlacementRecommendation .

sc:PlacementRequirementsShape a sh:NodeShape ;
    rdfs:comment "The child's needs that the placement must accommodate: communication, cultural, living companions, pets, additional support, deprivation of liberty and home adaptation." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the child has a Deprivation of Liberty Order (DOL)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path sc:deprivationOfLiberty ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether adaptations to the home are required to accommodate the child's needs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path sc:homeAdaptationRequired ],
        [ sh:description "Whether the child can or must live in a home with pets/animals." ;
            sh:in ( <https://ns.socialcaredata.io/pets-allowance#YesMust> <https://ns.socialcaredata.io/pets-allowance#YesCan> <https://ns.socialcaredata.io/pets-allowance#No> <https://ns.socialcaredata.io/pets-allowance#NotKnown> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path sc:pets ],
        [ sh:description "Whether the child has any communication, language or learning needs." ;
            sh:in ( <https://ns.socialcaredata.io/presence-status#Yes> <https://ns.socialcaredata.io/presence-status#No> <https://ns.socialcaredata.io/presence-status#NotSpecified> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path sc:communicationNeeds ],
        [ sh:description "Whether the placement must accommodate specific cultural needs (e.g., access to places of worship)." ;
            sh:in ( <https://ns.socialcaredata.io/cultural-need#Required> <https://ns.socialcaredata.io/cultural-need#NotRequired> <https://ns.socialcaredata.io/cultural-need#NotKnown> <https://ns.socialcaredata.io/cultural-need#Other> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path sc:culturalNeeds ],
        [ sh:description "Recommendation as to who the child can be cared for alongside (e.g., solo placement, with other children, only older children)." ;
            sh:in ( <https://ns.socialcaredata.io/living-arrangement#SoloPlacement> <https://ns.socialcaredata.io/living-arrangement#WithOtherChildren> <https://ns.socialcaredata.io/living-arrangement#OnlyWithOlderChildren> <https://ns.socialcaredata.io/living-arrangement#OnlyWithYoungerChildren> <https://ns.socialcaredata.io/living-arrangement#NoPreference> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path sc:livingCompanions ],
        [ sh:description "Specific communication or language requirement (ESOL, BSL, Makaton, Other, None). Multi-valued: a placement may have several." ;
            sh:in ( <https://ns.socialcaredata.io/communication-need#ESOL> <https://ns.socialcaredata.io/communication-need#BSL> <https://ns.socialcaredata.io/communication-need#Makaton> <https://ns.socialcaredata.io/communication-need#Other> <https://ns.socialcaredata.io/communication-need#None> ) ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path sc:specificCommunicationRequirement ],
        [ sh:description "Additional support provision required (e.g., additional supervision, therapeutic support, taxis to school)." ;
            sh:in ( <https://ns.socialcaredata.io/support-type#AdditionalSupervision> <https://ns.socialcaredata.io/support-type#TherapeuticSupport> <https://ns.socialcaredata.io/support-type#WorkerForRespite> <https://ns.socialcaredata.io/support-type#TaxisToSchool> <https://ns.socialcaredata.io/support-type#NotApplicable> <https://ns.socialcaredata.io/support-type#Other> ) ;
            sh:order 5 ;
            sh:path sc:additionalSupport ],
        [ sh:description "How the child's needs were assessed." ;
            sh:in ( <https://ns.socialcaredata.io/needs-assessment-method#BERRI> <https://ns.socialcaredata.io/needs-assessment-method#CANS> <https://ns.socialcaredata.io/needs-assessment-method#OtherFormalisedTool> <https://ns.socialcaredata.io/needs-assessment-method#OtherSocialWorkerAssessment> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path sc:needsAssessmentMethod ] ;
    sh:targetClass sc:PlacementRequirements .

sc:PlacementShape a sh:NodeShape ;
    rdfs:comment "The top-level placement record for a looked-after child, linking together the referral availability, the child's requirements, the social-worker recommendation, the risk assessment, the quality-assurance metadata and (optionally) the placement actually arranged." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifier unique to each child within the LA, allowing linking between multiple referrals for the same child." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:childId ],
        [ sh:datatype xsd:string ;
            sh:description "The unique identifier of the placement record within the LA case management system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:placementId ],
        [ sh:class sc:ActualPlacement ;
            sh:description "Links a Placement to the ActualPlacement that was arranged. Optional - a referral may exist without (yet) having an actual placement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path sc:actualPlacement ],
        [ sh:class sc:PlacementAvailability ;
            sh:description "Links a Placement to its PlacementAvailability (referral) record." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:placementAvailability ],
        [ sh:class sc:QualityAssurance ;
            sh:description "Links a Placement to its QualityAssurance metadata." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path sc:qualityAssurance ],
        [ sh:class sc:RiskAssessment ;
            sh:description "Links a Placement to its RiskAssessment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:riskAssessment ],
        [ sh:class sc:PlacementRecommendation ;
            sh:description "Links a Placement to its PlacementRecommendation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sc:placementRecommendation ],
        [ sh:class sc:PlacementRequirements ;
            sh:description "Links a Placement to its PlacementRequirements." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path sc:placementRequirements ] ;
    sh:targetClass sc:Placement .

sc:ProfessionalShape a sh:NodeShape ;
    rdfs:comment "An individual acting in a formal role within an organisation who has responsibilities relating to a person's safety, wellbeing, care or support - for example undertaking assessments, creating and monitoring plans, or sharing information in a multi-agency context." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Text describing the professional's occupational role." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:role ],
        [ sh:class sc:Contact ;
            sh:description "The professional's contact information (exactly one)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "contact" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sc:contact ],
        [ sh:datatype xsd:boolean ;
            sh:description "The professional's current working status." ;
            sh:maxCount 1 ;
            sh:name "status" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:workingStatus ],
        [ sh:class sc:Identifier ;
            sh:description "References (by Identifier) to Services associated with the entity." ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:relatedService ],
        [ sh:class sc:Identifier ;
            sh:description "References (by Identifier) to Organisations associated with the entity." ;
            sh:name "relatedOrganisation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path sc:relatedOrganisation ],
        [ sh:class sc:Name ;
            sh:description "The professional's name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:name ] ;
    sh:targetClass sc:Professional .

sc:QualityAssuranceShape a sh:NodeShape ;
    rdfs:comment "Metadata about who recorded each part of the placement record (referral, placement, cost) and when. Supports LA-internal review of data-entry practices; not intended to be shared beyond the recording LA." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Date of agreed placement start captured on the Case Management System." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:placementDateAdmin ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the officer who recorded the placement cost data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path sc:costOfficerName ],
        [ sh:datatype xsd:date ;
            sh:description "Date when placement cost data was captured on the Case Management System." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sc:costDate ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the officer who recorded the referral information. LA-internal QA only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path sc:referralOfficerName ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the officer who recorded the actual placement information." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:placementOfficerName ],
        [ sh:datatype xsd:date ;
            sh:description "Date of when referral was captured on the Case Management System." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:referralDate ] ;
    sh:targetClass sc:QualityAssurance .

sc:RelatedProfessionalShape a sh:NodeShape ;
    rdfs:comment "A typed reference to a Professional involved in a service episode or life event." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Identifier ;
            sh:description "A reference (by Identifier) to a Professional record involved in the episode or life event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:professional ],
        [ sh:datatype xsd:string ;
            sh:description "Code for the nature of the involvement. Uses an [HL7 v3 ParticipationType code](https://terminology.hl7.org/5.2.0/CodeSystem-v3-ParticipationType.html) directly (e.g. SBJ, PPRF); not defined by this standard, so modelled as an open string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:involvement ] ;
    sh:targetClass sc:RelatedProfessional .

sc:ReviewShape a sh:NodeShape ;
    rdfs:comment "Review information associated with an assessment or care plan." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether this is a review of a previous assessment / plan or not." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sc:isReview ],
        [ sh:class sc:Identifier ;
            sh:description "A link to the previous assessment / plan that is being reviewed." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path sc:previousId ] ;
    sh:targetClass sc:Review .

sc:RiskAssessmentShape a sh:NodeShape ;
    rdfs:comment "Assessment of risks the child is exposed to and risks the child poses to others or property. Each risk is recorded as 'no known risk' or 'risk present'." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Whether the child is known to be at risk of drug and alcohol use." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path sc:riskDrugAlcohol ],
        [ sh:description "Whether the child is known to be at risk of sexual exploitation." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path sc:riskSexualExploitation ],
        [ sh:description "Whether the child is known to be at risk of going missing." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path sc:riskMissing ],
        [ sh:description "Whether there is a known risk of harm to animals." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path sc:riskToOthersAnimals ],
        [ sh:description "Whether the child is known to be at risk of criminal exploitation." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path sc:riskCriminalExploitation ],
        [ sh:description "Whether there is a known risk of physical harm to others." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path sc:riskToOthersPhysical ],
        [ sh:description "Whether the child is known to be at risk of self-harm." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path sc:riskSelfHarm ],
        [ sh:description "Whether the child is known to be at risk of an eating disorder." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path sc:riskEatingDisorder ],
        [ sh:description "Whether there is a known risk of criminal exploitation for others in the home." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path sc:riskToOthersCriminal ],
        [ sh:description "Whether there is a known risk of sexual harm to others." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path sc:riskToOthersSexual ],
        [ sh:description "Whether there is a known risk of fire-setting." ;
            sh:in ( <https://ns.socialcaredata.io/risk-level#NoKnownRisk> <https://ns.socialcaredata.io/risk-level#RiskPresent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path sc:riskToOthersFire ] ;
    sh:targetClass sc:RiskAssessment .

sc:ServiceEpisodeShape a sh:NodeShape ;
    rdfs:comment "A bounded period during which an individual receives a defined service, intervention, or package of support from a service or professional. It has a recognisable start and end point, though duration may vary from a single contact to sustained involvement over time." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sc:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Details about the location of the episode." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path sc:location ],
        [ sh:description "Code(s) for the type of service episode." ;
            sh:in ( <https://ns.socialcaredata.io/episode-code#Assessment> <https://ns.socialcaredata.io/episode-code#EarlyHelp> <https://ns.socialcaredata.io/episode-code#Section47> <https://ns.socialcaredata.io/episode-code#AdultSafeguarding> <https://ns.socialcaredata.io/episode-code#CareActAssessment> <https://ns.socialcaredata.io/episode-code#OtherAssessment> <https://ns.socialcaredata.io/episode-code#Plan> <https://ns.socialcaredata.io/episode-code#Ehcp> <https://ns.socialcaredata.io/episode-code#FamilyCourtOrder> <https://ns.socialcaredata.io/episode-code#CinPlan> <https://ns.socialcaredata.io/episode-code#CpPlan> <https://ns.socialcaredata.io/episode-code#CamhsPlan> <https://ns.socialcaredata.io/episode-code#ChildLookedAfter> <https://ns.socialcaredata.io/episode-code#CarePlan> <https://ns.socialcaredata.io/episode-code#OtherPlan> <https://ns.socialcaredata.io/episode-code#Provision> <https://ns.socialcaredata.io/episode-code#FaceToFaceContact> <https://ns.socialcaredata.io/episode-code#RemoteContact> <https://ns.socialcaredata.io/episode-code#DirectProvision> <https://ns.socialcaredata.io/episode-code#IndirectProvision> <https://ns.socialcaredata.io/episode-code#Admin> <https://ns.socialcaredata.io/episode-code#Miscellaneous> ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 1 ;
            sh:path sc:episodeType ],
        [ sh:description "Outcome of the episode for the subject." ;
            sh:in ( <https://ns.socialcaredata.io/episode-outcome#Reablement> <https://ns.socialcaredata.io/episode-outcome#Assessment> <https://ns.socialcaredata.io/episode-outcome#Hospital> <https://ns.socialcaredata.io/episode-outcome#Continuation> <https://ns.socialcaredata.io/episode-outcome#Planning> <https://ns.socialcaredata.io/episode-outcome#NfaPlanned> <https://ns.socialcaredata.io/episode-outcome#NfaMoved> <https://ns.socialcaredata.io/episode-outcome#NfaNhsReferral> <https://ns.socialcaredata.io/episode-outcome#NfaDisregard> <https://ns.socialcaredata.io/episode-outcome#NfaLocalReferral> <https://ns.socialcaredata.io/episode-outcome#NfaDeclined> <https://ns.socialcaredata.io/episode-outcome#NfaInfo> <https://ns.socialcaredata.io/episode-outcome#NfaDeceased> <https://ns.socialcaredata.io/episode-outcome#NfaNoOfferOther> <https://ns.socialcaredata.io/episode-outcome#NfaEndedOther> <https://ns.socialcaredata.io/episode-outcome#NfaOther> ) ;
            sh:maxCount 1 ;
            sh:name "outcome" ;
            sh:order 8 ;
            sh:path sc:episodeOutcome ],
        [ sh:class sc:Finding ;
            sh:description "Observations or measurements made during the course of the episode." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path sc:finding ],
        [ sh:class sc:Timing ;
            sh:description "Details about the timing of the episode." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:timeInformation ],
        [ sh:class sc:SubjectPerson ;
            sh:description "References to the Person(s) the episode or life event concerns." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path sc:subjectPerson ],
        [ sh:class sc:Identifier ;
            sh:description "References to the Services involved in the episode." ;
            sh:minCount 1 ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path sc:relatedService ],
        [ sh:class sc:RelatedProfessional ;
            sh:description "References to the Professional(s) involved, qualified by involvement." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path sc:relatedProfessional ] ;
    sh:targetClass sc:ServiceEpisode .

sc:ServiceShape a sh:NodeShape ;
    rdfs:comment "A service involved in the safeguarding or wellbeing of a person - the specific intervention or package of support delivered by one or more organisations (e.g. local authority social care, an emergency department, a general practice, or a school)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Other names the entity is known by." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:alias ],
        [ sh:description "The way the service is delivered." ;
            sh:in ( <https://ns.socialcaredata.io/service-delivery#StMax> <https://ns.socialcaredata.io/service-delivery#OngoingLow> <https://ns.socialcaredata.io/service-delivery#OtherShortTerm> <https://ns.socialcaredata.io/service-delivery#Nursing> <https://ns.socialcaredata.io/service-delivery#Residential> <https://ns.socialcaredata.io/service-delivery#Community> <https://ns.socialcaredata.io/service-delivery#Prison> <https://ns.socialcaredata.io/service-delivery#UnpaidCarerDirect> <https://ns.socialcaredata.io/service-delivery#UnpaidCarerSupport> ) ;
            sh:order 8 ;
            sh:path sc:delivery ],
        [ sh:datatype xsd:boolean ;
            sh:description "Code for the entity's status - whether it is currently active." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path sc:active ],
        [ sh:description "Code(s) for the kind of service." ;
            sh:in ( <https://ns.socialcaredata.io/service-code#YouthOffending> <https://ns.socialcaredata.io/service-code#PrimarySchool> <https://ns.socialcaredata.io/service-code#HighSchool> <https://ns.socialcaredata.io/service-code#SenPrimarySchool> <https://ns.socialcaredata.io/service-code#SenHighSchool> <https://ns.socialcaredata.io/service-code#AlternativeProvisionSchool> <https://ns.socialcaredata.io/service-code#SocialCare> <https://ns.socialcaredata.io/service-code#FamilyCourt> <https://ns.socialcaredata.io/service-code#Camhs> <https://ns.socialcaredata.io/service-code#Reablement> <https://ns.socialcaredata.io/service-code#ShortTermNursingCare> <https://ns.socialcaredata.io/service-code#ShortTermResidentialCare> <https://ns.socialcaredata.io/service-code#LongTermNursingCare> <https://ns.socialcaredata.io/service-code#LongTermResidentialCare> <https://ns.socialcaredata.io/service-code#HomeSupportDomiciliary> <https://ns.socialcaredata.io/service-code#DaySupport> <https://ns.socialcaredata.io/service-code#Meals> <https://ns.socialcaredata.io/service-code#Transport> <https://ns.socialcaredata.io/service-code#Equipment> <https://ns.socialcaredata.io/service-code#DirectPayment> <https://ns.socialcaredata.io/service-code#SharedLives> <https://ns.socialcaredata.io/service-code#CommunitySupportedLiving> <https://ns.socialcaredata.io/service-code#ExtraCareHousing> <https://ns.socialcaredata.io/service-code#SocialWorkerSupport> <https://ns.socialcaredata.io/service-code#OtherProfessionalSupport> <https://ns.socialcaredata.io/service-code#LearningEducationEmployment> <https://ns.socialcaredata.io/service-code#EndOfLifeCare> <https://ns.socialcaredata.io/service-code#EmergencySupport> <https://ns.socialcaredata.io/service-code#OtherShortTermSupport> <https://ns.socialcaredata.io/service-code#OtherLongTermSupport> <https://ns.socialcaredata.io/service-code#CarerRespite> <https://ns.socialcaredata.io/service-code#CarerSittingService> <https://ns.socialcaredata.io/service-code#CarerUniversalServices> <https://ns.socialcaredata.io/service-code#OtherCarerSupport> ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 3 ;
            sh:path sc:serviceType ],
        [ sh:class sc:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:identifier ],
        [ sh:class sc:Address ;
            sh:description "Physical location(s) of the entity." ;
            sh:name "address" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path sc:address ],
        [ sh:description "The frequency at which the unit cost occurs." ;
            sh:in ( <https://ns.socialcaredata.io/service-cost-frequency#None> <https://ns.socialcaredata.io/service-cost-frequency#PerSession> <https://ns.socialcaredata.io/service-cost-frequency#Hourly> <https://ns.socialcaredata.io/service-cost-frequency#Daily> <https://ns.socialcaredata.io/service-cost-frequency#Weekly> <https://ns.socialcaredata.io/service-cost-frequency#Fortnightly> <https://ns.socialcaredata.io/service-cost-frequency#FourWeekly> <https://ns.socialcaredata.io/service-cost-frequency#Monthly> <https://ns.socialcaredata.io/service-cost-frequency#Quarterly> <https://ns.socialcaredata.io/service-cost-frequency#Annually> <https://ns.socialcaredata.io/service-cost-frequency#OneOff> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path sc:costFrequency ],
        [ sh:class sc:Contact ;
            sh:description "Contact information for the service." ;
            sh:minCount 1 ;
            sh:name "contact" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path sc:contact ],
        [ sh:class sc:Identifier ;
            sh:description "References (by Identifier) to Organisations associated with the entity." ;
            sh:name "relatedOrganisation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path sc:relatedOrganisation ],
        [ sh:datatype xsd:string ;
            sh:description "The official name of the organisation or service." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:entityName ],
        [ sh:class sc:Identifier ;
            sh:description "References (by Identifier) to Professionals associated with the entity." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path sc:relatedProfessional ] ;
    sh:targetClass sc:Service .

sc:SubjectPersonShape a sh:NodeShape ;
    rdfs:comment "A typed reference to a Person involved in a service episode or life event." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Code for the nature of the involvement. Uses an [HL7 v3 ParticipationType code](https://terminology.hl7.org/5.2.0/CodeSystem-v3-ParticipationType.html) directly (e.g. SBJ, PPRF); not defined by this standard, so modelled as an open string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:involvement ],
        [ sh:class sc:Identifier ;
            sh:description "A reference (by Identifier) to a Person record involved in the episode or life event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path sc:person ] ;
    sh:targetClass sc:SubjectPerson .

sc:TimingShape a sh:NodeShape ;
    rdfs:comment "The schedule and timing information of an activity, episode or event: when it started and ended and how frequently it recurs." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "How frequently the activity, episode or event recurs, expressed as a [FHIR Timing](https://build.fhir.org/datatypes.html#Timing) datatype. This model does not define or validate its structure; the value is an arbitrary JSON object conforming to FHIR Timing." ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path sc:frequency ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The end of the activity, episode or event (or the last date it was performed), as an ISO 8601 date-time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path sc:endDateTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The start of the activity, episode or event (or the first date it was scheduled to be performed), as an ISO 8601 date-time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path sc:startDateTime ] ;
    sh:targetClass sc:Timing .

linkml:AnyShape a sh:NodeShape ;
    rdfs:comment "An open value whose structure is defined and validated elsewhere, not by this model. Serialised as an arbitrary JSON object." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

