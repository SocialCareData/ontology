sg:subjectPerson a owl:ObjectProperty ;
    rdfs:label "subjectPerson" ;
    rdfs:range sg:SubjectPerson ;
    skos:definition "References to the Person(s) the episode or life event concerns." ;
    skos:inScheme sg:safeguarding .

sg:measurement-unit a owl:Class ;
    rdfs:label "MeasurementUnit" ;
    dct:title "Measurement Unit" ;
    owl:unionOf ( mu:Count mu:Pct ) ;
    skos:definition "Codes to indicate the unit of measurement." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values mu:Count,
        mu:Pct .

ot:Risk a owl:Class ;
    rdfs:label "pets",
        "risk" ;
    dct:title "Pets or Dangerous Pets",
        "Risk" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Observed risk associated with the individual",
        "The individual lives with pets that may pose danger to others." .

sg:organisation-code a owl:Class ;
    rdfs:label "OrganisationCode" ;
    dct:title "Organisation Code" ;
    owl:unionOf ( oc:LocalAuthority oc:NhsTrust oc:PoliceForce ) ;
    skos:definition "Codes to indicate the type of organisation." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values oc:LocalAuthority,
        oc:NhsTrust,
        oc:PoliceForce .

sg:measurement-type a owl:Class ;
    rdfs:label "MeasurementType" ;
    dct:title "Measurement Type" ;
    owl:unionOf ( mt:Attendance mt:AuthorisedAbsences mt:UnauthorisedAbsences mt:CaringHoursPerWeek ) ;
    skos:definition "Codes to indicate the type of measurement." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values mt:Attendance,
        mt:AuthorisedAbsences,
        mt:CaringHoursPerWeek,
        mt:UnauthorisedAbsences .

sg:sgIdentifier a owl:ObjectProperty ;
    rdfs:label "sgIdentifier" ;
    dct:title "identifier" ;
    rdfs:range sg:Identifier ;
    skos:definition "Unique identifiers associated with the entity." ;
    skos:inScheme sg:safeguarding .

sg:event-code a owl:Class ;
    rdfs:label "EventCode" ;
    dct:title "Event Code" ;
    owl:unionOf ( evc:Birth evc:Death evc:AeAttendance evc:SchoolExclusion evc:SchoolSuspension evc:MissingPerson evc:SafeguardingConcern evc:Referral evc:Homeless ) ;
    skos:definition "Codes to indicate the type of life event." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values evc:AeAttendance,
        evc:Birth,
        evc:Death,
        evc:Homeless,
        evc:MissingPerson,
        evc:Referral,
        evc:SafeguardingConcern,
        evc:SchoolExclusion,
        evc:SchoolSuspension .

sg:service-delivery a owl:Class ;
    rdfs:label "ServiceDelivery" ;
    dct:title "Service Delivery" ;
    owl:unionOf ( sd:StMax sd:OngoingLow sd:OtherShortTerm sd:Nursing sd:Residential sd:Community sd:Prison sd:UnpaidCarerDirect sd:UnpaidCarerSupport ) ;
    skos:definition "Codes to indicate the way a service is delivered. From the Adult Social Care Client Level Data specification." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values sd:Community,
        sd:Nursing,
        sd:OngoingLow,
        sd:OtherShortTerm,
        sd:Prison,
        sd:Residential,
        sd:StMax,
        sd:UnpaidCarerDirect,
        sd:UnpaidCarerSupport .

sg:service-cost-frequency a owl:Class ;
    rdfs:label "ServiceCostFrequency" ;
    dct:title "Service Cost Frequency" ;
    owl:unionOf ( scf:None scf:PerSession scf:Hourly scf:Daily scf:Weekly scf:Fortnightly scf:FourWeekly scf:Monthly scf:Quarterly scf:Annually scf:OneOff ) ;
    skos:definition "Codes to indicate the payment schedule a service adheres to. From the Adult Social Care Client Level Data specification." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values scf:Annually,
        scf:Daily,
        scf:Fortnightly,
        scf:FourWeekly,
        scf:Hourly,
        scf:Monthly,
        scf:None,
        scf:OneOff,
        scf:PerSession,
        scf:Quarterly,
        scf:Weekly .

sg:episode-code a owl:Class ;
    rdfs:label "EpisodeCode" ;
    dct:title "Episode Code" ;
    owl:unionOf ( epc:EarlyHelp epc:Ehcp epc:FamilyCourtOrder epc:CinPlan epc:CpPlan epc:CamhsPlan epc:Section47 epc:CareLeaver epc:ChildLookedAfter epc:AdultSafeguarding epc:CareActAssessment epc:CarePlan ) ;
    skos:definition "Codes to indicate the type of service episode." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values epc:AdultSafeguarding,
        epc:CamhsPlan,
        epc:CareActAssessment,
        epc:CareLeaver,
        epc:CarePlan,
        epc:ChildLookedAfter,
        epc:CinPlan,
        epc:CpPlan,
        epc:EarlyHelp,
        epc:Ehcp,
        epc:FamilyCourtOrder,
        epc:Section47 .

sg:episode-outcome a owl:Class ;
    rdfs:label "EpisodeOutcome" ;
    dct:title "Episode Outcome" ;
    owl:unionOf ( eo:Reablement eo:Assessment eo:Hospital eo:Continuation eo:Planning eo:NfaPlanned eo:NfaMoved eo:NfaNhsReferral eo:NfaDisregard eo:NfaLocalReferral eo:NfaDeclined eo:NfaInfo eo:NfaDeceased eo:NfaNoOfferOther eo:NfaEndedOther eo:NfaOther ) ;
    skos:definition "Codes to indicate the outcome of the episode for the subject. From the Adult Social Care Client Level Data specification." ;
    skos:inScheme sg:safeguarding ;
    linkml:permissible_values eo:Assessment,
        eo:Continuation,
        eo:Hospital,
        eo:NfaDeceased,
        eo:NfaDeclined,
        eo:NfaDisregard,
        eo:NfaEndedOther,
        eo:NfaInfo,
        eo:NfaLocalReferral,
        eo:NfaMoved,
        eo:NfaNhsReferral,
        eo:NfaNoOfferOther,
        eo:NfaOther,
        eo:NfaPlanned,
        eo:Planning,
        eo:Reablement .

