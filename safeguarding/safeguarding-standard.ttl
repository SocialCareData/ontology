    rdfs:label "SEND.SEMH" ;
    dct:title "SEND SEMH" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Social, Emotional and Mental Health difficulties: These may include becoming withdrawn or isolated, as well as displaying challenging, disruptive or disturbing behaviour. These behaviours may reflect underlying mental health difficulties such as anxiety or depression, self-harming, substance misuse, eating disorders or physical symptoms that are medically unexplained." .

ot:SendSlcn a owl:Class ;
    rdfs:label "SEND.SLCN" ;
    dct:title "SEND SLCN" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Speech, Language and Communication Needs: difficulty in communicating with others such as difficulty saying what they want to, understanding what is being said to them, difficulties understanding and applying social rules." .

ot:SendSld a owl:Class ;
    rdfs:label "SEND.SLD" ;
    dct:title "SEND SLD" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Severe Learning Difficulty: significant intellectual or cognitive impairments and are likely to need support in all areas of the curriculum." .

ot:SendSpld a owl:Class ;
    rdfs:label "SEND.SpLD" ;
    dct:title "SEND SpLD" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Specific learning Difficulty: difficulty that affect one or more specific aspects of learning. This encompasses a range of conditions including dyslexia, dyscalculia, dysgraphia, dyspraxia etc." .

ot:SendVi a owl:Class ;
    rdfs:label "SEND.VI" ;
    dct:title "SEND VI" ;
    rdfs:subClassOf sg:observation-type ;
    skos:definition "Visual Impairment: Partial or complete loss of sight not correctable by usual means (e.g. prescribed glasses or contact lens)." .

