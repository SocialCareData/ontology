sg:safeguarding a owl:Ontology ;
    rdfs:label "safeguarding" ;
    dct:license "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" ;
    dct:title "Safeguarding Standard Data Model" ;
    pav:version "1.0.0" ;
    owl:imports sg:common ;
    skos:definition """A LinkML data model for the Safeguarding Standard: a common data model for recording the services, professionals, organisations, service episodes and life events involved in safeguarding and promoting the wellbeing of a person, to support multi-agency information sharing (MAIS).
The model is organised around five top-level entities - Organisation, Service, Professional, ServiceEpisode and LifeEvent - and the shared objects that link them together (Identifier, Name, Address, Contact). The shared objects are defined once by the common module and imported from common.yaml, so this schema reuses their ontology IRIs (Identifier, Name, Address, Contact) rather than redefining them. Coded fields draw their values from the controlled vocabularies (enums) declared below.""" .

sg:observation-type a owl:Class ;
    rdfs:label "ObservationType" ;
