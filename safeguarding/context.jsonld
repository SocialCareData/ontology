          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/episode-code#",
            "early-help": "epc:EarlyHelp",
            "ehcp": "epc:Ehcp",
            "family-court-order": "epc:FamilyCourtOrder",
            "cin-plan": "epc:CinPlan",
            "cp-plan": "epc:CpPlan",
            "CAMHS-plan": "epc:CamhsPlan",
            "section-47": "epc:Section47",
            "care-leaver": "epc:CareLeaver",
            "child-looked-after": "epc:ChildLookedAfter",
            "adult-safeguarding": "epc:AdultSafeguarding"
          }
        }
      }
    },
    "LifeEvent": {
      "@id": "sg:LifeEvent",
      "@context": {
        "type": {
          "@id": "sg:eventType",
          "@type": "@vocab",
          "@container": "@set",
          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/event-code#",
            "birth": "evc:Birth",
            "death": "evc:Death",
            "ae-attendance": "evc:AeAttendance",
            "school-exclusion": "evc:SchoolExclusion",
            "school-suspension": "evc:SchoolSuspension",
            "missing-person": "evc:MissingPerson",
            "safeguarding-concern": "evc:SafeguardingConcern",
            "referral": "evc:Referral",
            "homeless": "evc:Homeless"
          }
        }
      }
    },
    "SubjectPerson": "sg:SubjectPerson",
    "RelatedProfessional": "sg:RelatedProfessional",
    "TimeInformation": {
      "@id": "sg:TimeInformation",
      "@context": {
        "frequency": {
          "@id": "sg:serviceFrequency",
          "@type": "@id"
        }
      }
    },
    "Timing": "sg:Timing",
    "Repeat": {
      "@id": "sg:Repeat",
      "@context": {
        "dayOfWeek": {
          "@id": "sg:dayOfWeek",
          "@container": "@set"
        },
        "frequency": {
          "@id": "sg:frequencyCount",
          "@type": "xsd:integer"
        },
        "period": {
          "@id": "sg:period",
          "@type": "xsd:integer"
        },
        "periodUnit": "sg:periodUnit",
        "timeOfDay": {
          "@id": "sg:timeOfDay",
          "@container": "@set"
        },
        "when": {
          "@id": "sg:when",
          "@container": "@set"
        }
      }
    },
    "repeat": {
      "@id": "sg:repeat",
      "@type": "@id"
    },
    "Finding": "sg:Finding",
    "Observation": {
      "@id": "sg:Observation",
      "@context": {
        "type": "sg:observationType",
        "startDate": {
          "@id": "sg:startDate",
          "@type": "xsd:dateTime"
        },
        "endDate": {
          "@id": "sg:endDate",
          "@type": "xsd:dateTime"
        }
      }
    },
    "Measurement": {
      "@id": "sg:Measurement",
      "@context": {
        "value": {
          "@id": "sg:measurementValue",
          "@type": "xsd:decimal"
        },
        "unit": {
          "@id": "sg:unit",
          "@type": "@vocab",
          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/measurement-unit#",
            "count": "mu:Count",
            "pct": "mu:Pct"
          }
        },
        "type": {
          "@id": "sg:measurementType",
          "@type": "@vocab",
          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/measurement-type#",
            "Attendance": "mt:Attendance",
            "Authorised Absences": "mt:AuthorisedAbsences",
            "Unauthorised Absences": "mt:UnauthorisedAbsences",
            "caring-hours-per-week": "mt:CaringHoursPerWeek"
          }
        }
      }
    },
    "Identifier": "p:Identifier",
    "Name": {
      "@id": "p:Name",
      "@context": {
        "use": {
          "@id": "p:use",
          "@type": "@vocab",
          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/name-use-code#",
            "usual": "nuc:Usual",
            "official": "nuc:Official",
            "temp": "nuc:Temp",
            "nickname": "nuc:Nickname",
            "anonymous": "nuc:Anonymous",
            "old": "nuc:Old",
            "maiden": "nuc:Maiden"
          }
        }
