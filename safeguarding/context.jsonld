      "@id": "p:system",
      "@type": "@id"
    },
    "familyName": {
      "@id": "p:familyName",
      "@container": "@set"
    },
    "givenName": {
      "@id": "p:givenName",
      "@container": "@set"
    },
    "preferredName": "p:preferredName",
