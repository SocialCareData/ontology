            "short-term-nursing-care": "svc:ShortTermNursingCare",
            "short-term-residential-care": "svc:ShortTermResidentialCare",
            "long-term-nursing-care": "svc:LongTermNursingCare",
            "long-term-residential-care": "svc:LongTermResidentialCare",
            "home-support-domiciliary": "svc:HomeSupportDomiciliary",
            "day-support": "svc:DaySupport",
            "meals": "svc:Meals",
            "transport": "svc:Transport",
            "equipment": "svc:Equipment",
            "direct-payment": "svc:DirectPayment",
            "shared-lives": "svc:SharedLives",
            "community-supported-living": "svc:CommunitySupportedLiving",
            "extra-care-housing": "svc:ExtraCareHousing",
            "social-worker-support": "svc:SocialWorkerSupport",
            "other-professional-support": "svc:OtherProfessionalSupport",
            "learning-education-employment": "svc:LearningEducationEmployment",
            "end-of-life-care": "svc:EndOfLifeCare",
            "emergency-support": "svc:EmergencySupport",
            "other-short-term-support": "svc:OtherShortTermSupport",
            "other-long-term-support": "svc:OtherLongTermSupport",
            "carer-respite": "svc:CarerRespite",
            "carer-sitting-service": "svc:CarerSittingService",
            "carer-universal-services": "svc:CarerUniversalServices",
            "other-carer-support": "svc:OtherCarerSupport"
          }
        }
