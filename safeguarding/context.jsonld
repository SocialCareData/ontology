    "Organisation": {
      "@id": "sg:Organisation",
      "@context": {
        "name": "sg:name",
        "type": {
          "@id": "sg:organisationType",
          "@type": "@vocab",
          "@container": "@set",
          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/organisation-code#",
            "local-authority": "oc:LocalAuthority",
            "nhs-trust": "oc:NhsTrust",
            "police-force": "oc:PoliceForce"
          }
        }
      }
    },
    "Service": {
      "@id": "sg:Service",
      "@context": {
        "name": "sg:name",
        "type": {
          "@id": "sg:serviceType",
          "@type": "@vocab",
          "@container": "@set",
          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/service-code#",
            "youth-offending": "svc:YouthOffending",
            "primary-school": "svc:PrimarySchool",
            "high-school": "svc:HighSchool",
            "SEN-primary-school": "svc:SenPrimarySchool",
            "SEN-high-school": "svc:SenHighSchool",
            "alternative-provision-school": "svc:AlternativeProvisionSchool",
