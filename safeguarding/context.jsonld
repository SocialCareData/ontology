        "prison": "sd:Prison",
        "unpaid-carer-direct": "sd:UnpaidCarerDirect",
        "unpaid-carer-support": "sd:UnpaidCarerSupport"
      }
    },
    "costFrequency": {
      "@id": "sg:costFrequency",
      "@type": "@vocab",
      "@context": {
        "@vocab": "https://ontology.socialcaredata.io/service-cost-frequency#",
        "none": "scf:None",
        "per-session": "scf:PerSession",
        "hourly": "scf:Hourly",
        "daily": "scf:Daily",
        "weekly": "scf:Weekly",
        "fortnightly": "scf:Fortnightly",
        "four-weekly": "scf:FourWeekly",
        "monthly": "scf:Monthly",
        "quarterly": "scf:Quarterly",
        "annually": "scf:Annually",
        "one-off": "scf:OneOff"
      }
    },
    "relatedProfessional": {
      "@id": "sg:relatedProfessional",
      "@type": "@id",
      "@container": "@set"
    },
    "relatedService": {
      "@id": "sg:relatedService",
      "@type": "@id",
      "@container": "@set"
    },
    "relatedOrganisation": {
      "@id": "sg:relatedOrganisation",
