      "@id": "sg:location",
      "@container": "@set"
    },
    "finding": {
      "@id": "sg:finding",
      "@type": "@id",
      "@container": "@set"
    },
    "outcome": {
      "@id": "sg:outcome",
      "@type": "@vocab",
      "@context": {
        "@vocab": "https://ontology.socialcaredata.io/episode-outcome#",
        "reablement": "eo:Reablement",
        "assessment": "eo:Assessment",
        "hospital": "eo:Hospital",
        "continuation": "eo:Continuation",
        "planning": "eo:Planning",
        "NFA-planned": "eo:NfaPlanned",
        "NFA-moved": "eo:NfaMoved",
        "NFA-NHS-referral": "eo:NfaNhsReferral",
        "NFA-disregard": "eo:NfaDisregard",
