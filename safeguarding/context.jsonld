    "ex": "https://example.org/safeguarding/",
    "identifier": {
      "@id": "sg:identifier",
      "@type": "@id",
      "@container": "@set"
    },
    "alias": {
      "@id": "sg:alias",
      "@container": "@set"
    },
    "active": {
      "@id": "sg:active",
      "@type": "xsd:boolean"
    },
    "status": {
      "@id": "sg:status",
      "@type": "xsd:boolean"
    },
    "address": {
      "@id": "sg:address",
      "@type": "@id",
      "@container": "@set"
    },
    "role": {
      "@id": "sg:role",
      "@container": "@set"
    },
    "delivery": {
      "@id": "sg:delivery",
      "@type": "@vocab",
      "@container": "@set",
      "@context": {
        "@vocab": "https://ontology.socialcaredata.io/service-delivery#",
        "st-max": "sd:StMax",
        "ongoing-low": "sd:OngoingLow",
        "other-short-term": "sd:OtherShortTerm",
        "nursing": "sd:Nursing",
        "residential": "sd:Residential",
