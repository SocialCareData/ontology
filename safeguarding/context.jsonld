          "@context": {
            "@vocab": "https://ontology.socialcaredata.io/address-use-code#",
            "home": "auc:Home",
            "work": "auc:Work",
            "temp": "auc:Temp",
            "old": "auc:Old",
            "billing": "auc:Billing"
          }
        }
      }
    },
    "Contact": {
      "@id": "p:Contact",
      "@context": {
        "name": "p:contactName"
      }
    }
