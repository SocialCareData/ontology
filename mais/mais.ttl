    dcterms:title "Friend" ;
    rdfs:subClassOf sc:care-actor-type ;
    skos:definition "A friend providing informal care." .

<https://ontology.socialcaredata.io/care-actor-type#OtherUnpaidCarer> a owl:Class ;
    rdfs:label "Other unpaid carer" ;
    dcterms:title "Other Unpaid Carer" ;
    rdfs:subClassOf sc:care-actor-type ;
    skos:definition "Any other informal, unpaid caregiver." .

<https://ontology.socialcaredata.io/care-actor-type#ProfessionalServices> a owl:Class ;
    rdfs:label "Professional services" ;
    dcterms:title "Professional Services" ;
    rdfs:subClassOf sc:care-actor-type ;
    skos:definition "A formal, paid professional or commissioned service provider." .

<https://ontology.socialcaredata.io/care-actor-type#Self> a owl:Class ;
    rdfs:label "Self" ;
    dcterms:title "Self" ;
    rdfs:subClassOf sc:care-actor-type ;
    skos:definition "The subject person themselves performing the activity." .

<https://ontology.socialcaredata.io/care-document-status#active> a owl:Class ;
    rdfs:label "active" ;
    dcterms:title "Active" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "The plan is complete, approved, and currently being acted upon." .

<https://ontology.socialcaredata.io/care-document-status#completed> a owl:Class ;
    rdfs:label "completed" ;
    dcterms:title "Completed" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "The plan has been successfully executed and all actions are complete." .

<https://ontology.socialcaredata.io/care-document-status#draft> a owl:Class ;
    rdfs:label "draft" ;
    dcterms:title "Draft" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "The plan is in development and not yet ready to be acted upon." .

<https://ontology.socialcaredata.io/care-document-status#ended> a owl:Class ;
    rdfs:label "ended" ;
    dcterms:title "Ended" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "The plan was active but has now been completed or cancelled prior to normal end." .

<https://ontology.socialcaredata.io/care-document-status#entered-in-error> a owl:Class ;
    rdfs:label "entered-in-error" ;
    dcterms:title "Entered in Error" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "The plan was created incorrectly and should be disregarded." .

<https://ontology.socialcaredata.io/care-document-status#on-hold> a owl:Class ;
    rdfs:label "on-hold" ;
    dcterms:title "On-Hold" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "Actions on the plan are temporarily suspended." .

<https://ontology.socialcaredata.io/care-document-status#revoked> a owl:Class ;
    rdfs:label "revoked" ;
    dcterms:title "Revoked" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "The plan has been explicitly withdrawn and is no longer valid." .

<https://ontology.socialcaredata.io/care-document-status#unknown> a owl:Class ;
    rdfs:label "unknown" ;
    dcterms:title "Unknown" ;
    rdfs:subClassOf sc:care-document-status ;
    skos:definition "The status of the plan cannot be determined." .

<https://ontology.socialcaredata.io/care-outcome-type#CAClothing> a owl:Class ;
    rdfs:label "CA-CLOTHING" ;
    dcterms:title "Being appropriately clothed" ;
    rdfs:subClassOf sc:care-act-outcome .

<https://ontology.socialcaredata.io/care-outcome-type#CACommunityServices> a owl:Class ;
    rdfs:label "CA-COMMUNITY" ;
    dcterms:title "Making use of necessary facilities or services in the local community" ;
    rdfs:subClassOf sc:care-act-outcome .

<https://ontology.socialcaredata.io/care-outcome-type#CAHabitableHome> a owl:Class ;
    rdfs:label "CA-HABITABLEHOME" ;
    dcterms:title "Maintaining a habitable home environment" ;
    rdfs:subClassOf sc:care-act-outcome .

<https://ontology.socialcaredata.io/care-outcome-type#CAHomeSafety> a owl:Class ;
    rdfs:label "CA-HOMESAFETY" ;
    dcterms:title "Being able to make use of the home safely" ;
    rdfs:subClassOf sc:care-act-outcome .

<https://ontology.socialcaredata.io/care-outcome-type#CAHygiene> a owl:Class ;
    rdfs:label "CA-HYGIENE" ;
    dcterms:title "Maintaining personal hygiene" ;
    rdfs:subClassOf sc:care-act-outcome .

<https://ontology.socialcaredata.io/care-outcome-type#CAMaintainingRelationships> a owl:Class ;
    rdfs:label "CA-RELATIONSHIPS" ;
    dcterms:title "Developing and maintaining family or other personal relationships" ;
    rdfs:subClassOf sc:care-act-outcome .

<https://ontology.socialcaredata.io/care-outcome-type#CANutrition> a owl:Class ;
    rdfs:label "CA-NUTRITION" ;
    dcterms:title "Managing and maintaining nutrition" ;
    rdfs:subClassOf sc:care-act-outcome .

<https://ontology.socialcaredata.io/care-outcome-type#CAResponsibilityForOthers> a owl:Class ;
    rdfs:label "CA-CARINGOTHERS" ;
    dcterms:title "Carrying out any caring responsibilities for others" ;
