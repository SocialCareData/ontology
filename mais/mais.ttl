sc:totalWeeklyCost a owl:DatatypeProperty ;
    rdfs:label "totalWeeklyCost" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 100 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 100000 ] ) ] ) ] ;
    skos:definition "Total weekly fee paid for the placement, excluding VAT. Expected to be between £100 and £100,000." ;
    skos:inScheme sc:placements .

<https://ontology.socialcaredata.io/uasc-status#No> a owl:Class ;
    rdfs:label "False" ;
    dcterms:title "No" ;
    rdfs:subClassOf sc:uasc-status ;
    skos:definition "The child is not an unaccompanied asylum-seeking child." .

<https://ontology.socialcaredata.io/uasc-status#NotApplicable> a owl:Class ;
    rdfs:label "Not Applicable" ;
    dcterms:title "Not Applicable" ;
    rdfs:subClassOf sc:uasc-status ;
    skos:definition "UASC status is not applicable." .

<https://ontology.socialcaredata.io/uasc-status#Yes> a owl:Class ;
    rdfs:label "True" ;
    dcterms:title "True" ;
    rdfs:subClassOf sc:uasc-status ;
    skos:definition "The child is an unaccompanied asylum-seeking child." .

sc:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:USRN ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:UPRN ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:postcode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:addressUse ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$" ] ) ] ) ] ;
            owl:onProperty sc:postcode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:line2 ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:city ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:line1 ] ;
    skos:definition "A postal address. Aligned with FHIR Address. UPRN and USRN support property- and street-level disambiguation." ;
    skos:exactMatch sc:Address ;
    skos:inScheme sc:common .

sc:FoundationalInformation a owl:Class ;
    rdfs:label "FoundationalInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:consentToInformationSharing ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:professionalId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:review ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:apIdentifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:dateCompleted ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:personId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:capacityToCompleteAssessment ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:advocateRequired ] ;
    skos:definition "Information that is relevant across both assessments and plans." ;
    skos:exactMatch sc:FoundationalInformation ;
    skos:inScheme sc:assessments-and-plans .

sc:Name a owl:Class ;
    rdfs:label "Name" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:nameUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:preferredName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:givenName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:familyName ] ;
    skos:definition "Container for a person's name parts, aligned with FHIR HumanName. A person may have multiple names with different uses." ;
    skos:exactMatch sc:Name ;
    skos:inScheme sc:common .

sc:PartialDate a owl:Class ;
    rdfs:label "PartialDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
            owl:onProperty sc:accuracyIndicator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:accuracyIndicator ] ;
    skos:definition "Container for a date that may not be fully known or precise, extended with an accuracy indicator. Used for dates of birth and dates of death." ;
    skos:exactMatch sc:PartialDate ;
    skos:inScheme sc:person .

sc:care-act-eligibility-status a owl:Class ;
    rdfs:label "CareActEligibilityStatus" ;
    dcterms:title "Care Act Eligibility Status" ;
    owl:unionOf ( <https://ontology.socialcaredata.io/eligibility-status#eligible-needs-identified> <https://ontology.socialcaredata.io/eligibility-status#non-eligible-needs-identified> <https://ontology.socialcaredata.io/eligibility-status#no-needs-identified> ) ;
    skos:definition "Vocabulary for Care Act 2014 eligibility assessment under CA-ELIGIBILITY-01." ;
