<https://ontology.socialcaredata.io/communication-need#Other> a owl:Class ;
    rdfs:label "Other" ;
    dcterms:title "Other" ;
    rdfs:subClassOf sc:communication-need ;
    skos:definition "Another communication or language requirement not listed." .

sc:contactMulti a owl:ObjectProperty ;
    rdfs:label "contactMulti" ;
    dcterms:title "contact" ;
    rdfs:range sc:Contact ;
    skos:definition "Contact information (multi-valued)." ;
    skos:inScheme sc:safeguarding .

sc:coreWeeklyCost a owl:DatatypeProperty ;
    rdfs:label "coreWeeklyCost" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Total weekly core cost: the basic price quoted by a provider to deliver the service outlined in their Statement of Purpose, excluding child-specific additional costs." ;
    skos:inScheme sc:placements .

<https://ontology.socialcaredata.io/cultural-need#NotKnown> a owl:Class ;
    rdfs:label "Not Known" ;
    dcterms:title "Not known" ;
    rdfs:subClassOf sc:cultural-need ;
    skos:definition "Whether cultural accommodations are required is not known." .

<https://ontology.socialcaredata.io/cultural-need#NotRequired> a owl:Class ;
    rdfs:label "Not Required" ;
    dcterms:title "Not required" ;
    rdfs:subClassOf sc:cultural-need ;
    skos:definition "No specific cultural accommodations are required." .

<https://ontology.socialcaredata.io/cultural-need#Other> a owl:Class ;
    rdfs:label "Other" ;
    dcterms:title "Other" ;
    rdfs:subClassOf sc:cultural-need ;
    skos:definition "Other cultural needs apply." .

<https://ontology.socialcaredata.io/cultural-need#Required> a owl:Class ;
    rdfs:label "Required" ;
    dcterms:title "Required" ;
    rdfs:subClassOf sc:cultural-need ;
    skos:definition "Specific cultural accommodations are required." .

sc:educationWeeklyCost a owl:DatatypeProperty ;
    rdfs:label "educationWeeklyCost" ;
    rdfs:range [ a rdfs:Datatype ;
