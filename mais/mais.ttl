@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://ontology.socialcaredata.io/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sc:additionalSupport a owl:ObjectProperty ;
    rdfs:label "additionalSupport" ;
    rdfs:range sc:support-type ;
    skos:definition "Additional support provision required (e.g., additional supervision, therapeutic support, taxis to school)." ;
    skos:inScheme sc:placements .

sc:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:range xsd:string ;
    skos:definition "Other names the entity is known by." ;
    skos:inScheme sc:safeguarding .

sc:communication a owl:ObjectProperty ;
    rdfs:label "communication" ;
    rdfs:range sc:Communication ;
    skos:definition "Professional recording of a person's communication requirements and language proficiencies." ;
    skos:inScheme sc:person .

sc:contact a owl:ObjectProperty ;
    rdfs:label "contact" ;
    rdfs:range sc:Contact ;
    skos:definition "The person's contact information." ;
    skos:inScheme sc:person .

sc:delivery a owl:ObjectProperty ;
    rdfs:label "delivery" ;
    rdfs:range sc:service-delivery ;
    skos:definition "The way the service is delivered." ;
    skos:inScheme sc:safeguarding .

sc:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:range xsd:string ;
    skos:definition "One or more email addresses." ;
    skos:inScheme sc:common .

sc:finding a owl:ObjectProperty ;
    rdfs:label "finding" ;
    rdfs:range sc:Finding ;
    skos:definition "Observations or measurements made during the course of the episode." ;
    skos:inScheme sc:safeguarding .

sc:language a owl:ObjectProperty ;
    rdfs:label "language" ;
    rdfs:range sc:Language ;
    skos:definition "Specific language(s) spoken or understood by the person, optionally annotated with proficiency." ;
    skos:inScheme sc:person .

sc:mais a owl:Ontology ;
    rdfs:label "social-care-mais" ;
    dcterms:license "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" ;
    dcterms:title "Social Care MAIS Ontology" ;
    pav:version "2026.1.0" ;
    skos:definition """The umbrella Social Care MAIS (Multi-Agency Information Sharing) ontology. It has no classes or slots of its own; it composes the independently-versioned modules - common, person, placements, safeguarding, and assessments-and-plans - into a single ontology under one flat namespace (https://ontology.socialcaredata.io/).
Each module is authored and versioned on its own cadence; a MAIS release pins a compatible set of module versions (see manifest.yml) and is generated from this file. Generate the merged ontology with `gen-owl --mergeimports mais.yaml` resolved through the top-level imports.json.""" .

sc:matchedPersonRef a owl:ObjectProperty ;
    rdfs:label "matchedPersonRef" ;
    rdfs:range sc:Identifier ;
    skos:definition "References to other Person records where a cross-system match has been identified. Uses the Identifier structure." ;
    skos:inScheme sc:person .

sc:measurement a owl:ObjectProperty ;
    rdfs:label "measurement" ;
    rdfs:range sc:Measurement ;
    skos:definition "Quantitative measurement(s) about the subject or their circumstances." ;
    skos:inScheme sc:safeguarding .

sc:observation a owl:ObjectProperty ;
    rdfs:label "observation" ;
    rdfs:range sc:Observation ;
    skos:definition "Qualitative observation(s) about the subject or their circumstances." ;
    skos:inScheme sc:safeguarding .

sc:previousId a owl:ObjectProperty ;
    rdfs:label "previousId" ;
    rdfs:range sc:Identifier ;
    skos:definition "A link to the previous assessment / plan that is being reviewed." ;
    skos:inScheme sc:assessments-and-plans .

sc:primaryContactProfessional a owl:ObjectProperty ;
    rdfs:label "primaryContactProfessional" ;
    rdfs:range sc:Identifier ;
    skos:definition "References to the primary professionals related to this person (e.g. care coordinators or a GP). Until the Professional standard is published, recorded using the Identifier structure (system + value)." ;
    skos:inScheme sc:person .

sc:relatedOrganisationRef a owl:ObjectProperty ;
    rdfs:label "relatedOrganisationRef" ;
    dcterms:title "relatedOrganisation" ;
    rdfs:range sc:Identifier ;
    skos:definition "References (by Identifier) to Organisations associated with the entity." ;
    skos:inScheme sc:safeguarding .

sc:relatedPerson a owl:ObjectProperty ;
    rdfs:label "relatedPerson" ;
    rdfs:range sc:PersonRelationship ;
    skos:definition "References to other people related to this person, with the kind of relationship." ;
    skos:inScheme sc:person .

sc:relatedProfessionalObj a owl:ObjectProperty ;
    rdfs:label "relatedProfessionalObj" ;
    dcterms:title "relatedProfessional" ;
    rdfs:range sc:RelatedProfessional ;
    skos:definition "References to the Professional(s) involved, qualified by involvement." ;
    skos:inScheme sc:safeguarding .

sc:relatedProfessionalRef a owl:ObjectProperty ;
    rdfs:label "relatedProfessionalRef" ;
    dcterms:title "relatedProfessional" ;
    rdfs:range sc:Identifier ;
    skos:definition "References (by Identifier) to Professionals associated with the entity." ;
    skos:inScheme sc:safeguarding .

sc:serviceEpisodeId a owl:ObjectProperty ;
    rdfs:label "serviceEpisodeId" ;
    rdfs:range sc:Identifier ;
    skos:definition "Identifier for the safeguarding or care service episode during which this assessment / plan was completed." ;
    skos:inScheme sc:assessments-and-plans .

sc:sgAddress a owl:ObjectProperty ;
    rdfs:label "sgAddress" ;
    dcterms:title "address" ;
    rdfs:range sc:Address ;
    skos:definition "Physical location(s) of the entity." ;
    skos:inScheme sc:safeguarding .

sc:telephone a owl:DatatypeProperty ;
    rdfs:label "telephone" ;
    rdfs:range xsd:string ;
    skos:definition "One or more telephone numbers." ;
    skos:inScheme sc:common .

sc:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:range xsd:string ;
    skos:definition "A finding that cannot be represented as an Observation or Measurement." ;
    skos:inScheme sc:safeguarding .

sc:Any a owl:Class ;
    rdfs:label "Any" ;
    skos:definition "An open value whose structure is defined and validated elsewhere, not by this standard. Serialised as an arbitrary JSON object." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme sc:safeguarding .

sc:CareNeedsAssessment a owl:Class ;
    rdfs:label "CareNeedsAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:planId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:assessmentQuestion ],
        sc:FoundationalInformation ;
    skos:definition "A Care Needs Assessment record, completed when an adult contacts or is referred to a local authority's social services team." ;
    skos:exactMatch sc:CareNeedsAssessment ;
    skos:inScheme sc:assessments-and-plans .

sc:CarePlan a owl:Class ;
    rdfs:label "CarePlan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:careComponent ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:assessmentId ],
        sc:FoundationalInformation ;
    skos:definition "A Care Plan record, created immediately after an assessment if the person is found to be eligible." ;
    skos:exactMatch sc:CarePlan ;
    skos:inScheme sc:assessments-and-plans .

sc:LifeEvent a owl:Class ;
    rdfs:label "LifeEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:eventType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:sgIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:subjectPerson ] ;
    skos:definition "A significant, time-bound occurrence in an individual's life that may have implications for their safety, wellbeing or development - for example attendance at A&E, a child being reported as missing, or an exclusion from school. Life events are not inherently positive or negative but can signal levels of risk, vulnerability or changing need." ;
    skos:exactMatch sc:LifeEvent ;
    skos:inScheme sc:safeguarding .

sc:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:organisationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:active ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:relatedServiceRef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:sgIdentifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:entityName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:contactMulti ] ;
    skos:definition "An organisation involved in the safeguarding or wellbeing of a person - for example a local authority, an NHS trust, a school, or an education authority. Aligns with the FHIR Organization resource." ;
    skos:exactMatch sc:Organisation ;
    skos:inScheme sc:safeguarding .

sc:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:deceasedDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:genderCode ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:address ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:isDeceased ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:ethnicityCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:sexCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:aboutMe ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:dateOfBirth ] ;
    skos:definition "A person who is the subject of care. Core identity, demographic and contact data required to deliver and coordinate care must be present." ;
    skos:exactMatch sc:Person ;
    skos:inScheme sc:person-subject-of-care .

sc:Placement a owl:Class ;
    rdfs:label "Placement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskAssessment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:qualityAssurance ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementAvailability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:actualPlacement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementRecommendation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:childId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:placementId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementRequirements ] ;
    skos:definition "The top-level placement record for a looked-after child, linking together the referral availability, the child's requirements, the social-worker recommendation, the risk assessment, the quality-assurance metadata and (optionally) the placement actually arranged." ;
    skos:exactMatch sc:Placement ;
    skos:inScheme sc:placements .

sc:Professional a owl:Class ;
    rdfs:label "Professional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:status ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:contactSingle ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:sgIdentifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:professionalName ] ;
    skos:definition "An individual acting in a formal role within an organisation who has responsibilities relating to a person's safety, wellbeing, care or support - for example undertaking assessments, creating and monitoring plans, or sharing information in a multi-agency context." ;
    skos:exactMatch sc:Professional ;
    skos:inScheme sc:safeguarding .

sc:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:active ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:costFrequency ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:sgIdentifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:entityName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:serviceType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:contactMulti ] ;
    skos:definition "A service involved in the safeguarding or wellbeing of a person - the specific intervention or package of support delivered by one or more organisations (e.g. local authority social care, an emergency department, a general practice, or a school)." ;
    skos:exactMatch sc:Service ;
    skos:inScheme sc:safeguarding .

sc:ServiceEpisode a owl:Class ;
    rdfs:label "ServiceEpisode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:relatedServiceRef ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:episodeType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:sgIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:location ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:timeInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:subjectPerson ] ;
    skos:definition "A bounded period during which an individual receives a defined service, intervention, or package of support from a service or professional. It has a recognisable start and end point, though duration may vary from a single contact to sustained involvement over time." ;
    skos:exactMatch sc:ServiceEpisode ;
    skos:inScheme sc:safeguarding .

sc:UPRN a owl:DatatypeProperty ;
    rdfs:label "UPRN" ;
    rdfs:range xsd:string ;
    skos:definition "Unique Property Reference Number of the address." ;
    skos:inScheme sc:common .

sc:USRN a owl:DatatypeProperty ;
    rdfs:label "USRN" ;
    rdfs:range xsd:string ;
    skos:definition "Unique Street Reference Number of the address." ;
    skos:inScheme sc:common .

sc:aboutMe a owl:ObjectProperty ;
    rdfs:label "aboutMe" ;
    rdfs:range sc:Identifier ;
    skos:definition "A reference pointing to the person's self-reported \"About Me\" profile (an in-use standard across health and care allowing individuals to record their wants and needs). Uses the Identifier structure." ;
    skos:inScheme sc:person .

sc:activity a owl:ObjectProperty ;
    rdfs:label "activity" ;
    rdfs:range sc:CareActivity ;
    skos:definition "The activity details of this component of the plan." ;
    skos:inScheme sc:assessments-and-plans .

sc:activityDescription a owl:DatatypeProperty ;
    rdfs:label "activityDescription" ;
    rdfs:range xsd:string ;
    skos:definition "Text description of the care component." ;
    skos:inScheme sc:assessments-and-plans .

sc:actor a owl:ObjectProperty ;
    rdfs:label "actor" ;
    rdfs:range sc:CareActor ;
    skos:definition "The actors performing this component of the plan." ;
    skos:inScheme sc:assessments-and-plans .

sc:actorId a owl:ObjectProperty ;
    rdfs:label "actorId" ;
    rdfs:range sc:Identifier ;
    skos:definition "The ID of the person performing the item of the plan (Person ID, professional ID, or service ID)." ;
    skos:inScheme sc:assessments-and-plans .

sc:actorType a owl:ObjectProperty ;
    rdfs:label "actorType" ;
    rdfs:range sc:care-actor-type ;
    skos:definition "The type of person performing the component of the plan." ;
    skos:inScheme sc:assessments-and-plans .

sc:actualPlacement a owl:ObjectProperty ;
    rdfs:label "actualPlacement" ;
    rdfs:range sc:ActualPlacement ;
    skos:definition "Links a Placement to the ActualPlacement that was arranged. Optional - a referral may exist without (yet) having an actual placement." ;
    skos:inScheme sc:placements .

sc:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range sc:Address ;
    skos:definition "Physical addresses where the person can be contacted." ;
    skos:inScheme sc:person .

sc:addressUse a owl:ObjectProperty ;
    rdfs:label "addressUse" ;
    dcterms:title "use" ;
    rdfs:range sc:address-use-code ;
    skos:definition "How this address is used - home, work, temp, etc." ;
    skos:inScheme sc:common .

sc:advocateRequired a owl:DatatypeProperty ;
    rdfs:label "advocateRequired" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does the person require an advocate to complete this assessment / plan?" ;
    skos:inScheme sc:assessments-and-plans .

sc:answer a owl:DatatypeProperty ;
    rdfs:label "answer" ;
    rdfs:range xsd:string ;
    skos:definition "The answer to the question as measured in the assessment." ;
    skos:inScheme sc:assessments-and-plans .

sc:answerType a owl:ObjectProperty ;
    rdfs:label "answerType" ;
    rdfs:range sc:answer-type ;
    skos:definition "Indicates how the answer should be parsed (e.g., String, Boolean, Date, Number, Enum). Ensures data like dates or booleans aren't trapped as unparsable text." ;
    skos:inScheme sc:assessments-and-plans .

sc:apIdentifier a owl:ObjectProperty ;
    rdfs:label "apIdentifier" ;
    dcterms:title "identifier" ;
    rdfs:range sc:Identifier ;
    skos:definition "Identifier for this assessment / plan." ;
    skos:inScheme sc:assessments-and-plans .

sc:assessmentId a owl:ObjectProperty ;
    rdfs:label "assessmentId" ;
    rdfs:range sc:Identifier ;
    skos:definition "Assessment that led to this plan." ;
    skos:inScheme sc:assessments-and-plans .

sc:assessmentQuestion a owl:ObjectProperty ;
    rdfs:label "assessmentQuestion" ;
    rdfs:range sc:AssessmentQuestion ;
    skos:definition "The set of assessment questions and answers." ;
    skos:inScheme sc:assessments-and-plans .

sc:capacityToCompleteAssessment a owl:DatatypeProperty ;
    rdfs:label "capacityToCompleteAssessment" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does the person have the mental and physical capacity to complete this assessment / plan?" ;
    skos:inScheme sc:assessments-and-plans .

sc:careComponent a owl:ObjectProperty ;
    rdfs:label "careComponent" ;
    rdfs:range sc:CareComponent ;
    skos:definition "Components of the care package." ;
    skos:inScheme sc:assessments-and-plans .

sc:category a owl:ObjectProperty ;
    rdfs:label "category" ;
    rdfs:range sc:question-category ;
    skos:definition "The domain/category of the question." ;
    skos:inScheme sc:assessments-and-plans .

sc:childId a owl:DatatypeProperty ;
    rdfs:label "childId" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier unique to each child within the LA, allowing linking between multiple referrals for the same child." ;
    skos:inScheme sc:placements .

sc:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:range xsd:string ;
    skos:definition "City, town, or village." ;
    skos:inScheme sc:common .

sc:communicationNeeds a owl:ObjectProperty ;
    rdfs:label "communicationNeeds" ;
    rdfs:range sc:presence-status ;
    skos:definition "Whether the child has any communication, language or learning needs." ;
    skos:inScheme sc:placements .

sc:consentToInformationSharing a owl:DatatypeProperty ;
    rdfs:label "consentToInformationSharing" ;
    rdfs:range xsd:boolean ;
    skos:definition "Does the person consent to information sharing?" ;
    skos:inScheme sc:assessments-and-plans .

sc:contactName a owl:DatatypeProperty ;
    rdfs:label "contactName" ;
    dcterms:title "name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the contact type (for example, \"Home\", \"Work\", \"Other\")." ;
    skos:inScheme sc:common .

sc:contactSingle a owl:ObjectProperty ;
    rdfs:label "contactSingle" ;
    dcterms:title "contact" ;
    rdfs:range sc:Contact ;
    skos:definition "The professional's contact information (exactly one)." ;
    skos:inScheme sc:safeguarding .

sc:costDate a owl:DatatypeProperty ;
    rdfs:label "costDate" ;
    rdfs:range xsd:date ;
    skos:definition "Date when placement cost data was captured on the Case Management System." ;
    skos:inScheme sc:placements .

sc:costFrequency a owl:ObjectProperty ;
    rdfs:label "costFrequency" ;
    rdfs:range sc:service-cost-frequency ;
    skos:definition "The frequency at which the unit cost occurs." ;
    skos:inScheme sc:safeguarding .

sc:costOfficerName a owl:DatatypeProperty ;
    rdfs:label "costOfficerName" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the officer who recorded the placement cost data." ;
    skos:inScheme sc:placements .

sc:culturalNeeds a owl:ObjectProperty ;
    rdfs:label "culturalNeeds" ;
    rdfs:range sc:cultural-need ;
    skos:definition "Whether the placement must accommodate specific cultural needs (e.g., access to places of worship)." ;
    skos:inScheme sc:placements .

sc:date a owl:DatatypeProperty ;
    rdfs:label "date" ;
    rdfs:range xsd:date ;
    skos:definition "ISO 8601-formatted date (YYYY-MM-DD)." ;
    skos:inScheme sc:person .

sc:dateCompleted a owl:DatatypeProperty ;
    rdfs:label "dateCompleted" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time that the assessment / plan was completed." ;
    skos:inScheme sc:assessments-and-plans .

sc:dateOfBirth a owl:ObjectProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:range sc:PartialDate ;
    skos:definition "The person's date of birth, with an optional accuracy indicator." ;
    skos:inScheme sc:person .

sc:deceasedDate a owl:ObjectProperty ;
    rdfs:label "deceasedDate" ;
    rdfs:range sc:PartialDate ;
    skos:definition "The person's date of death, with an optional accuracy indicator. isDeceased may be true without a known date." ;
    skos:inScheme sc:person .

sc:deprivationOfLiberty a owl:DatatypeProperty ;
    rdfs:label "deprivationOfLiberty" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the child has a Deprivation of Liberty Order (DOL)." ;
    skos:inScheme sc:placements .

sc:directPayment a owl:DatatypeProperty ;
    rdfs:label "directPayment" ;
    rdfs:range xsd:boolean ;
    skos:definition "Flag whether this component is paid via direct payment." ;
    skos:inScheme sc:assessments-and-plans .

sc:episodeType a owl:ObjectProperty ;
    rdfs:label "episodeType" ;
    dcterms:title "type" ;
    rdfs:range sc:episode-code ;
    skos:definition "Code(s) for the type of service episode." ;
    skos:inScheme sc:safeguarding .

sc:ethnicityCode a owl:ObjectProperty ;
    rdfs:label "ethnicityCode" ;
    rdfs:range sc:ethnicity-code ;
    skos:definition "The person's stated ethnicity, using the ONS 18+1 categories from the 2021 census. Statutorily required in adult social care; optional elsewhere." ;
    skos:inScheme sc:person .

sc:eventType a owl:ObjectProperty ;
    rdfs:label "eventType" ;
    dcterms:title "type" ;
    rdfs:range sc:event-code ;
    skos:definition "Code(s) for the type of life event." ;
    skos:inScheme sc:safeguarding .

sc:familyName a owl:DatatypeProperty ;
    rdfs:label "familyName" ;
    rdfs:range xsd:string ;
    skos:definition "The surname or family name. Multi-valued to support compound or hyphenated family names recorded as separate parts." ;
    skos:inScheme sc:common .

sc:fosterCareSuitability a owl:ObjectProperty ;
    rdfs:label "fosterCareSuitability" ;
    rdfs:range sc:suitability-level ;
    skos:definition "Suitability of foster care for this child, as judged by the social worker." ;
    skos:inScheme sc:placements .

sc:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    rdfs:range xsd:string ;
    skos:definition "The frequency the component of the plan is performed, expressed using FHIR Timing or similar." ;
    skos:inScheme sc:assessments-and-plans .

sc:genderCode a owl:ObjectProperty ;
    rdfs:label "genderCode" ;
    rdfs:range sc:gender-code ;
    skos:definition "The person's stated gender." ;
    skos:inScheme sc:person .

sc:givenName a owl:DatatypeProperty ;
    rdfs:label "givenName" ;
    rdfs:range xsd:string ;
    skos:definition "The first name and any middle names." ;
    skos:inScheme sc:common .

sc:homeAdaptationRequired a owl:DatatypeProperty ;
    rdfs:label "homeAdaptationRequired" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether adaptations to the home are required to accommodate the child's needs." ;
    skos:inScheme sc:placements .

sc:isDeceased a owl:DatatypeProperty ;
    rdfs:label "isDeceased" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the person is deceased." ;
    skos:inScheme sc:person .

sc:isEducationContinuous a owl:DatatypeProperty ;
    rdfs:label "isEducationContinuous" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the child's education was continuous (i.e., not disrupted) as a result of this placement." ;
    skos:inScheme sc:placements .

sc:isLocationPreferred a owl:DatatypeProperty ;
    rdfs:label "isLocationPreferred" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the actual placement location was a preferred location." ;
    skos:inScheme sc:placements .

sc:isReview a owl:DatatypeProperty ;
    rdfs:label "isReview" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this is a review of a previous assessment / plan or not." ;
    skos:inScheme sc:assessments-and-plans .

sc:languageCode a owl:DatatypeProperty ;
    rdfs:label "languageCode" ;
    rdfs:range xsd:string ;
    skos:definition "A code or name representing the language (e.g., 'en', 'eng', 'bsl', 'British Sign Language')." ;
    skos:inScheme sc:person .

sc:line1 a owl:DatatypeProperty ;
    rdfs:label "line1" ;
    rdfs:range xsd:string ;
    skos:definition "Street address (e.g. \"1 High Street\") or care-of line." ;
    skos:inScheme sc:common .

sc:line2 a owl:DatatypeProperty ;
    rdfs:label "line2" ;
    rdfs:range xsd:string ;
    skos:definition "Apartment, suite, unit, building, floor, etc." ;
    skos:inScheme sc:common .

sc:livingCompanions a owl:ObjectProperty ;
    rdfs:label "livingCompanions" ;
    rdfs:range sc:living-arrangement ;
    skos:definition "Recommendation as to who the child can be cared for alongside (e.g., solo placement, with other children, only older children)." ;
    skos:inScheme sc:placements .

sc:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    rdfs:range xsd:string ;
    skos:definition "Details about the location of the episode or life event." ;
    skos:inScheme sc:safeguarding .

sc:measurementType a owl:ObjectProperty ;
    rdfs:label "measurementType" ;
    dcterms:title "type" ;
    rdfs:range sc:measurement-type ;
    skos:definition "The type of measurement." ;
    skos:inScheme sc:safeguarding .

sc:measurementUnit a owl:ObjectProperty ;
    rdfs:label "measurementUnit" ;
    dcterms:title "unit" ;
    rdfs:range sc:measurement-unit ;
    skos:definition "The unit of measurement." ;
    skos:inScheme sc:safeguarding .

sc:measurementValue a owl:DatatypeProperty ;
    rdfs:label "measurementValue" ;
    dcterms:title "value" ;
    rdfs:range xsd:decimal ;
    skos:definition "A decimal number representing the value of the measurement." ;
    skos:inScheme sc:safeguarding .

sc:name a owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:range sc:Name ;
    skos:definition "A name for the person, with a usage indicating its purpose (usual, maiden, nickname, etc.)." ;
    skos:inScheme sc:person .

sc:nameUse a owl:ObjectProperty ;
    rdfs:label "nameUse" ;
    dcterms:title "use" ;
    rdfs:range sc:name-use-code ;
    skos:definition "The purpose of this name instance - usual, official, former, etc." ;
    skos:inScheme sc:common .

sc:neededBy a owl:ObjectProperty ;
    rdfs:label "neededBy" ;
    rdfs:range sc:placement-urgency ;
    skos:definition "When the child needs to be placed by. Captures urgency rather than an absolute date." ;
    skos:inScheme sc:placements .

sc:needsAssessmentMethod a owl:ObjectProperty ;
    rdfs:label "needsAssessmentMethod" ;
    rdfs:range sc:needs-assessment-method ;
    skos:definition "How the child's needs were assessed." ;
    skos:inScheme sc:placements .

sc:nonPreferredLocationReason a owl:ObjectProperty ;
    rdfs:label "nonPreferredLocationReason" ;
    rdfs:range sc:non-preferred-location-reason ;
    skos:definition "The reason the placement was not found in the preferred location. Use 'Not applicable' when the placement was in the preferred location." ;
    skos:inScheme sc:placements .

sc:observationEndDate a owl:DatatypeProperty ;
    rdfs:label "observationEndDate" ;
    dcterms:title "endDate" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date at which this observation was made false (if now outdated)." ;
    skos:inScheme sc:safeguarding .

sc:observationStartDate a owl:DatatypeProperty ;
    rdfs:label "observationStartDate" ;
    dcterms:title "startDate" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date at which this observation was first true, as an ISO 8601 date-time." ;
    skos:inScheme sc:safeguarding .

sc:observationType a owl:DatatypeProperty ;
    rdfs:label "observationType" ;
    dcterms:title "type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of observation, drawn from the Observation Type Vocabulary (e.g. NEET, free-school-meals, SEND.SpLD). The vocabulary is extensible (some codes carry dynamic sub-parts such as EAL.<ISO 639-1 code>), so it is modelled as an open string rather than a closed enumeration. See the ObservationType enum for the reference list of codes." ;
    skos:inScheme sc:safeguarding .

sc:organisationType a owl:ObjectProperty ;
    rdfs:label "organisationType" ;
    dcterms:title "type" ;
    rdfs:range sc:organisation-code ;
    skos:definition "Code(s) for the kind of organisation." ;
    skos:inScheme sc:safeguarding .

sc:personId a owl:ObjectProperty ;
    rdfs:label "personId" ;
    rdfs:range sc:Identifier ;
    skos:definition "Identifier for the subject person." ;
    skos:inScheme sc:assessments-and-plans .

sc:pets a owl:ObjectProperty ;
    rdfs:label "pets" ;
    rdfs:range sc:pets-allowance ;
    skos:definition "Whether the child can or must live in a home with pets/animals." ;
    skos:inScheme sc:placements .

sc:placementAvailability a owl:ObjectProperty ;
    rdfs:label "placementAvailability" ;
    rdfs:range sc:PlacementAvailability ;
    skos:definition "Links a Placement to its PlacementAvailability (referral) record." ;
    skos:inScheme sc:placements .

sc:placementDateAdmin a owl:DatatypeProperty ;
    rdfs:label "placementDateAdmin" ;
    rdfs:range xsd:date ;
    skos:definition "Date of agreed placement start captured on the Case Management System." ;
    skos:inScheme sc:placements .

sc:placementId a owl:DatatypeProperty ;
    rdfs:label "placementId" ;
    rdfs:range xsd:string ;
    skos:definition "The unique identifier of the placement record within the LA case management system." ;
    skos:inScheme sc:placements .

sc:placementOfficerName a owl:DatatypeProperty ;
    rdfs:label "placementOfficerName" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the officer who recorded the actual placement information." ;
    skos:inScheme sc:placements .

sc:placementRecommendation a owl:ObjectProperty ;
    rdfs:label "placementRecommendation" ;
    rdfs:range sc:PlacementRecommendation ;
    skos:definition "Links a Placement to its PlacementRecommendation." ;
    skos:inScheme sc:placements .

sc:placementRequirements a owl:ObjectProperty ;
    rdfs:label "placementRequirements" ;
    rdfs:range sc:PlacementRequirements ;
    skos:definition "Links a Placement to its PlacementRequirements." ;
    skos:inScheme sc:placements .

sc:placementSource a owl:ObjectProperty ;
    rdfs:label "placementSource" ;
    rdfs:range sc:placement-source ;
    skos:definition "How the placement was sourced." ;
    skos:inScheme sc:placements .

sc:placementStartDate a owl:DatatypeProperty ;
    rdfs:label "placementStartDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date the placement started." ;
    skos:inScheme sc:placements .

sc:placementType a owl:ObjectProperty ;
    rdfs:label "placementType" ;
    rdfs:range sc:placement-type ;
    skos:definition "The type of placement the child received." ;
    skos:inScheme sc:placements .

sc:planId a owl:ObjectProperty ;
    rdfs:label "planId" ;
    rdfs:range sc:Identifier ;
    skos:definition "Any care plan linked to this assessment. Quick signpost that a) a plan was made (ie the person was determined to be eligible) and b) where the plan is (so you don't need to search for it)." ;
    skos:inScheme sc:assessments-and-plans .

sc:preferredName a owl:DatatypeProperty ;
    rdfs:label "preferredName" ;
    rdfs:range xsd:string ;
    skos:definition "Any preferred given or middle name used by the person - for example, \"Joe\" where their legal first name is \"Joseph\"." ;
    skos:inScheme sc:common .

sc:professional a owl:ObjectProperty ;
    rdfs:label "professional" ;
    rdfs:range sc:Identifier ;
    skos:definition "A reference (by Identifier) to a Professional record involved in the episode or life event." ;
    skos:inScheme sc:safeguarding .

sc:professionalId a owl:ObjectProperty ;
    rdfs:label "professionalId" ;
    rdfs:range sc:Identifier ;
    skos:definition "Identifier for the professional that authored the assessment/plan. Note that we don't need a serviceID, because you can find the service through the professional." ;
    skos:inScheme sc:assessments-and-plans .

sc:professionalName a owl:ObjectProperty ;
    rdfs:label "professionalName" ;
    dcterms:title "name" ;
    rdfs:range sc:Name ;
    skos:definition "The professional's name." ;
    skos:inScheme sc:safeguarding .

sc:proficiencyLevel a owl:DatatypeProperty ;
    rdfs:label "proficiencyLevel" ;
    rdfs:range xsd:string ;
    skos:definition "The level of proficiency or fluency in the language (e.g., 'fluent', 'native', 'basic')." ;
    skos:inScheme sc:person .

sc:providerURN a owl:DatatypeProperty ;
    rdfs:label "providerURN" ;
    rdfs:range xsd:string ;
    skos:definition "Provider Unique Reference Number, linked to Ofsted registration. Allows the placement to be linked to Ofsted data about the provider." ;
    skos:inScheme sc:placements .

sc:qualityAssurance a owl:ObjectProperty ;
    rdfs:label "qualityAssurance" ;
    rdfs:range sc:QualityAssurance ;
    skos:definition "Links a Placement to its QualityAssurance metadata." ;
    skos:inScheme sc:placements .

sc:questionId a owl:DatatypeProperty ;
    rdfs:label "questionId" ;
    rdfs:range xsd:string ;
    skos:definition "An ID for the question. For statutory questions, this should conform to the dictionary of statutory question IDs; for personalised, non statutory questions, this can be anything or left blank." ;
    skos:inScheme sc:assessments-and-plans .

sc:questionText a owl:DatatypeProperty ;
    rdfs:label "questionText" ;
    rdfs:range xsd:string ;
    skos:definition "The exact wording of the question as it appears on the local authority's form." ;
    skos:inScheme sc:assessments-and-plans .

sc:referralDate a owl:DatatypeProperty ;
    rdfs:label "referralDate" ;
    rdfs:range xsd:date ;
    skos:definition "Date of when referral was captured on the Case Management System." ;
    skos:inScheme sc:placements .

sc:referralOfficerName a owl:DatatypeProperty ;
    rdfs:label "referralOfficerName" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the officer who recorded the referral information. LA-internal QA only." ;
    skos:inScheme sc:placements .

sc:relationship a owl:ObjectProperty ;
    rdfs:label "relationship" ;
    rdfs:range sc:person-relationship-code ;
    skos:definition "One or more codes describing the kind of relationship." ;
    skos:inScheme sc:person .

sc:required a owl:DatatypeProperty ;
    rdfs:label "required" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this question was mandatory on the local authority’s assessment. Should always be True for statutory fields." ;
    skos:inScheme sc:assessments-and-plans .

sc:residentialCareSuitability a owl:ObjectProperty ;
    rdfs:label "residentialCareSuitability" ;
    rdfs:range sc:suitability-level ;
    skos:definition "Suitability of residential care for this child." ;
    skos:inScheme sc:placements .

sc:review a owl:ObjectProperty ;
    rdfs:label "review" ;
    rdfs:range sc:Review ;
    skos:definition "List of reviews." ;
    skos:inScheme sc:assessments-and-plans .

sc:riskAssessment a owl:ObjectProperty ;
    rdfs:label "riskAssessment" ;
    rdfs:range sc:RiskAssessment ;
    skos:definition "Links a Placement to its RiskAssessment." ;
    skos:inScheme sc:placements .

sc:riskCriminalExploitation a owl:ObjectProperty ;
    rdfs:label "riskCriminalExploitation" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether the child is known to be at risk of criminal exploitation." ;
    skos:inScheme sc:placements .

sc:riskDrugAlcohol a owl:ObjectProperty ;
    rdfs:label "riskDrugAlcohol" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether the child is known to be at risk of drug and alcohol use." ;
    skos:inScheme sc:placements .

sc:riskEatingDisorder a owl:ObjectProperty ;
    rdfs:label "riskEatingDisorder" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether the child is known to be at risk of an eating disorder." ;
    skos:inScheme sc:placements .

sc:riskMissing a owl:ObjectProperty ;
    rdfs:label "riskMissing" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether the child is known to be at risk of going missing." ;
    skos:inScheme sc:placements .

sc:riskSelfHarm a owl:ObjectProperty ;
    rdfs:label "riskSelfHarm" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether the child is known to be at risk of self-harm." ;
    skos:inScheme sc:placements .

sc:riskSexualExploitation a owl:ObjectProperty ;
    rdfs:label "riskSexualExploitation" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether the child is known to be at risk of sexual exploitation." ;
    skos:inScheme sc:placements .

sc:riskToOthersAnimals a owl:ObjectProperty ;
    rdfs:label "riskToOthersAnimals" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether there is a known risk of harm to animals." ;
    skos:inScheme sc:placements .

sc:riskToOthersCriminal a owl:ObjectProperty ;
    rdfs:label "riskToOthersCriminal" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether there is a known risk of criminal exploitation for others in the home." ;
    skos:inScheme sc:placements .

sc:riskToOthersFire a owl:ObjectProperty ;
    rdfs:label "riskToOthersFire" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether there is a known risk of fire-setting." ;
    skos:inScheme sc:placements .

sc:riskToOthersPhysical a owl:ObjectProperty ;
    rdfs:label "riskToOthersPhysical" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether there is a known risk of physical harm to others." ;
    skos:inScheme sc:placements .

sc:riskToOthersSexual a owl:ObjectProperty ;
    rdfs:label "riskToOthersSexual" ;
    rdfs:range sc:risk-level ;
    skos:definition "Whether there is a known risk of sexual harm to others." ;
    skos:inScheme sc:placements .

sc:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    rdfs:range xsd:string ;
    skos:definition "Text describing the professional's occupational role." ;
    skos:inScheme sc:safeguarding .

sc:serviceFrequency a owl:ObjectProperty ;
    rdfs:label "serviceFrequency" ;
    dcterms:title "frequency" ;
    rdfs:range sc:Any ;
    skos:definition "The frequency of the episode or life event, expressed as a [FHIR Timing](https://build.fhir.org/datatypes.html#Timing) datatype. This standard does not define or validate its structure; the value is an arbitrary JSON object conforming to FHIR Timing." ;
    skos:inScheme sc:safeguarding .

sc:serviceType a owl:ObjectProperty ;
    rdfs:label "serviceType" ;
    dcterms:title "type" ;
    rdfs:range sc:service-code ;
    skos:definition "Code(s) for the kind of service." ;
    skos:inScheme sc:safeguarding .

sc:sexCode a owl:ObjectProperty ;
    rdfs:label "sexCode" ;
    rdfs:range sc:phenotypic-sex-code ;
    skos:definition "Observed phenotypic sex, where recorded." ;
    skos:inScheme sc:person .

sc:siblingCount a owl:DatatypeProperty ;
    rdfs:label "siblingCount" ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "How many siblings the child should ideally be placed with according to the care plan. 0 if the child has no siblings or is not to be placed with siblings." ;
    skos:inScheme sc:placements .

sc:siblingsPlacedTogether a owl:DatatypeProperty ;
    rdfs:label "siblingsPlacedTogether" ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "How many siblings were actually placed together." ;
    skos:inScheme sc:placements .

sc:specialCommunicationNeeds a owl:DatatypeProperty ;
    rdfs:label "specialCommunicationNeeds" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text describing professionally recorded communication needs or reasonable adjustments (e.g. BSL interpreter needed, uses communication board)." ;
    skos:inScheme sc:person .

sc:specificCommunicationRequirement a owl:ObjectProperty ;
    rdfs:label "specificCommunicationRequirement" ;
    rdfs:range sc:communication-need ;
    skos:definition "Specific communication or language requirement (ESOL, BSL, Makaton, Other, None). Multi-valued: a placement may have several." ;
    skos:inScheme sc:placements .

sc:supportedAccommodationSuitability a owl:ObjectProperty ;
    rdfs:label "supportedAccommodationSuitability" ;
    rdfs:range sc:suitability-level ;
    skos:definition "Suitability of supported accommodation for this child." ;
    skos:inScheme sc:placements .

sc:system a owl:DatatypeProperty ;
    rdfs:label "system" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The URI of the system or namespace within which the identifier is unique (e.g. https://fhir.nhs.uk/Id/nhs-number)." ;
    skos:inScheme sc:common .

sc:time a owl:ObjectProperty ;
    rdfs:label "time" ;
    rdfs:range sc:CareTiming ;
    skos:definition "The schedule and timing information of this component of the plan." ;
    skos:inScheme sc:assessments-and-plans .

sc:timeInformation a owl:ObjectProperty ;
    rdfs:label "timeInformation" ;
    rdfs:range sc:TimeInformation ;
    skos:definition "Details about the timing of the episode or life event." ;
    skos:inScheme sc:safeguarding .

sc:uascStatus a owl:ObjectProperty ;
    rdfs:label "uascStatus" ;
    rdfs:range sc:uasc-status ;
    skos:definition "Whether the child is an unaccompanied asylum-seeking child (UASC)." ;
    skos:inScheme sc:placements .

sc:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "The identifier value, unique within the issuing system." ;
    skos:inScheme sc:common .

xsd:nonNegativeInteger a rdfs:Datatype ;
    owl:equivalentClass [ owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] .

sc:ActualPlacement a owl:Class ;
    rdfs:label "ActualPlacement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty sc:additionalSupportWeeklyCost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:additionalSupportWeeklyCost ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty sc:otherWeeklyCost ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:nonPreferredLocationReason ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 100 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 100000 ] ) ] ) ] ;
            owl:onProperty sc:totalWeeklyCost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:educationWeeklyCost ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty sc:educationWeeklyCost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:otherWeeklyCost ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:providerURN ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty sc:coreWeeklyCost ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:totalWeeklyCost ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementSource ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementLocation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:coreWeeklyCost ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementStartDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]?$" ] ) ] ) ] ;
            owl:onProperty sc:placementLocation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:isLocationPreferred ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:isEducationContinuous ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:siblingsPlacedTogether ] ;
    skos:definition "The placement actually arranged for the child, including weekly cost (with optional breakdown), location, provider URN, sibling co-placement and educational continuity. Optional - a Placement may not (yet) have one." ;
    skos:exactMatch sc:ActualPlacement ;
    skos:inScheme sc:placements .

sc:AssessmentQuestion a owl:Class ;
    rdfs:label "AssessmentQuestion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:questionId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:questionText ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:answerType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:answer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:category ] ;
    skos:definition "A generic Question-and-Answer model used to represent both statutory Care Act questions and local, personalised fields." ;
    skos:exactMatch sc:AssessmentQuestion ;
    skos:inScheme sc:assessments-and-plans .

sc:CareActivity a owl:Class ;
    rdfs:label "CareActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:outcome ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:directPayment ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:activityDescription ] ;
    skos:definition "The description and details of the care component activity." ;
    skos:exactMatch sc:CareActivity ;
    skos:inScheme sc:assessments-and-plans .

sc:CareActor a owl:Class ;
    rdfs:label "CareActor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:actorId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:actorType ] ;
    skos:definition "The actor performing a care component." ;
    skos:exactMatch sc:CareActor ;
    skos:inScheme sc:assessments-and-plans .

sc:CareComponent a owl:Class ;
    rdfs:label "CareComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:activity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:actor ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:time ] ;
    skos:definition "A specific component of a Care Plan, capturing who does what, when, and to achieve which outcomes." ;
    skos:exactMatch sc:CareComponent ;
    skos:inScheme sc:assessments-and-plans .

sc:CareTiming a owl:Class ;
    rdfs:label "CareTiming" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:startDateTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:endDateTime ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:frequency ] ;
    skos:definition "The schedule and timing information of a care component." ;
    skos:exactMatch sc:CareTiming ;
    skos:inScheme sc:assessments-and-plans .

sc:Communication a owl:Class ;
    rdfs:label "Communication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:specialCommunicationNeeds ] ;
    skos:definition "Professional recording of a person's communication requirements and language proficiencies." ;
    skos:exactMatch sc:Communication ;
    skos:inScheme sc:person .

sc:Finding a owl:Class ;
    rdfs:label "Finding" ;
    skos:definition "An observation or measurement made during the course of a service episode about the subject and their circumstances. May be recorded as a structured Observation, a quantitative Measurement, and/or free text." ;
    skos:exactMatch sc:Finding ;
    skos:inScheme sc:safeguarding .

sc:Language a owl:Class ;
    rdfs:label "Language" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:proficiencyLevel ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:languageCode ] ;
    skos:definition "A specific language the person is proficient in, including proficiency level." ;
    skos:exactMatch sc:Language ;
    skos:inScheme sc:person .

sc:Measurement a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:measurementUnit ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:measurementValue ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:measurementType ] ;
    skos:definition "A quantitative measurement of something related to the subject or their circumstances (for example \"Authorised Absences\" or \"Referrals\")." ;
    skos:exactMatch sc:Measurement ;
    skos:inScheme sc:safeguarding .

sc:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:observationStartDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:observationEndDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:observationType ] ;
    skos:definition "A qualitative observation that represents an attribute of the subject or their circumstances (for example \"NEET\" or \"free-school-meals\")." ;
    skos:exactMatch sc:Observation ;
    skos:inScheme sc:safeguarding .

sc:PersonRelationship a owl:Class ;
    rdfs:label "PersonRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:relationship ] ;
    skos:definition "A typed reference from one person to another. The reference is by Identifier (so the related person may live in a different system) and is qualified by one or more relationship codes." ;
    skos:exactMatch sc:PersonRelationship ;
    skos:inScheme sc:person .

sc:PlacementAvailability a owl:Class ;
    rdfs:label "PlacementAvailability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:uascStatus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:siblingCount ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:neededBy ] ;
    skos:definition "The referral request details: how urgently the child needs to be placed, how many siblings should be placed together, whether the preferred location is local, and (if out of area) why." ;
    skos:exactMatch sc:PlacementAvailability ;
    skos:inScheme sc:placements .

sc:PlacementRecommendation a owl:Class ;
    rdfs:label "PlacementRecommendation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:fosterCareSuitability ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:supportedAccommodationSuitability ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:residentialCareSuitability ] ;
    skos:definition "The social worker's recommendation of which categories of placement (foster, residential, supported accommodation) are preferred, suitable but not preferred, unsuitable, or unspecified." ;
    skos:exactMatch sc:PlacementRecommendation ;
    skos:inScheme sc:placements .

sc:PlacementRequirements a owl:Class ;
    rdfs:label "PlacementRequirements" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:homeAdaptationRequired ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:needsAssessmentMethod ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:livingCompanions ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:communicationNeeds ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:deprivationOfLiberty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sc:specificCommunicationRequirement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:pets ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:culturalNeeds ] ;
    skos:definition "The child's needs that the placement must accommodate: communication, cultural, living companions, pets, additional support, deprivation of liberty and home adaptation." ;
    skos:exactMatch sc:PlacementRequirements ;
    skos:inScheme sc:placements .

sc:QualityAssurance a owl:Class ;
    rdfs:label "QualityAssurance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:referralOfficerName ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:referralDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementDateAdmin ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:placementOfficerName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:costOfficerName ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:costDate ] ;
    skos:definition "Metadata about who recorded each part of the placement record (referral, placement, cost) and when. Supports LA-internal review of data-entry practices; not intended to be shared beyond the recording LA." ;
    skos:exactMatch sc:QualityAssurance ;
    skos:inScheme sc:placements .

sc:RelatedProfessional a owl:Class ;
    rdfs:label "RelatedProfessional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:professional ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:involvement ] ;
    skos:definition "A typed reference to a Professional involved in a service episode or life event." ;
    skos:exactMatch sc:RelatedProfessional ;
    skos:inScheme sc:safeguarding .

sc:Review a owl:Class ;
    rdfs:label "Review" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:isReview ] ;
    skos:definition "Review information associated with an assessment or care plan." ;
    skos:exactMatch sc:Review ;
    skos:inScheme sc:assessments-and-plans .

sc:RiskAssessment a owl:Class ;
    rdfs:label "RiskAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskMissing ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskToOthersFire ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskToOthersPhysical ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskToOthersCriminal ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskCriminalExploitation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskDrugAlcohol ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskSexualExploitation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskEatingDisorder ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskToOthersAnimals ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskSelfHarm ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:riskToOthersSexual ] ;
    skos:definition "Assessment of risks the child is exposed to and risks the child poses to others or property. Each risk is recorded as 'no known risk' or 'risk present'." ;
    skos:exactMatch sc:RiskAssessment ;
    skos:inScheme sc:placements .

sc:SubjectPerson a owl:Class ;
    rdfs:label "SubjectPerson" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:person ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:involvement ] ;
    skos:definition "A typed reference to a Person involved in a service episode or life event." ;
    skos:exactMatch sc:SubjectPerson ;
    skos:inScheme sc:safeguarding .

sc:TimeInformation a owl:Class ;
    rdfs:label "TimeInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:serviceFrequency ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sc:startDateTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sc:endDateTime ] ;
    skos:definition "Details about the timing of a service episode or life event, including when it started and ended and how frequently it recurs." ;
    skos:exactMatch sc:TimeInformation ;
    skos:inScheme sc:safeguarding .

sc:accuracyIndicator a owl:DatatypeProperty ;
    rdfs:label "accuracyIndicator" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
    skos:definition "A three-character code in day-month-year order indicating which parts of the date are accurate (A), estimated (E), or unknown (U)." ;
    skos:inScheme sc:person .

sc:active a owl:DatatypeProperty ;
    rdfs:label "active" ;
    rdfs:range xsd:boolean ;
    skos:definition "Code for the entity's status - whether it is currently active." ;
    skos:inScheme sc:safeguarding .

sc:additionalSupportWeeklyCost a owl:DatatypeProperty ;
    rdfs:label "additionalSupportWeeklyCost" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:decimal [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Total weekly additional-support cost: costs incurred over and above the core cost to meet the specific needs of the child." ;
    skos:inScheme sc:placements .

