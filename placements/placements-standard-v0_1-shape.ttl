@prefix cln: <https://ontology.socialcaredata.io/cultural-need#> .
@prefix cn: <https://ontology.socialcaredata.io/communication-need#> .
@prefix la: <https://ontology.socialcaredata.io/living-arrangement#> .
@prefix pa: <https://ontology.socialcaredata.io/pets-allowance#> .
@prefix pl: <https://ontology.socialcaredata.io/> .
@prefix pt: <https://ontology.socialcaredata.io/placement-type#> .
@prefix pu: <https://ontology.socialcaredata.io/placement-urgency#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rl: <https://ontology.socialcaredata.io/risk-level#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sl: <https://ontology.socialcaredata.io/suitability-level#> .
@prefix st: <https://ontology.socialcaredata.io/support-type#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yns: <https://ontology.socialcaredata.io/presence-status#> .

pl:ActualPlacementShape a sh:NodeShape ;
    rdfs:comment "The placement actually arranged for the child, including total weekly cost, location, provider URN, sibling co-placement and educational continuity. Optional - a Placement may not (yet) have one." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the child's education was continuous (i.e., not disrupted) as a result of this placement." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pl:isEducationContinuous ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the actual placement location was a preferred location." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pl:isLocationPreferred ],
        [ sh:description "The type of placement the child received." ;
            sh:in ( pt:Foster pt:Residential pt:SupportedAccommodation ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pl:placementType ],
        [ sh:datatype xsd:integer ;
            sh:description "Total weekly fee paid for the placement (actual weekly fee paid)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pl:totalWeeklyCost ],
        [ sh:datatype xsd:string ;
            sh:description "The location of the actual placement." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pl:placementLocation ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "How many siblings were actually placed together." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pl:siblingsPlacedTogether ],
        [ sh:datatype xsd:string ;
            sh:description "Provider Unique Reference Number, linked to Ofsted registration. Allows the placement to be linked to Ofsted data about the provider." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pl:providerURN ] ;
    sh:targetClass pl:ActualPlacement .

pl:PlacementAvailabilityShape a sh:NodeShape ;
    rdfs:comment "The referral request details: how urgently the child needs to be placed, how many siblings should be placed together, and the preferred location for the home search." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "When the child needs to be placed by. Captures urgency rather than an absolute date." ;
            sh:in ( pu:Today pu:WithinFiveDays pu:MoreThanFiveDays ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path pl:neededBy ],
        [ sh:datatype xsd:string ;
            sh:description "Preferred location for the home search." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pl:preferredLocation ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "How many siblings the child should ideally be placed with according to the care plan. 0 if the child has no siblings or is not to be placed with siblings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pl:siblingCount ] ;
    sh:targetClass pl:PlacementAvailability .

pl:PlacementRecommendationShape a sh:NodeShape ;
    rdfs:comment "The social worker's recommendation of which categories of placement (foster, residential, supported accommodation) are preferred, suitable but not preferred, unsuitable, or unspecified." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Suitability of residential care for this child." ;
            sh:in ( sl:Preferred sl:SuitableButNotPreferred sl:Unsuitable sl:NotSpecified ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pl:residentialCareSuitability ],
        [ sh:description "Suitability of supported accommodation for this child." ;
            sh:in ( sl:Preferred sl:SuitableButNotPreferred sl:Unsuitable sl:NotSpecified ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pl:supportedAccommodationSuitability ],
        [ sh:description "Suitability of foster care for this child, as judged by the social worker." ;
            sh:in ( sl:Preferred sl:SuitableButNotPreferred sl:Unsuitable sl:NotSpecified ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pl:fosterCareSuitability ] ;
    sh:targetClass pl:PlacementRecommendation .

pl:PlacementRequirementsShape a sh:NodeShape ;
    rdfs:comment "The child's needs that the placement must accommodate: communication, cultural, living companions, pets, additional support, deprivation of liberty and home adaptation." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the child has a Deprivation of Liberty Order (DOL)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pl:deprivationOfLiberty ],
        [ sh:description "Additional support provision required (e.g., additional supervision, therapeutic support, taxis to school)." ;
            sh:in ( st:AdditionalSupervision st:TherapeuticSupport st:WorkerForRespite st:TaxisToSchool st:NotApplicable st:Other ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path pl:additionalSupport ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether adaptations to the home are required to accommodate the child's needs." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pl:homeAdaptationRequired ],
        [ sh:description "Whether the child has any communication, language or learning needs." ;
            sh:in ( yns:Yes yns:No yns:NotSpecified ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pl:communicationNeeds ],
        [ sh:description "Whether the placement must accommodate specific cultural needs (e.g., access to places of worship)." ;
            sh:in ( cln:Required cln:NotRequired cln:NotKnown cln:Other ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pl:culturalNeeds ],
        [ sh:description "Whether the child can or must live in a home with pets/animals." ;
            sh:in ( pa:YesMust pa:YesCan pa:No pa:NotKnown ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path pl:pets ],
        [ sh:description "Recommendation as to who the child can be cared for alongside (e.g., solo placement, with other children, only older children)." ;
            sh:in ( la:SoloPlacement la:WithOtherChildren la:OnlyWithOlderChildren la:OnlyWithYoungerChildren la:NoPreference ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pl:livingCompanions ],
        [ sh:description "Specific communication or language requirement (ESOL, BSL, Makaton, Other, None). Multi-valued: a placement may have several." ;
            sh:in ( cn:ESOL cn:BSL cn:Makaton cn:Other cn:None ) ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pl:specificCommunicationRequirement ] ;
    sh:targetClass pl:PlacementRequirements .

pl:PlacementShape a sh:NodeShape ;
    rdfs:comment "The top-level placement record for a looked-after child, linking together the referral availability, the child's requirements, the social-worker recommendation, the risk assessment, the quality-assurance metadata and (optionally) the placement actually arranged." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The unique identifier of the placement record within the LA case management system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pl:placementId ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier unique to each child within the LA, allowing linking between multiple referrals for the same child." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pl:childId ],
        [ sh:class pl:PlacementAvailability ;
            sh:description "Links a Placement to its PlacementAvailability (referral) record." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path pl:placementAvailability ],
        [ sh:class pl:ActualPlacement ;
            sh:description "Links a Placement to the ActualPlacement that was arranged. Optional - a referral may exist without (yet) having an actual placement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path pl:actualPlacement ],
        [ sh:class pl:PlacementRecommendation ;
            sh:description "Links a Placement to its PlacementRecommendation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pl:placementRecommendation ],
        [ sh:class pl:RiskAssessment ;
            sh:description "Links a Placement to its RiskAssessment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path pl:riskAssessment ],
        [ sh:class pl:QualityAssurance ;
            sh:description "Links a Placement to its QualityAssurance metadata." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path pl:qualityAssurance ],
        [ sh:class pl:PlacementRequirements ;
            sh:description "Links a Placement to its PlacementRequirements." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path pl:placementRequirements ] ;
    sh:targetClass pl:Placement .

pl:QualityAssuranceShape a sh:NodeShape ;
    rdfs:comment "Metadata about who recorded each part of the placement record (referral, placement, cost) and when. Supports LA-internal review of data-entry practices; not intended to be shared beyond the recording LA." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the officer who recorded the actual placement information." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pl:placementOfficerName ],
        [ sh:datatype xsd:date ;
            sh:description "Date the referral data was captured." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pl:referralDate ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the officer who recorded the referral information. LA-internal QA only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pl:referralOfficerName ],
        [ sh:datatype xsd:date ;
            sh:description "Date the actual placement data was captured." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pl:placementDate ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the officer who recorded the placement cost data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pl:costOfficerName ],
        [ sh:datatype xsd:date ;
            sh:description "Date the placement cost data was captured." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pl:costDate ] ;
    sh:targetClass pl:QualityAssurance .

pl:RiskAssessmentShape a sh:NodeShape ;
    rdfs:comment "Assessment of risks the child is exposed to and risks the child poses to others or property. Each risk is recorded as 'no known risk' or 'risk present'." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Whether the child is known to be at risk of drug and alcohol use." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pl:riskDrugAlcohol ],
        [ sh:description "Whether there is a known risk of harm to animals." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path pl:riskToOthersAnimals ],
        [ sh:description "Whether there is a known risk of criminal exploitation for others in the home." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 11 ;
            sh:path pl:riskToOthersCriminal ],
        [ sh:description "Whether the child is known to be at risk of self-harm." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pl:riskSelfHarm ],
        [ sh:description "Whether there is a known risk of other types of harm to others not captured by the standard risk categories." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 12 ;
            sh:path pl:riskToOthersOther ],
        [ sh:description "Whether there is a known risk of physical harm to others." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path pl:riskToOthersPhysical ],
        [ sh:description "Whether the child is known to be at risk of criminal exploitation." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pl:riskCriminalExploitation ],
        [ sh:description "Whether the child is known to be at risk of going missing." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path pl:riskMissing ],
        [ sh:description "Whether the child is known to be at risk of an eating disorder." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pl:riskEatingDisorder ],
        [ sh:description "Whether there is a known risk of other types of harm to the child not captured by the standard risk categories." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path pl:riskOther ],
        [ sh:description "Whether the child is known to be at risk of sexual exploitation." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path pl:riskSexualExploitation ],
        [ sh:description "Whether there is a known risk of fire-setting." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path pl:riskToOthersFire ],
        [ sh:description "Whether there is a known risk of sexual harm to others." ;
            sh:in ( rl:NoKnownRisk rl:RiskPresent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path pl:riskToOthersSexual ] ;
    sh:targetClass pl:RiskAssessment .

