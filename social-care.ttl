@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://ns.socialcaredata.io/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sc:social-care a owl:Ontology ;
    rdfs:label "social-care-ontology" ;
    dcterms:license "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" ;
    dcterms:title "Social Care Ontology" ;
    pav:version "v2026-10-19" ;
    owl:imports <https://raw.githubusercontent.com/SocialCareData/ontology/main/assessments-and-plans/assessments-and-plans-standard.ttl>,
        <https://raw.githubusercontent.com/SocialCareData/ontology/main/common/common.ttl>,
        <https://raw.githubusercontent.com/SocialCareData/ontology/main/person/person-subject-of-care.ttl>,
        <https://raw.githubusercontent.com/SocialCareData/ontology/main/placements/placements-standard.ttl>,
        <https://raw.githubusercontent.com/SocialCareData/ontology/main/safeguarding/safeguarding-standard.ttl> ;
    skos:definition """The Social Care ontology. It has no classes or slots of its own; it composes the independently-versioned modules - common, person, placements, safeguarding, and assessments-and-plans - into a single ontology under one flat namespace (https://ns.socialcaredata.io/).
Each module is authored and versioned on its own cadence; a MAIS release pins a compatible set of module versions (see manifest.yaml) and is generated from this file.""" .

