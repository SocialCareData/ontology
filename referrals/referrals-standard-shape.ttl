@prefix con: <https://ns.socialcaredata.io/concern#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://ns.socialcaredata.io/> .
@prefix rft: <https://ns.socialcaredata.io/referrer-type#> .
@prefix rp: <https://ns.socialcaredata.io/request-purpose#> .
@prefix rqc: <https://ns.socialcaredata.io/referral-question-category#> .
@prefix rr: <https://ns.socialcaredata.io/record-relationship#> .
@prefix rt: <https://ns.socialcaredata.io/referral-type#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix svc: <https://ns.socialcaredata.io/service-code#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ref:AddressShape a sh:NodeShape ;
    rdfs:comment "A postal address. Aligned with FHIR Address. UPRN and USRN support property- and street-level disambiguation." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "How this address is used - home, work, temp, etc." ;
            sh:in ( <https://ns.socialcaredata.io/address-use-code#Home> <https://ns.socialcaredata.io/address-use-code#Work> <https://ns.socialcaredata.io/address-use-code#Temp> <https://ns.socialcaredata.io/address-use-code#Old> <https://ns.socialcaredata.io/address-use-code#Billing> ) ;
            sh:maxCount 1 ;
            sh:name "use" ;
            sh:order 6 ;
            sh:path ref:use ],
        [ sh:datatype xsd:string ;
            sh:description "Unique Property Reference Number of the address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path ref:UPRN ],
        [ sh:datatype xsd:string ;
            sh:description "Apartment, suite, unit, building, floor, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:line2 ],
        [ sh:datatype xsd:string ;
            sh:description "Unique Street Reference Number of the address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path ref:USRN ],
        [ sh:datatype xsd:string ;
            sh:description "City, town, or village." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:city ],
        [ sh:datatype xsd:string ;
            sh:description "Street address (e.g. \"1 High Street\") or care-of line." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:line1 ],
        [ sh:datatype xsd:string ;
            sh:description "UK postcode in standard format (e.g. AB1 2CD)." ;
            sh:maxCount 1 ;
            sh:message "Use a UK postcode in upper case, with an optional space - for example `AB1 2CD`."^^xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ref:postcode ;
            sh:pattern "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$" ] ;
    sh:targetClass ref:Address .

ref:AssessmentQuestionShape a sh:NodeShape ;
    rdfs:comment "A generic Question-and-Answer model used to represent both statutory and local, personalised questions." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether this question was mandatory on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path ref:required ],
        [ sh:datatype xsd:string ;
            sh:description "An ID for the question. Standards may define a dictionary of IDs for statutory or well-known questions; for personalised, local questions, this can be anything or left blank." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:questionId ],
        [ sh:description "Indicates how the answer should be parsed (e.g., String, Boolean, Date, Number, Enum). Ensures data like dates or booleans aren't trapped as unparsable text." ;
            sh:in ( <https://ns.socialcaredata.io/answer-type#String> <https://ns.socialcaredata.io/answer-type#Boolean> <https://ns.socialcaredata.io/answer-type#Date> <https://ns.socialcaredata.io/answer-type#Number> <https://ns.socialcaredata.io/answer-type#Enum> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path ref:answerType ],
        [ sh:datatype xsd:string ;
            sh:description "The exact wording of the question as it appears on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:questionText ],
        [ sh:datatype xsd:string ;
            sh:description "The answer to the question." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ref:answer ],
        [ sh:datatype xsd:string ;
            sh:description "The domain/category of the question." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:category ] ;
    sh:targetClass ref:AssessmentQuestion .

ref:CommunicationShape a sh:NodeShape ;
    rdfs:comment "Professional recording of a person's communication requirements and language proficiencies." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class ref:Language ;
            sh:description "Specific language(s) spoken or understood by the person, optionally annotated with proficiency." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path ref:language ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text describing professionally recorded communication needs or reasonable adjustments (e.g. BSL interpreter needed, uses communication board)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:specialCommunicationNeeds ] ;
    sh:targetClass ref:Communication .

ref:ConcernDetailShape a sh:NodeShape ;
    rdfs:comment "Identified concern and optional descriptive details." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free text description of concern." ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:concernDescription ],
        [ sh:description "The code identifying the concern." ;
            sh:in ( con:ChildPhysicalAbuse con:ChildSexualAbuse con:ChildEmotionalAbuse con:ChildNeglect con:ChildExploitation con:ChildParentalConcern con:ChildMissingEducation con:ChildGoingMissing con:ChildContextualRisk con:ChildOther con:AdultPhysicalAbuse con:AdultSexualAbuse con:AdultEmotionalAbuse con:AdultNeglect con:AdultFinancialCoercion con:AdultDiscrimination con:AdultDomesticAbuse con:AdultModernSlavery con:AdultSelfHarm con:AdultSubstanceAbuse con:AdultOther ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "concernType" ;
            sh:order 0 ;
            sh:path ref:concernType ] ;
    sh:targetClass ref:ConcernDetail .

ref:ContactShape a sh:NodeShape ;
    rdfs:comment "Contact details, such as a home, work, or other contact channel grouping." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "One or more telephone numbers." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:telephone ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the contact type (for example, \"Home\", \"Work\", \"Other\")." ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:contactName ],
        [ sh:datatype xsd:string ;
            sh:description "One or more email addresses." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:email ] ;
    sh:targetClass ref:Contact .

ref:DocumentReferenceShape a sh:NodeShape ;
    rdfs:comment "Reference to an attached document or evidence supporting the referral or request." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Text description of the document." ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path ref:documentDescription ],
        [ sh:description "Web address or storage URI where the document can be retrieved." ;
            sh:maxCount 1 ;
            sh:name "url" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path ref:documentUrl ],
        [ sh:class ref:Identifier ;
            sh:description "Unique identifier for the document." ;
            sh:maxCount 1 ;
            sh:name "documentId" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:documentId ],
        [ sh:datatype xsd:string ;
            sh:description "Title or display name of the document." ;
            sh:maxCount 1 ;
            sh:name "title" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:documentTitle ],
        [ sh:datatype xsd:string ;
            sh:description "Media type / MIME type of the document." ;
            sh:maxCount 1 ;
            sh:name "mimeType" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ref:documentMimeType ] ;
    sh:targetClass ref:DocumentReference .

ref:FindingShape a sh:NodeShape ;
    rdfs:comment "An observation or measurement made during the course of a service episode about the subject and their circumstances. May be recorded as a structured Observation, a quantitative Measurement, and/or free text." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A finding that cannot be represented as an Observation or Measurement." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:text ],
        [ sh:class ref:Observation ;
            sh:description "Qualitative observation(s) about the subject or their circumstances." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:observation ],
        [ sh:class ref:Measurement ;
            sh:description "Quantitative measurement(s) about the subject or their circumstances." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path ref:measurement ] ;
    sh:targetClass ref:Finding .

ref:IdentifierShape a sh:NodeShape ;
    rdfs:comment "A single identifier for a person or entity, comprising the value and the system in whose namespace the value is unique. Aligned with FHIR Identifier and the NHS PDS UNIQUE_REFERENCE definition." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The identifier value, unique within the issuing system." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:value ],
        [ sh:description "The URI of the system or namespace within which the identifier is unique (e.g. https://fhir.nhs.uk/Id/nhs-number)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path ref:system ] ;
    sh:targetClass ref:Identifier .

ref:LanguageShape a sh:NodeShape ;
    rdfs:comment "A specific language the person is proficient in, including proficiency level." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The level of proficiency or fluency in the language (e.g., 'fluent', 'native', 'basic')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:proficiencyLevel ],
        [ sh:datatype xsd:string ;
            sh:description "A code or name representing the language (e.g., 'en', 'eng', 'bsl', 'British Sign Language')." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:languageCode ] ;
    sh:targetClass ref:Language .

ref:LifeEventShape a sh:NodeShape ;
    rdfs:comment "A significant, time-bound occurrence in an individual's life that may have implications for their safety, wellbeing or development - for example attendance at A&E, a child being reported as missing, or an exclusion from school. Life events are not inherently positive or negative but can signal levels of risk, vulnerability or changing need." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Details about the location of the episode or life event." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path ref:location ],
        [ sh:class ref:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:description "Code(s) for the type of life event." ;
            sh:in ( <https://ns.socialcaredata.io/event-code#Birth> <https://ns.socialcaredata.io/event-code#Death> <https://ns.socialcaredata.io/event-code#AeAttendance> <https://ns.socialcaredata.io/event-code#SchoolExclusion> <https://ns.socialcaredata.io/event-code#SchoolSuspension> <https://ns.socialcaredata.io/event-code#MissingPerson> <https://ns.socialcaredata.io/event-code#SafeguardingConcern> <https://ns.socialcaredata.io/event-code#Referral> <https://ns.socialcaredata.io/event-code#ChildSafeguardingReferral> <https://ns.socialcaredata.io/event-code#ChildInfoRequestReferral> <https://ns.socialcaredata.io/event-code#ChildCrossServiceReferral> <https://ns.socialcaredata.io/event-code#AdultGeneralReferral> <https://ns.socialcaredata.io/event-code#AdultSafeguardingReferral> <https://ns.socialcaredata.io/event-code#AdultIndependentLivingReferral> <https://ns.socialcaredata.io/event-code#AdultCareActAssessmentReferral> <https://ns.socialcaredata.io/event-code#AdultInfoRequestReferral> <https://ns.socialcaredata.io/event-code#AdultCrossServiceReferral> <https://ns.socialcaredata.io/event-code#QualityOfCareConcern> <https://ns.socialcaredata.io/event-code#Homeless> ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 1 ;
            sh:path ref:eventType ],
        [ sh:class ref:Identifier ;
            sh:description "References (by Identifier) to Services associated with the entity." ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path ref:relatedService ],
        [ sh:class ref:Timing ;
            sh:description "Details about the timing of the episode or life event." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:timeInformation ],
        [ sh:class ref:SubjectPerson ;
            sh:description "References to the Person(s) the episode or life event concerns." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path ref:subjectPerson ],
        [ sh:class ref:LinkedRecord ;
            sh:description "Linked records associated with this episode or life event (e.g. referrals, requests, concerns, assessments, plans)." ;
            sh:name "linkedRecord" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path ref:linkedRecord ],
        [ sh:class ref:RelatedProfessional ;
            sh:description "References to the Professional(s) involved, qualified by involvement." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path ref:relatedProfessional ] ;
    sh:targetClass ref:LifeEvent .

ref:LinkedRecordShape a sh:NodeShape ;
    rdfs:comment "A reference to an associated external or cross-standard record (such as a referral, service request, quality-of-care concern, care needs assessment, or care plan)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The nature of the relationship (e.g. trigger, outcome, context)." ;
            sh:in ( rr:EscalationOf rr:DeescalationOf rr:FollowupTo rr:ReactivationOf rr:ConcurrentWith ) ;
            sh:maxCount 1 ;
            sh:name "recordRelationship" ;
            sh:order 2 ;
            sh:path ref:recordRelationship ],
        [ sh:description "The type of the linked record." ;
            sh:in ( <https://ns.socialcaredata.io/record-type#Referral> <https://ns.socialcaredata.io/record-type#Request> <https://ns.socialcaredata.io/record-type#QualityOfCareConcern> <https://ns.socialcaredata.io/record-type#Assessment> <https://ns.socialcaredata.io/record-type#Plan> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "recordType" ;
            sh:order 1 ;
            sh:path ref:recordType ],
        [ sh:class ref:Identifier ;
            sh:description "The unique identifier of the linked record." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "recordId" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:recordId ] ;
    sh:targetClass ref:LinkedRecord .

ref:MeasurementShape a sh:NodeShape ;
    rdfs:comment "A quantitative measurement of something related to the subject or their circumstances (for example \"Authorised Absences\" or \"Referrals\")." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "A decimal number representing the value of the measurement." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "value" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:measurementValue ],
        [ sh:description "The unit of measurement." ;
            sh:in ( <https://ns.socialcaredata.io/measurement-unit#Count> <https://ns.socialcaredata.io/measurement-unit#Pct> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "unit" ;
            sh:order 1 ;
            sh:path ref:unit ],
        [ sh:description "The type of measurement." ;
            sh:in ( <https://ns.socialcaredata.io/measurement-type#Attendance> <https://ns.socialcaredata.io/measurement-type#AuthorisedAbsences> <https://ns.socialcaredata.io/measurement-type#UnauthorisedAbsences> <https://ns.socialcaredata.io/measurement-type#CaringHoursPerWeek> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 2 ;
            sh:path ref:measurementType ] ;
    sh:targetClass ref:Measurement .

ref:NameShape a sh:NodeShape ;
    rdfs:comment "Container for a person's name parts, aligned with FHIR HumanName. A person may have multiple names with different uses." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Any preferred given or middle name used by the person - for example, \"Joe\" where their legal first name is \"Joseph\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:preferredName ],
        [ sh:datatype xsd:string ;
            sh:description "The first name and any middle names." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:givenName ],
        [ sh:description "The purpose of this name instance - usual, official, former, etc." ;
            sh:in ( <https://ns.socialcaredata.io/name-use-code#Usual> <https://ns.socialcaredata.io/name-use-code#Official> <https://ns.socialcaredata.io/name-use-code#Temp> <https://ns.socialcaredata.io/name-use-code#Nickname> <https://ns.socialcaredata.io/name-use-code#Anonymous> <https://ns.socialcaredata.io/name-use-code#Old> <https://ns.socialcaredata.io/name-use-code#Maiden> ) ;
            sh:maxCount 1 ;
            sh:name "use" ;
            sh:order 3 ;
            sh:path ref:use ],
        [ sh:datatype xsd:string ;
            sh:description "The surname or family name. Multi-valued to support compound or hyphenated family names recorded as separate parts." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:familyName ] ;
    sh:targetClass ref:Name .

ref:ObservationShape a sh:NodeShape ;
    rdfs:comment "A qualitative observation that represents an attribute of the subject or their circumstances (for example \"NEET\" or \"free-school-meals\")." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The type of observation, drawn from the Observation Type Vocabulary (e.g. NEET, free-school-meals, SEND.SpLD). The vocabulary is extensible (some codes carry dynamic sub-parts such as EAL.<ISO 639-1 code>), so it is modelled as an open string rather than a closed enumeration. See the ObservationType enum for the reference list of codes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:observationType ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date at which this observation was made false (if now outdated)." ;
            sh:maxCount 1 ;
            sh:name "endDate" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:endDate ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The date at which this observation was first true, as an ISO 8601 date-time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "startDate" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:startDate ] ;
    sh:targetClass ref:Observation .

ref:OrganisationShape a sh:NodeShape ;
    rdfs:comment "An organisation involved in the safeguarding or wellbeing of a person - for example a local authority, an NHS trust, a school, or an education authority. Aligns with the FHIR Organization resource." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Other names the entity is known by." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:alias ],
        [ sh:datatype xsd:boolean ;
            sh:description "Code for the entity's status - whether it is currently active." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path ref:active ],
        [ sh:class ref:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:class ref:Address ;
            sh:description "Physical location(s) of the entity." ;
            sh:name "address" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:address ],
        [ sh:class ref:Identifier ;
            sh:description "References (by Identifier) to Professionals associated with the entity." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path ref:relatedProfessional ],
        [ sh:description "Code(s) for the kind of organisation." ;
            sh:in ( <https://ns.socialcaredata.io/organisation-code#LocalAuthority> <https://ns.socialcaredata.io/organisation-code#NhsTrust> <https://ns.socialcaredata.io/organisation-code#PoliceForce> ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 3 ;
            sh:path ref:organisationType ],
        [ sh:class ref:Contact ;
            sh:description "Contact information for the organisation." ;
            sh:minCount 1 ;
            sh:name "contact" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path ref:contact ],
        [ sh:datatype xsd:string ;
            sh:description "The official name of the organisation or service." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:entityName ],
        [ sh:class ref:Identifier ;
            sh:description "References to Services the organisation provides or contributes to." ;
            sh:minCount 1 ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path ref:relatedService ] ;
    sh:targetClass ref:Organisation .

ref:PartialDateShape a sh:NodeShape ;
    rdfs:comment "Container for a date that may not be fully known or precise, extended with an accuracy indicator. Used for dates of birth and dates of death." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "ISO 8601-formatted date (YYYY-MM-DD)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:date ],
        [ sh:datatype xsd:string ;
            sh:description "A three-character code in day-month-year order indicating which parts of the date are accurate (A), estimated (E), or unknown (U)." ;
            sh:maxCount 1 ;
            sh:message "Use three letters, each one A, E or U - for example `AEU`."^^xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:accuracyIndicator ;
            sh:pattern "^[AEU]{3}$" ] ;
    sh:targetClass ref:PartialDate .

ref:PersonRelationshipShape a sh:NodeShape ;
    rdfs:comment "A typed reference from one person to another. The reference is by Identifier (so the related person may live in a different system) and is qualified by one or more relationship codes." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class ref:Identifier ;
            sh:description "Reference to the related person's Identifier (system + value)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:description "One or more codes describing the kind of relationship." ;
            sh:in ( <https://ns.socialcaredata.io/person-relationship-code#FAMMEMB> <https://ns.socialcaredata.io/person-relationship-code#CHILD> <https://ns.socialcaredata.io/person-relationship-code#NCHILD> <https://ns.socialcaredata.io/person-relationship-code#CHLDADOPT> <https://ns.socialcaredata.io/person-relationship-code#DAUADOPT> <https://ns.socialcaredata.io/person-relationship-code#SONADOPT> <https://ns.socialcaredata.io/person-relationship-code#CHLDFOST> <https://ns.socialcaredata.io/person-relationship-code#DAUFOST> <https://ns.socialcaredata.io/person-relationship-code#SONFOST> <https://ns.socialcaredata.io/person-relationship-code#DAUC> <https://ns.socialcaredata.io/person-relationship-code#DAU> <https://ns.socialcaredata.io/person-relationship-code#STPDAU> <https://ns.socialcaredata.io/person-relationship-code#SON> <https://ns.socialcaredata.io/person-relationship-code#SONC> <https://ns.socialcaredata.io/person-relationship-code#STPSON> <https://ns.socialcaredata.io/person-relationship-code#STPCHLD> <https://ns.socialcaredata.io/person-relationship-code#EXT> <https://ns.socialcaredata.io/person-relationship-code#AUNT> <https://ns.socialcaredata.io/person-relationship-code#MAUNT> <https://ns.socialcaredata.io/person-relationship-code#PAUNT> <https://ns.socialcaredata.io/person-relationship-code#UNCLE> <https://ns.socialcaredata.io/person-relationship-code#MUNCLE> <https://ns.socialcaredata.io/person-relationship-code#PUNCLE> <https://ns.socialcaredata.io/person-relationship-code#COUSN> <https://ns.socialcaredata.io/person-relationship-code#MCOUSN> <https://ns.socialcaredata.io/person-relationship-code#PCOUSN> <https://ns.socialcaredata.io/person-relationship-code#NIENEPH> <https://ns.socialcaredata.io/person-relationship-code#NEPHEW> <https://ns.socialcaredata.io/person-relationship-code#NIECE> <https://ns.socialcaredata.io/person-relationship-code#GGRPRN> <https://ns.socialcaredata.io/person-relationship-code#GGRFTH> <https://ns.socialcaredata.io/person-relationship-code#MGGRFTH> <https://ns.socialcaredata.io/person-relationship-code#PGGRFTH> <https://ns.socialcaredata.io/person-relationship-code#GGRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGGRMTH> <https://ns.socialcaredata.io/person-relationship-code#PGGRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGGRPRN> <https://ns.socialcaredata.io/person-relationship-code#PGGRPRN> <https://ns.socialcaredata.io/person-relationship-code#GRPRN> <https://ns.socialcaredata.io/person-relationship-code#GRFTH> <https://ns.socialcaredata.io/person-relationship-code#MGRFTH> <https://ns.socialcaredata.io/person-relationship-code#PGRFTH> <https://ns.socialcaredata.io/person-relationship-code#GRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGRMTH> <https://ns.socialcaredata.io/person-relationship-code#PGRMTH> <https://ns.socialcaredata.io/person-relationship-code#MGRPRN> <https://ns.socialcaredata.io/person-relationship-code#PGRPRN> <https://ns.socialcaredata.io/person-relationship-code#GRNDCHILD> <https://ns.socialcaredata.io/person-relationship-code#GRNDDAU> <https://ns.socialcaredata.io/person-relationship-code#GRNDSON> <https://ns.socialcaredata.io/person-relationship-code#INLAW> <https://ns.socialcaredata.io/person-relationship-code#CHLDINLAW> <https://ns.socialcaredata.io/person-relationship-code#DAUINLAW> <https://ns.socialcaredata.io/person-relationship-code#SONINLAW> <https://ns.socialcaredata.io/person-relationship-code#PRNINLAW> <https://ns.socialcaredata.io/person-relationship-code#FTHINLAW> <https://ns.socialcaredata.io/person-relationship-code#MTHINLAW> <https://ns.socialcaredata.io/person-relationship-code#SIBINLAW> <https://ns.socialcaredata.io/person-relationship-code#BROINLAW> <https://ns.socialcaredata.io/person-relationship-code#SISINLAW> <https://ns.socialcaredata.io/person-relationship-code#PRN> <https://ns.socialcaredata.io/person-relationship-code#NPRN> <https://ns.socialcaredata.io/person-relationship-code#ADOPTP> <https://ns.socialcaredata.io/person-relationship-code#ADOPTF> <https://ns.socialcaredata.io/person-relationship-code#ADOPTM> <https://ns.socialcaredata.io/person-relationship-code#PRNFOST> <https://ns.socialcaredata.io/person-relationship-code#STPPRN> <https://ns.socialcaredata.io/person-relationship-code#FTH> <https://ns.socialcaredata.io/person-relationship-code#NFTH> <https://ns.socialcaredata.io/person-relationship-code#FTHFOST> <https://ns.socialcaredata.io/person-relationship-code#STPFTH> <https://ns.socialcaredata.io/person-relationship-code#MTH> <https://ns.socialcaredata.io/person-relationship-code#NMTH> <https://ns.socialcaredata.io/person-relationship-code#GESTM> <https://ns.socialcaredata.io/person-relationship-code#MTHFOST> <https://ns.socialcaredata.io/person-relationship-code#STPMTH> <https://ns.socialcaredata.io/person-relationship-code#SIB> <https://ns.socialcaredata.io/person-relationship-code#NSIB> <https://ns.socialcaredata.io/person-relationship-code#HSIB> <https://ns.socialcaredata.io/person-relationship-code#STPSIB> <https://ns.socialcaredata.io/person-relationship-code#BRO> <https://ns.socialcaredata.io/person-relationship-code#NBRO> <https://ns.socialcaredata.io/person-relationship-code#HBRO> <https://ns.socialcaredata.io/person-relationship-code#STPBRO> <https://ns.socialcaredata.io/person-relationship-code#SIS> <https://ns.socialcaredata.io/person-relationship-code#NSIS> <https://ns.socialcaredata.io/person-relationship-code#HSIS> <https://ns.socialcaredata.io/person-relationship-code#STPSIS> <https://ns.socialcaredata.io/person-relationship-code#TWIN> <https://ns.socialcaredata.io/person-relationship-code#TWINBRO> <https://ns.socialcaredata.io/person-relationship-code#TWINSIS> <https://ns.socialcaredata.io/person-relationship-code#ITWIN> <https://ns.socialcaredata.io/person-relationship-code#ITWINBRO> <https://ns.socialcaredata.io/person-relationship-code#ITWINSIS> <https://ns.socialcaredata.io/person-relationship-code#FTWIN> <https:/