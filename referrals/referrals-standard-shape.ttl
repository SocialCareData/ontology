ref:RelatedProfessionalShape a sh:NodeShape ;
    rdfs:comment "A typed reference to a Professional involved in a service episode or life event." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class ref:Identifier ;
            sh:description "A reference (by Identifier) to a Professional record involved in the episode or life event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:professional ],
        [ sh:datatype xsd:string ;
            sh:description "Code for the nature of the involvement. Uses an [HL7 v3 ParticipationType code](https://terminology.hl7.org/5.2.0/CodeSystem-v3-ParticipationType.html) directly (e.g. SBJ, PPRF); not defined by this standard, so modelled as an open string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:involvement ] ;
    sh:targetClass ref:RelatedProfessional .

ref:RequestShape a sh:NodeShape ;
    rdfs:comment "Outward request for services for an existing subject of care." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "What is the request?" ;
            sh:in ( rp:Notification rp:ChildEarlyHelp rp:ChildCIN rp:ChildS47 rp:ChildEmergency rp:ChildStatutoryServices rp:ChildNonStatutoryServices rp:AdultStatutoryServices rp:AdultNonStatutoryServices ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "purpose" ;
            sh:order 4 ;
            sh:path ref:purpose ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date completed." ;
            sh:maxCount 1 ;
            sh:name "dateCompleted" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path ref:dateCompleted ],
        [ sh:class ref:Identifier ;
            sh:description "Identifier for this referral, request, or concern." ;
            sh:maxCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:class ref:DocumentReference ;
            sh:description "Attachments and reference to documents." ;
            sh:name "attachment" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path ref:attachment ],
        [ sh:class ref:Identifier ;
            sh:description "What service is requested? (Organisation / Service identifier)." ;
            sh:minCount 1 ;
            sh:name "recipient" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path ref:requestRecipient ],
        [ sh:class ref:Identifier ;
            sh:description "Who is the referrer? (Identifier object)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "referrer" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path ref:requestReferrer ],
        [ sh:class ref:ReferralAssessmentQuestion ;
            sh:description "Atypical, locally configured questions." ;
            sh:name "assessmentQuestion" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:referralAssessmentQuestion ],
        [ sh:class ref:Identifier ;
            sh:description "Who is the person? (Person identifier)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "subject" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path ref:requestSubject ],
        [ sh:class ref:LinkedRecord ;
            sh:description "Linked records associated with this episode or life event (e.g. referrals, requests, concerns, assessments, plans)." ;
            sh:name "linkedRecord" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path ref:linkedRecord ] ;
    sh:targetClass ref:Request .

ref:ServiceEpisodeShape a sh:NodeShape ;
    rdfs:comment "A bounded period during which an individual receives a defined service, intervention, or package of support from a service or professional. It has a recognisable start and end point, though duration may vary from a single contact to sustained involvement over time." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class ref:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Details about the location of the episode." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path ref:location ],
        [ sh:description "Code(s) for the type of service episode." ;
            sh:in ( <https://ns.socialcaredata.io/episode-code#Assessment> <https://ns.socialcaredata.io/episode-code#EarlyHelp> <https://ns.socialcaredata.io/episode-code#Section47> <https://ns.socialcaredata.io/episode-code#AdultSafeguarding> <https://ns.socialcaredata.io/episode-code#CareActAssessment> <https://ns.socialcaredata.io/episode-code#OtherAssessment> <https://ns.socialcaredata.io/episode-code#MashReview> <https://ns.socialcaredata.io/episode-code#ReferralReview> <https://ns.socialcaredata.io/episode-code#Plan> <https://ns.socialcaredata.io/episode-code#Ehcp> <https://ns.socialcaredata.io/episode-code#FamilyCourtOrder> <https://ns.socialcaredata.io/episode-code#CinPlan> <https://ns.socialcaredata.io/episode-code#CpPlan> <https://ns.socialcaredata.io/episode-code#CamhsPlan> <https://ns.socialcaredata.io/episode-code#ChildLookedAfter> <https://ns.socialcaredata.io/episode-code#CarePlan> <https://ns.socialcaredata.io/episode-code#OtherPlan> <https://ns.socialcaredata.io/episode-code#Provision> <https://ns.socialcaredata.io/episode-code#FaceToFaceContact> <https://ns.socialcaredata.io/episode-code#RemoteContact> <https://ns.socialcaredata.io/episode-code#DirectProvision> <https://ns.socialcaredata.io/episode-code#IndirectProvision> <https://ns.socialcaredata.io/episode-code#Admin> <https://ns.socialcaredata.io/episode-code#Miscellaneous> <https://ns.socialcaredata.io/episode-code#Request> <https://ns.socialcaredata.io/episode-code#Notification> <https://ns.socialcaredata.io/episode-code#ChildEarlyHelp> <https://ns.socialcaredata.io/episode-code#ChildCin> <https://ns.socialcaredata.io/episode-code#ChildS47> <https://ns.socialcaredata.io/episode-code#ChildEmergency> <https://ns.socialcaredata.io/episode-code#ChildStatutoryServices> <https://ns.socialcaredata.io/episode-code#ChildNonStatutoryServices> <https://ns.socialcaredata.io/episode-code#AdultStatutoryServices> <https://ns.socialcaredata.io/episode-code#AdultNonStatutoryServices> ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 1 ;
            sh:path ref:episodeType ],
        [ sh:description "Outcome of the episode for the subject." ;
            sh:in ( <https://ns.socialcaredata.io/episode-outcome#Reablement> <https://ns.socialcaredata.io/episode-outcome#Assessment> <https://ns.socialcaredata.io/episode-outcome#Hospital> <https://ns.socialcaredata.io/episode-outcome#Continuation> <https://ns.socialcaredata.io/episode-outcome#Planning> <https://ns.socialcaredata.io/episode-outcome#NfaPlanned> <https://ns.socialcaredata.io/episode-outcome#NfaMoved> <https://ns.socialcaredata.io/episode-outcome#NfaNhsReferral> <https://ns.socialcaredata.io/episode-outcome#NfaDisregard> <https://ns.socialcaredata.io/episode-outcome#NfaLocalReferral> <https://ns.socialcaredata.io/episode-outcome#NfaDeclined> <https://ns.socialcaredata.io/episode-outcome#NfaInfo> <https://ns.socialcaredata.io/episode-outcome#NfaDeceased> <https://ns.socialcaredata.io/episode-outcome#NfaNoOfferOther> <https://ns.socialcaredata.io/episode-outcome#NfaEndedOther> <https://ns.socialcaredata.io/episode-outcome#NfaOther> <https://ns.socialcaredata.io/episode-outcome#Referral> <https://ns.socialcaredata.io/episode-outcome#Request> <https://ns.socialcaredata.io/episode-outcome#QualityOfCareConcern> ) ;
            sh:maxCount 1 ;
            sh:name "outcome" ;
            sh:order 8 ;
            sh:path ref:episodeOutcome ],
        [ sh:class ref:Finding ;
            sh:description "Observations or measurements made during the course of the episode." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path ref:finding ],
        [ sh:class ref:Timing ;
            sh:description "Details about the timing of the episode." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:timeInformation ],
        [ sh:class ref:SubjectPerson ;
            sh:description "References to the Person(s) the episode or life event concerns." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path ref:subjectPerson ],
        [ sh:class ref:Identifier ;
            sh:description "References to the Services involved in the episode." ;
            sh:minCount 1 ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path ref:relatedService ],
        [ sh:class ref:LinkedRecord ;
            sh:description "Linked records associated with this episode or life event (e.g. referrals, requests, concerns, assessments, plans)." ;
            sh:name "linkedRecord" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path ref:linkedRecord ],
        [ sh:class ref:RelatedProfessional ;
            sh:description "References to the Professional(s) involved, qualified by involvement." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path ref:relatedProfessional ] ;
    sh:targetClass ref:ServiceEpisode .

ref:ServiceShape a sh:NodeShape ;
    rdfs:comment "A service involved in the safeguarding or wellbeing of a person - the specific intervention or package of support delivered by one or more organisations (e.g. local authority social care, an emergency department, a general practice, or a school)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Other names the entity is known by." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:alias ],
        [ sh:description "The way the service is delivered." ;
            sh:in ( <https://ns.socialcaredata.io/service-delivery#StMax> <https://ns.socialcaredata.io/service-delivery#OngoingLow> <https://ns.socialcaredata.io/service-delivery#OtherShortTerm> <https://ns.socialcaredata.io/service-delivery#Nursing> <https://ns.socialcaredata.io/service-delivery#Residential> <https://ns.socialcaredata.io/service-delivery#Community> <https://ns.socialcaredata.io/service-delivery#Prison> <https://ns.socialcaredata.io/service-delivery#UnpaidCarerDirect> <https://ns.socialcaredata.io/service-delivery#UnpaidCarerSupport> ) ;
            sh:order 8 ;
            sh:path ref:delivery ],
        [ sh:datatype xsd:boolean ;
            sh:description "Code for the entity's status - whether it is currently active." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path ref:active ],
        [ sh:description "Code(s) for the kind of service." ;
            sh:in ( svc:YouthOffending svc:PrimarySchool svc:HighSchool svc:SenPrimarySchool svc:SenHighSchool svc:AlternativeProvisionSchool svc:SocialCare svc:FamilyCourt svc:Camhs svc:Reablement svc:ShortTermNursingCare svc:ShortTermResidentialCare svc:LongTermNursingCare svc:LongTermResidentialCare svc:HomeSupportDomiciliary svc:DaySupport svc:Meals svc:Transport svc:Equipment svc:DirectPayment svc:SharedLives svc:CommunitySupportedLiving svc:ExtraCareHousing svc:SocialWorkerSupport svc:OtherProfessionalSupport svc:LearningEducationEmployment svc:EndOfLifeCare svc:EmergencySupport svc:OtherShortTermSupport svc:OtherLongTermSupport svc:CarerRespite svc:CarerSittingService svc:CarerUniversalServices svc:OtherCarerSupport svc:MASH svc:EarlyHelp svc:EducationWelfare svc:HomeAdaptations svc:OccupationalTherapy svc:CHC svc:CMHT svc:S117Aftercare svc:DoLS svc:D2A svc:SensoryTeam svc:Advocacy svc:LGA ) ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 3 ;
            sh:path ref:serviceType ],
        [ sh:class ref:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:class ref:Address ;
            sh:description "Physical location(s) of the entity." ;
            sh:name "address" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:address ],
        [ sh:description "The frequency at which the unit cost occurs." ;
            sh:in ( <https://ns.socialcaredata.io/service-cost-frequency#None> <https://ns.socialcaredata.io/service-cost-frequency#PerSession> <https://ns.socialcaredata.io/service-cost-frequency#Hourly> <https://ns.socialcaredata.io/service-cost-frequency#Daily> <https://ns.socialcaredata.io/service-cost-frequency#Weekly> <https://ns.socialcaredata.io/service-cost-frequency#Fortnightly> <https://ns.socialcaredata.io/service-cost-frequency#FourWeekly> <https://ns.socialcaredata.io/service-cost-frequency#Monthly> <https://ns.socialcaredata.io/service-cost-frequency#Quarterly> <https://ns.socialcaredata.io/service-cost-frequency#Annually> <https://ns.socialcaredata.io/service-cost-frequency#OneOff> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path ref:costFrequency ],
        [ sh:class ref:Contact ;
            sh:description "Contact information for the service." ;
            sh:minCount 1 ;
            sh:name "contact" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path ref:contact ],
        [ sh:class ref:Identifier ;
            sh:description "References (by Identifier) to Organisations associated with the entity." ;
            sh:name "relatedOrganisation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path ref:relatedOrganisation ],
        [ sh:datatype xsd:string ;
            sh:description "The official name of the organisation or service." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:entityName ],
        [ sh:class ref:Identifier ;
            sh:description "References (by Identifier) to Professionals associated with the entity." ;
            sh:name "relatedProfessional" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path ref:relatedProfessional ] ;
    sh:targetClass ref:Service .

ref:SubjectPersonShape a sh:NodeShape ;
    rdfs:comment "A typed reference to a Person involved in a service episode or life event." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Code for the nature of the involvement. Uses an [HL7 v3 ParticipationType code](https://terminology.hl7.org/5.2.0/CodeSystem-v3-ParticipationType.html) directly (e.g. SBJ, PPRF); not defined by this standard, so modelled as an open string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:involvement ],
        [ sh:class ref:Identifier ;
            sh:description "A reference (by Identifier) to a Person record involved in the episode or life event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:person ] ;
    sh:targetClass ref:SubjectPerson .

ref:TimingShape a sh:NodeShape ;
    rdfs:comment "The schedule and timing information of an activity, episode or event: when it started and ended and how frequently it recurs." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "How frequently the activity, episode or event recurs, expressed as a [FHIR Timing](https://build.fhir.org/datatypes.html#Timing) datatype. This model does not define or validate its structure; the value is an arbitrary JSON object conforming to FHIR Timing." ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path ref:frequency ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The end of the activity, episode or event (or the last date it was performed), as an ISO 8601 date-time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:endDateTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The start of the activity, episode or event (or the first date it was scheduled to be performed), as an ISO 8601 date-time." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ref:startDateTime ] ;
    sh:targetClass ref:Timing .

linkml:AnyShape a sh:NodeShape ;
    rdfs:comment "An open value whose structure is defined and validated elsewhere, not by this model. Serialised as an arbitrary JSON object." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

