ref:ProfessionalShape a sh:NodeShape ;
    rdfs:comment "An individual acting in a formal role within an organisation who has responsibilities relating to a person's safety, wellbeing, care or support - for example undertaking assessments, creating and monitoring plans, or sharing information in a multi-agency context." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class ref:Identifier ;
            sh:description "Unique identifiers associated with the entity." ;
            sh:minCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Text describing the professional's occupational role." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:role ],
        [ sh:class ref:Contact ;
            sh:description "The professional's contact information (exactly one)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "contact" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path ref:contact ],
        [ sh:datatype xsd:boolean ;
            sh:description "The professional's current working status." ;
            sh:maxCount 1 ;
            sh:name "status" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ref:workingStatus ],
        [ sh:class ref:Identifier ;
            sh:description "References (by Identifier) to Services associated with the entity." ;
            sh:name "relatedService" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:relatedService ],
        [ sh:class ref:Identifier ;
            sh:description "References (by Identifier) to Organisations associated with the entity." ;
            sh:name "relatedOrganisation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path ref:relatedOrganisation ],
        [ sh:class ref:Name ;
            sh:description "The professional's name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path ref:name ] ;
    sh:targetClass ref:Professional .

ref:QualityOfCareConcernShape a sh:NodeShape ;
    rdfs:comment "Quality-of-care concern raised about a care provider or service." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Date completed." ;
            sh:maxCount 1 ;
            sh:name "dateCompleted" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path ref:dateCompleted ],
        [ sh:class ref:Identifier ;
            sh:description "Identifier for this referral, request, or concern." ;
            sh:maxCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:class ref:DocumentReference ;
            sh:description "Attachments and reference to documents." ;
            sh:name "attachment" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path ref:attachment ],
        [ sh:class ref:Person ;
            sh:description "Who is the person? (Optional for anonymisation)." ;
            sh:name "subject" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path ref:qocSubject ],
        [ sh:class ref:ReferrerDetails ;
            sh:description "Who is the referrer? (Optional for anonymisation)." ;
            sh:maxCount 1 ;
            sh:name "referrer" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path ref:qocReferrer ],
        [ sh:class ref:ReferralAssessmentQuestion ;
            sh:description "Atypical, locally configured questions." ;
            sh:name "assessmentQuestion" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:referralAssessmentQuestion ],
        [ sh:class ref:Identifier ;
            sh:description "What service is involved? (Organisation / Service identifier)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "recipient" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path ref:qocRecipient ],
        [ sh:class ref:ConcernDetail ;
            sh:description "What is the concern?" ;
            sh:minCount 1 ;
            sh:name "concern" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path ref:concern ],
        [ sh:class ref:LinkedRecord ;
            sh:description "Linked records associated with this episode or life event (e.g. referrals, requests, concerns, assessments, plans)." ;
            sh:name "linkedRecord" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path ref:linkedRecord ] ;
    sh:targetClass ref:QualityOfCareConcern .

ref:ReferralAssessmentQuestionShape a sh:NodeShape ;
    rdfs:comment "A generic Question-and-Answer model used to represent atypical, locally configured questions." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether this question was mandatory on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path ref:required ],
        [ sh:datatype xsd:string ;
            sh:description "An ID for the question. Standards may define a dictionary of IDs for statutory or well-known questions; for personalised, local questions, this can be anything or left blank." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path ref:questionId ],
        [ sh:datatype xsd:string ;
            sh:description "The exact wording of the question as it appears on the form." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:questionText ],
        [ sh:description "The domain of the question." ;
            sh:in ( rqc:ReferralTypeRouting rqc:ReferrerDetails rqc:SubjectConsentCapacity rqc:SubjectDemographics rqc:SubjectAssessedStatus rqc:Concern rqc:RiskHarmSafety rqc:FamilyNetwork rqc:ImpactDailyLife rqc:SubjectVoiceWishes rqc:SubjectServicesNetwork rqc:StrengthsPositives rqc:ActionsTaken rqc:RequestedService rqc:CommunicationAccessibility rqc:Attachments rqc:SubmissionWorkflow ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path ref:category ],
        [ sh:description "Indicates how the answer should be parsed (e.g., String, Boolean, Date, Number, Enum). Ensures data like dates or booleans aren't trapped as unparsable text." ;
            sh:in ( <https://ns.socialcaredata.io/answer-type#String> <https://ns.socialcaredata.io/answer-type#Boolean> <https://ns.socialcaredata.io/answer-type#Date> <https://ns.socialcaredata.io/answer-type#Number> <https://ns.socialcaredata.io/answer-type#Enum> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path ref:answerType ],
        [ sh:datatype xsd:string ;
            sh:description "The answer to the question." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ref:answer ] ;
    sh:targetClass ref:ReferralAssessmentQuestion .

ref:ReferralInvolvementShape a sh:NodeShape ;
    rdfs:comment "Actions taken so far and parties involved." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class ref:Identifier ;
            sh:description "Identifier(s) of the professional or actor involved." ;
            sh:name "actorId" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path ref:involvementActorId ],
        [ sh:datatype xsd:string ;
            sh:description "Free text description of involvement." ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ref:involvementDescription ],
        [ sh:description "Category of the actor involved (e.g. Self, Professional)." ;
            sh:in ( rft:Self rft:FamilyMember rft:Professional rft:MemberOfThePublic ) ;
            sh:maxCount 1 ;
            sh:name "actorType" ;
            sh:order 0 ;
            sh:path ref:involvementActorType ] ;
    sh:targetClass ref:ReferralInvolvement .

ref:ReferralShape a sh:NodeShape ;
    rdfs:comment "Inward, person-centric, point-of-entry referral into social services." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Date completed." ;
            sh:maxCount 1 ;
            sh:name "dateCompleted" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path ref:dateCompleted ],
        [ sh:description "What kind of support pathway do you think this referral should initiate?" ;
            sh:in ( svc:YouthOffending svc:PrimarySchool svc:HighSchool svc:SenPrimarySchool svc:SenHighSchool svc:AlternativeProvisionSchool svc:SocialCare svc:FamilyCourt svc:Camhs svc:Reablement svc:ShortTermNursingCare svc:ShortTermResidentialCare svc:LongTermNursingCare svc:LongTermResidentialCare svc:HomeSupportDomiciliary svc:DaySupport svc:Meals svc:Transport svc:Equipment svc:DirectPayment svc:SharedLives svc:CommunitySupportedLiving svc:ExtraCareHousing svc:SocialWorkerSupport svc:OtherProfessionalSupport svc:LearningEducationEmployment svc:EndOfLifeCare svc:EmergencySupport svc:OtherShortTermSupport svc:OtherLongTermSupport svc:CarerRespite svc:CarerSittingService svc:CarerUniversalServices svc:OtherCarerSupport svc:MASH svc:EarlyHelp svc:EducationWelfare svc:HomeAdaptations svc:OccupationalTherapy svc:CHC svc:CMHT svc:S117Aftercare svc:DoLS svc:D2A svc:SensoryTeam svc:Advocacy svc:LGA ) ;
            sh:name "pathway" ;
            sh:order 7 ;
            sh:path ref:pathway ],
        [ sh:class ref:DocumentReference ;
            sh:description "Attachments and reference to documents." ;
            sh:name "attachment" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path ref:attachment ],
        [ sh:description "Type of referral." ;
            sh:in ( rt:ChildSafeguarding rt:ChildInfoRequest rt:ChildCrossService rt:AdultGeneral rt:AdultSafeguarding rt:AdultIndependentLiving rt:AdultCareActAssessment rt:AdultInfoRequest rt:AdultCrossService ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:order 1 ;
            sh:path ref:type ],
        [ sh:class ref:Identifier ;
            sh:description "Identifier for this referral, request, or concern." ;
            sh:maxCount 1 ;
            sh:name "identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ref:identifier ],
        [ sh:class ref:PersonalNetworkMember ;
            sh:description "Who is in the person's family, household, or personal network?" ;
            sh:name "personalNetwork" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path ref:personalNetwork ],
        [ sh:class ref:Person ;
            sh:description "Who is the person?" ;
            sh:minCount 1 ;
            sh:name "subject" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path ref:subject ],
        [ sh:class ref:ReferralAssessmentQuestion ;
            sh:description "Atypical, locally configured questions." ;
            sh:name "assessmentQuestion" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path ref:referralAssessmentQuestion ],
        [ sh:class ref:ReferrerDetails ;
            sh:description "Who is the referrer?" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "referrer" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path ref:referrer ],
        [ sh:class ref:Identifier ;
            sh:description "Who was this referral sent to?" ;
            sh:minCount 1 ;
            sh:name "recipient" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path ref:recipient ],
        [ sh:class ref:LinkedRecord ;
            sh:description "Linked records associated with this episode or life event (e.g. referrals, requests, concerns, assessments, plans)." ;
            sh:name "linkedRecord" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path ref:linkedRecord ],
        [ sh:class ref:ReferralInvolvement ;
            sh:description "What have you or others done so far?" ;
            sh:maxCount 1 ;
            sh:name "involvement" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path ref:referralInvolvement ],
        [ sh:class ref:ConcernDetail ;
            sh:description "What is the concern?" ;
            sh:minCount 1 ;
            sh:name "concern" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path ref:concern ] ;
    sh:targetClass ref:Referral .

ref:ReferrerDetailsShape a sh:NodeShape ;
    rdfs:comment "Details of the referrer initiating the referral or concern." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
