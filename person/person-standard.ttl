prc:PCOUSN a owl:Class ;
    rdfs:label "PCOUSN" ;
    dct:title "Paternal cousin" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological relative via the scoping person's father's line." .

prc:PGGRFTH a owl:Class ;
    rdfs:label "PGGRFTH" ;
    dct:title "Paternal great-grandfather" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological father of the scoping person's paternal grandparent." .

prc:PGGRMTH a owl:Class ;
    rdfs:label "PGGRMTH" ;
    dct:title "Paternal great-grandmother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological mother of the scoping person's paternal grandparent." .

prc:PGGRPRN a owl:Class ;
    rdfs:label "PGGRPRN" ;
    dct:title "Paternal great-grandparent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological parent of the scoping person's paternal grandparent." .

prc:PGRFTH a owl:Class ;
    rdfs:label "PGRFTH" ;
    dct:title "Paternal grandfather" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological father of the scoping person's biological father." .

prc:PGRMTH a owl:Class ;
    rdfs:label "PGRMTH" ;
    dct:title "Paternal grandmother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological mother of the scoping person's biological father." .

prc:PGRPRN a owl:Class ;
    rdfs:label "PGRPRN" ;
    dct:title "Paternal grandparent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological parent of the scoping person's biological father." .

prc:PRN a owl:Class ;
    rdfs:label "PRN" ;
    dct:title "Parent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "One who begets, gives birth to, or raises the scoping person." .

prc:PRNFOST a owl:Class ;
    rdfs:label "PRNFOST" ;
    dct:title "Foster parent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A state-certified caregiver for the scoping person as a foster child." .

prc:PRNINLAW a owl:Class ;
    rdfs:label "PRNINLAW" ;
    dct:title "Parent-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A parent of the scoping person's spouse." .

prc:PUNCLE a owl:Class ;
    rdfs:label "PUNCLE" ;
    dct:title "Paternal uncle" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological brother of the scoping person's biological father." .

prc:ROOM a owl:Class ;
    rdfs:label "ROOM" ;
    dct:title "Roommate" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A person sharing living quarters." .

prc:SIB a owl:Class ;
    rdfs:label "SIB" ;
    dct:title "Sibling" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Shares one or both parents with the scoping person." .

prc:SIBINLAW a owl:Class ;
    rdfs:label "SIBINLAW" ;
    dct:title "Sibling-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "The spouse's sibling or the spouse of the scoping person's sibling." .

prc:SIGOTHR a owl:Class ;
    rdfs:label "SIGOTHR" ;
    dct:title "Significant other" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A person important to the scoping person's well-being (spouse or equivalent)." .

prc:SIS a owl:Class ;
    rdfs:label "SIS" ;
    dct:title "Sister" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Female sibling." .

prc:SISINLAW a owl:Class ;
    rdfs:label "SISINLAW" ;
    dct:title "Sister-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "The spouse's sister, or the wife of the scoping person's brother." .

prc:SON a owl:Class ;
    rdfs:label "SON" ;
    dct:title "Natural son" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male offspring of the scoping person." .

prc:SONADOPT a owl:Class ;
    rdfs:label "SONADOPT" ;
    dct:title "Adopted son" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A male child legally adopted and raised by the scoping person." .

prc:SONC a owl:Class ;
    rdfs:label "SONC" ;
    dct:title "Son" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A male child (of any type) of the scoping person." .

prc:SONFOST a owl:Class ;
    rdfs:label "SONFOST" ;
    dct:title "Foster son" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A male child receiving foster parental care." .

prc:SONINLAW a owl:Class ;
    rdfs:label "SONINLAW" ;
    dct:title "Son-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Husband of the scoping person's daughter." .

prc:SPS a owl:Class ;
    rdfs:label "SPS" ;
    dct:title "Spouse" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Marriage partner." .

prc:STPBRO a owl:Class ;
    rdfs:label "STPBRO" ;
    dct:title "Stepbrother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A son of the scoping person's stepparent." .

prc:STPCHLD a owl:Class ;
    rdfs:label "STPCHLD" ;
    dct:title "Stepchild" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A child of the scoping person's spouse by a previous union." .

prc:STPDAU a owl:Class ;
    rdfs:label "STPDAU" ;
    dct:title "Stepdaughter" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A daughter of the scoping person's spouse by a previous union." .

prc:STPFTH a owl:Class ;
    rdfs:label "STPFTH" ;
    dct:title "Stepfather" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Husband of the scoping person's mother, where he is not the biological father." .

prc:STPMTH a owl:Class ;
    rdfs:label "STPMTH" ;
    dct:title "Stepmother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Wife of the scoping person's father, where she is not the biological mother." .

prc:STPPRN a owl:Class ;
    rdfs:label "STPPRN" ;
    dct:title "Stepparent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Spouse of the scoping person's parent, where they are not the biological parent." .

prc:STPSIB a owl:Class ;
    rdfs:label "STPSIB" ;
    dct:title "Stepsibling" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A child of the scoping person's stepparent." .

prc:STPSIS a owl:Class ;
    rdfs:label "STPSIS" ;
    dct:title "Stepsister" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A daughter of the scoping person's stepparent." .

prc:STPSON a owl:Class ;
    rdfs:label "STPSON" ;
    dct:title "Stepson" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A son of the scoping person's spouse by a previous union." .

prc:TWIN a owl:Class ;
    rdfs:label "TWIN" ;
    dct:title "Twin" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A twin from the same womb or parental pairing as the scoping person." .

prc:TWINBRO a owl:Class ;
    rdfs:label "TWINBRO" ;
    dct:title "Twin brother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male twin." .

prc:TWINSIS a owl:Class ;
    rdfs:label "TWINSIS" ;
    dct:title "Twin sister" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Female twin." .

prc:UNCLE a owl:Class ;
    rdfs:label "UNCLE" ;
    dct:title "Uncle" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Brother of the scoping person's parent." .

prc:WIFE a owl:Class ;
    rdfs:label "WIFE" ;
    dct:title "Wife" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A woman joined in marriage." .

psc:Female a owl:Class ;
    rdfs:label "2" ;
    dct:title "Female" ;
    rdfs:subClassOf p:phenotypic-sex-code ;
    skos:definition "The person is phenotypically female." .

psc:Indeterminate a owl:Class ;
    rdfs:label "9" ;
    dct:title "Indeterminate" ;
    rdfs:subClassOf p:phenotypic-sex-code ;
    skos:definition "Unable to be classified phenotypically as either male or female." .

psc:Male a owl:Class ;
    rdfs:label "1" ;
    dct:title "Male" ;
    rdfs:subClassOf p:phenotypic-sex-code ;
    skos:definition "The person is phenotypically male." .

psc:NotKnown a owl:Class ;
    rdfs:label "X" ;
    dct:title "Not Known" ;
    rdfs:subClassOf p:phenotypic-sex-code ;
    skos:definition "Not recorded, or information unavailable." .

p:PartialDate a owl:Class ;
    rdfs:label "PartialDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
            owl:onProperty p:accuracyIndicator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:accuracyIndicator ] ;
    skos:definition "Container for a date that may not be fully known or precise, extended with an accuracy indicator. Used for dates of birth and dates of death." ;
    skos:exactMatch p:PartialDate ;
    skos:inScheme p:person .

p:gender-code a owl:Class ;
    rdfs:label "GenderCode" ;
    dct:title "Gender Code" ;
    owl:unionOf ( gc:Male gc:Female gc:Indeterminate gc:NotKnown ) ;
    skos:definition "A person's stated gender identity, as distinct from biological sex. Aligned with NHS PERSON_STATED_GENDER_CODE." ;
    skos:inScheme p:person ;
    linkml:permissible_values gc:Female,
        gc:Indeterminate,
        gc:Male,
        gc:NotKnown .

p:phenotypic-sex-code a owl:Class ;
    rdfs:label "PhenotypicSexCode" ;
    dct:title "Phenotypic Sex Code" ;
    owl:unionOf ( psc:Male psc:Female psc:Indeterminate psc:NotKnown ) ;
    skos:definition "Observed phenotypic sex where recorded, representing biological characteristics rather than gender identity. Aligned with NHS PDS PERSON_PHENOTYPIC_SEX." ;
    skos:inScheme p:person ;
    linkml:permissible_values psc:Female,
        psc:Indeterminate,
        psc:Male,
        psc:NotKnown .

p:ethnicity-code a owl:Class ;
    rdfs:label "EthnicityCode" ;
    dct:title "Ethnicity Code" ;
    owl:unionOf ( ec:AsianBangladeshi ec:AsianChinese ec:AsianIndian ec:AsianPakistani ec:AsianOther ec:BlackAfrican ec:BlackCaribbean ec:BlackOther ec:MixedWhiteAsian ec:MixedWhiteBlackAfrican ec:MixedWhiteBlackCaribbean ec:MixedOther ec:WhiteBritish ec:WhiteIrish ec:WhiteGypsyOrIrishTraveller ec:WhiteRoma ec:WhiteOther ec:OtherArab ec:OtherAny ec:DoesNotApply ) ;
    skos:definition "The person's stated ethnicity. Uses ONS Census 2021 Ethnic group classification 20b codes." ;
    skos:inScheme p:person ;
    linkml:permissible_values ec:AsianBangladeshi,
        ec:AsianChinese,
        ec:AsianIndian,
        ec:AsianOther,
        ec:AsianPakistani,
        ec:BlackAfrican,
        ec:BlackCaribbean,
        ec:BlackOther,
        ec:DoesNotApply,
        ec:MixedOther,
        ec:MixedWhiteAsian,
        ec:MixedWhiteBlackAfrican,
        ec:MixedWhiteBlackCaribbean,
        ec:OtherAny,
        ec:OtherArab,
        ec:WhiteBritish,
        ec:WhiteGypsyOrIrishTraveller,
        ec:WhiteIrish,
        ec:WhiteOther,
        ec:WhiteRoma .

p:person a owl:Ontology ;
    rdfs:label "person" ;
    dct:license "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" ;
    dct:title "Person Standard Data Model" ;
    pav:version "1.0.0" ;
    owl:imports p:common ;
    skos:definition """A single LinkML data model for the Person Standard: a common data model for identifying and describing a person across social care systems, designed to unblock multi-agency information sharing (MAIS) and Single View use cases.
This schema is the authoritative *shared core* for person identity. It defines the person-specific sub-entities (PersonRelationship, PartialDate, Communication, Language), every person slot, the person controlled vocabularies, and a canonical base `Person`. The cross-cutting building blocks (Identifier, Name, Address, Contact and their vocabularies) live in the `common` module and are imported. The two conformance profiles - `person-subject-of-care.yaml` and `person-connected.yaml` - import this file and redefine `Person` with the cardinalities appropriate to a person who is the subject of care versus a related/connected person. SHACL is generated from the two profile files.""" .

p:person-relationship-code a owl:Class ;
    rdfs:label "PersonRelationshipCode" ;
    dct:title "Person Relationship Code" ;
    owl:unionOf ( prc:FAMMEMB prc:CHILD prc:NCHILD prc:CHLDADOPT prc:DAUADOPT prc:SONADOPT prc:CHLDFOST prc:DAUFOST prc:SONFOST prc:DAUC prc:DAU prc:STPDAU prc:SON prc:SONC prc:STPSON prc:STPCHLD prc:EXT prc:AUNT prc:MAUNT prc:PAUNT prc:UNCLE prc:MUNCLE prc:PUNCLE prc:COUSN prc:MCOUSN prc:PCOUSN prc:NIENEPH prc:NEPHEW prc:NIECE prc:GGRPRN prc:GGRFTH prc:MGGRFTH prc:PGGRFTH prc:GGRMTH prc:MGGRMTH prc:PGGRMTH prc:MGGRPRN prc:PGGRPRN prc:GRPRN prc:GRFTH prc:MGRFTH prc:PGRFTH prc:GRMTH prc:MGRMTH prc:PGRMTH prc:MGRPRN prc:PGRPRN prc:GRNDCHILD prc:GRNDDAU prc:GRNDSON prc:INLAW prc:CHLDINLAW prc:DAUINLAW prc:SONINLAW prc:PRNINLAW prc:FTHINLAW prc:MTHINLAW prc:SIBINLAW prc:BROINLAW prc:SISINLAW prc:PRN prc:NPRN prc:ADOPTP prc:ADOPTF prc:ADOPTM prc:PRNFOST prc:STPPRN prc:FTH prc:NFTH prc:FTHFOST prc:STPFTH prc:MTH prc:NMTH prc:GESTM prc:MTHFOST prc:STPMTH prc:SIB prc:NSIB prc:HSIB prc:STPSIB prc:BRO prc:NBRO prc:HBRO prc:STPBRO prc:SIS prc:NSIS prc:HSIS prc:STPSIS prc:TWIN prc:TWINBRO prc:TWINSIS prc:ITWIN prc:ITWINBRO prc:ITWINSIS prc:FTWIN prc:FTWINBRO prc:FTWINSIS prc:SPS prc:HUSB prc:WIFE prc:FMRSPS prc:DOMPART prc:SIGOTHR prc:FRND prc:NBOR prc:ROOM prc:ONESELF ) ;
    skos:definition "HL7 v3 PersonalRelationshipRoleType concepts describing personal relationships between individuals (family, spousal, foster, adoptive, other)." ;
    skos:inScheme p:person ;
    linkml:permissible_values prc:ADOPTF,
        prc:ADOPTM,
        prc:ADOPTP,
        prc:AUNT,
        prc:BRO,
        prc:BROINLAW,
        prc:CHILD,
        prc:CHLDADOPT,
        prc:CHLDFOST,
        prc:CHLDINLAW,
        prc:COUSN,
        prc:DAU,
        prc:DAUADOPT,
        prc:DAUC,
        prc:DAUFOST,
        prc:DAUINLAW,
        prc:DOMPART,
        prc:EXT,
        prc:FAMMEMB,
        prc:FMRSPS,
        prc:FRND,
        prc:FTH,
        prc:FTHFOST,
        prc:FTHINLAW,
        prc:FTWIN,
        prc:FTWINBRO,
        prc:FTWINSIS,
        prc:GESTM,
        prc:GGRFTH,
        prc:GGRMTH,
        prc:GGRPRN,
        prc:GRFTH,
        prc:GRMTH,
        prc:GRNDCHILD,
        prc:GRNDDAU,
        prc:GRNDSON,
        prc:GRPRN,
        prc:HBRO,
        prc:HSIB,
        prc:HSIS,
        prc:HUSB,
        prc:INLAW,
        prc:ITWIN,
        prc:ITWINBRO,
        prc:ITWINSIS,
        prc:MAUNT,
        prc:MCOUSN,
        prc:MGGRFTH,
        prc:MGGRMTH,
        prc:MGGRPRN,
        prc:MGRFTH,
        prc:MGRMTH,
        prc:MGRPRN,
        prc:MTH,
        prc:MTHFOST,
        prc:MTHINLAW,
        prc:MUNCLE,
        prc:NBOR,
        prc:NBRO,
        prc:NCHILD,
        prc:NEPHEW,
        prc:NFTH,
        prc:NIECE,
        prc:NIENEPH,
        prc:NMTH,
        prc:NPRN,
        prc:NSIB,
        prc:NSIS,
        prc:ONESELF,
        prc:PAUNT,
        prc:PCOUSN,
        prc:PGGRFTH,
        prc:PGGRMTH,
        prc:PGGRPRN,
        prc:PGRFTH,
        prc:PGRMTH,
        prc:PGRPRN,
        prc:PRN,
        prc:PRNFOST,
        prc:PRNINLAW,
        prc:PUNCLE,
        prc:ROOM,
        prc:SIB,
        prc:SIBINLAW,
        prc:SIGOTHR,
        prc:SIS,
        prc:SISINLAW,
        prc:SON,
        prc:SONADOPT,
        prc:SONC,
        prc:SONFOST,
        prc:SONINLAW,
        prc:SPS,
        prc:STPBRO,
        prc:STPCHLD,
        prc:STPDAU,
        prc:STPFTH,
        prc:STPMTH,
        prc:STPPRN,
        prc:STPSIB,
        prc:STPSIS,
        prc:STPSON,
        prc:TWIN,
        prc:TWINBRO,
        prc:TWINSIS,
        prc:UNCLE,
        prc:WIFE .

