@prefix dct: <http://purl.org/dc/terms/> .
@prefix ec: <https://ontology.socialcaredata.io/ethnicity-code#> .
@prefix gc: <https://ontology.socialcaredata.io/gender-code#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p: <https://ontology.socialcaredata.io/> .
@prefix pav: <http://purl.org/pav/> .
@prefix prc: <https://ontology.socialcaredata.io/person-relationship-code#> .
@prefix psc: <https://ontology.socialcaredata.io/phenotypic-sex-code#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

p:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range p:Address ;
    skos:definition "Physical addresses where the person can be contacted." ;
    skos:inScheme p:person .

p:communication a owl:ObjectProperty ;
    rdfs:label "communication" ;
    rdfs:range p:Communication ;
    skos:definition "Professional recording of a person's communication requirements and language proficiencies." ;
    skos:inScheme p:person .

p:contact a owl:ObjectProperty ;
    rdfs:label "contact" ;
    rdfs:range p:Contact ;
    skos:definition "The person's contact information." ;
    skos:inScheme p:person .

p:language a owl:ObjectProperty ;
    rdfs:label "language" ;
    rdfs:range p:Language ;
    skos:definition "Specific language(s) spoken or understood by the person, optionally annotated with proficiency." ;
    skos:inScheme p:person .

p:matchedPersonRef a owl:ObjectProperty ;
    rdfs:label "matchedPersonRef" ;
    rdfs:range p:Identifier ;
    skos:definition "References to other Person records where a cross-system match has been identified. Uses the Identifier structure." ;
    skos:inScheme p:person .

p:primaryContactProfessional a owl:ObjectProperty ;
    rdfs:label "primaryContactProfessional" ;
    rdfs:range p:Identifier ;
    skos:definition "References to the primary professionals related to this person (e.g. care coordinators or a GP). Until the Professional standard is published, recorded using the Identifier structure (system + value)." ;
    skos:inScheme p:person .

p:relatedPerson a owl:ObjectProperty ;
    rdfs:label "relatedPerson" ;
    rdfs:range p:PersonRelationship ;
    skos:definition "References to other people related to this person, with the kind of relationship." ;
    skos:inScheme p:person .

p:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:genderCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:deceasedDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:isDeceased ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:ethnicityCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:sexCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:aboutMe ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:dateOfBirth ] ;
    skos:definition "The top-level record describing an individual. Consolidates the core identity attributes required to distinguish one person from another and to record relationships between individuals. This is the canonical base Person; the two conformance profiles tighten the cardinalities below." ;
    skos:exactMatch p:Person ;
    skos:inScheme p:person .

p:aboutMe a owl:ObjectProperty ;
    rdfs:label "aboutMe" ;
    rdfs:range p:Identifier ;
    skos:definition "A reference pointing to the person's self-reported \"About Me\" profile (an in-use standard across health and care allowing individuals to record their wants and needs). Uses the Identifier structure." ;
    skos:inScheme p:person .

p:date a owl:DatatypeProperty ;
    rdfs:label "date" ;
    rdfs:range xsd:date ;
    skos:definition "ISO 8601-formatted date (YYYY-MM-DD)." ;
    skos:inScheme p:person .

p:dateOfBirth a owl:ObjectProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:range p:PartialDate ;
    skos:definition "The person's date of birth, with an optional accuracy indicator." ;
    skos:inScheme p:person .

p:deceasedDate a owl:ObjectProperty ;
    rdfs:label "deceasedDate" ;
    rdfs:range p:PartialDate ;
    skos:definition "The person's date of death, with an optional accuracy indicator. isDeceased may be true without a known date." ;
    skos:inScheme p:person .

p:ethnicityCode a owl:ObjectProperty ;
    rdfs:label "ethnicityCode" ;
    rdfs:range p:ethnicity-code ;
    skos:definition "The person's stated ethnicity, using the ONS 18+1 categories from the 2021 census. Statutorily required in adult social care; optional elsewhere." ;
    skos:inScheme p:person .

p:genderCode a owl:ObjectProperty ;
    rdfs:label "genderCode" ;
    rdfs:range p:gender-code ;
    skos:definition "The person's stated gender." ;
    skos:inScheme p:person .

p:identifier a owl:ObjectProperty ;
    rdfs:label "identifier" ;
    rdfs:range p:Identifier ;
    skos:definition "Unique identifiers associated with the person (e.g. NHS number, internal case-management system ID)." ;
    skos:inScheme p:person .

p:isDeceased a owl:DatatypeProperty ;
    rdfs:label "isDeceased" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the person is deceased." ;
    skos:inScheme p:person .

p:languageCode a owl:DatatypeProperty ;
    rdfs:label "languageCode" ;
    rdfs:range xsd:string ;
    skos:definition "A code or name representing the language (e.g., 'en', 'eng', 'bsl', 'British Sign Language')." ;
    skos:inScheme p:person .

p:name a owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:range p:Name ;
    skos:definition "A name for the person, with a usage indicating its purpose (usual, maiden, nickname, etc.)." ;
    skos:inScheme p:person .

p:proficiencyLevel a owl:DatatypeProperty ;
    rdfs:label "proficiencyLevel" ;
    rdfs:range xsd:string ;
    skos:definition "The level of proficiency or fluency in the language (e.g., 'fluent', 'native', 'basic')." ;
    skos:inScheme p:person .

p:relationship a owl:ObjectProperty ;
    rdfs:label "relationship" ;
    rdfs:range p:person-relationship-code ;
    skos:definition "One or more codes describing the kind of relationship." ;
    skos:inScheme p:person .

p:sexCode a owl:ObjectProperty ;
    rdfs:label "sexCode" ;
    rdfs:range p:phenotypic-sex-code ;
    skos:definition "Observed phenotypic sex, where recorded." ;
    skos:inScheme p:person .

p:specialCommunicationNeeds a owl:DatatypeProperty ;
    rdfs:label "specialCommunicationNeeds" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text describing professionally recorded communication needs or reasonable adjustments (e.g. BSL interpreter needed, uses communication board)." ;
    skos:inScheme p:person .

p:Communication a owl:Class ;
    rdfs:label "Communication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:specialCommunicationNeeds ] ;
    skos:definition "Professional recording of a person's communication requirements and language proficiencies." ;
    skos:exactMatch p:Communication ;
    skos:inScheme p:person .

p:Language a owl:Class ;
    rdfs:label "Language" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty p:proficiencyLevel ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty p:languageCode ] ;
    skos:definition "A specific language the person is proficient in, including proficiency level." ;
    skos:exactMatch p:Language ;
    skos:inScheme p:person .

p:PersonRelationship a owl:Class ;
    rdfs:label "PersonRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty p:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty p:relationship ] ;
    skos:definition "A typed reference from one person to another. The reference is by Identifier (so the related person may live in a different system) and is qualified by one or more relationship codes." ;
    skos:exactMatch p:PersonRelationship ;
    skos:inScheme p:person .

p:accuracyIndicator a owl:DatatypeProperty ;
    rdfs:label "accuracyIndicator" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[AEU]{3}$" ] ) ] ) ] ;
    skos:definition "A three-character code in day-month-year order indicating which parts of the date are accurate (A), estimated (E), or unknown (U)." ;
    skos:inScheme p:person .

ec:AsianBangladeshi a owl:Class ;
    rdfs:label "1" ;
    dct:title "Asian, Asian British or Asian Welsh: Bangladeshi" ;
    rdfs:subClassOf p:ethnicity-code .

