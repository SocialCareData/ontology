ec:BlackAfrican a owl:Class ;
    rdfs:label "6" ;
    dct:title "Black, Black British, Black Welsh, Caribbean or African: African" ;
    rdfs:subClassOf p:ethnicity-code .

ec:BlackCaribbean a owl:Class ;
    rdfs:label "7" ;
    dct:title "Black, Black British, Black Welsh, Caribbean or African: Caribbean" ;
    rdfs:subClassOf p:ethnicity-code .

ec:BlackOther a owl:Class ;
    rdfs:label "8" ;
    dct:title "Black, Black British, Black Welsh, Caribbean or African: Other Black" ;
    rdfs:subClassOf p:ethnicity-code .

ec:DoesNotApply a owl:Class ;
    rdfs:label "-8" ;
    dct:title "Does not apply (Students and schoolchildren living away during term-time)" ;
    rdfs:subClassOf p:ethnicity-code .

ec:MixedOther a owl:Class ;
    rdfs:label "12" ;
    dct:title "Mixed or Multiple ethnic groups: Other Mixed or Multiple ethnic groups" ;
    rdfs:subClassOf p:ethnicity-code .

ec:MixedWhiteAsian a owl:Class ;
    rdfs:label "9" ;
    dct:title "Mixed or Multiple ethnic groups: White and Asian" ;
    rdfs:subClassOf p:ethnicity-code .

ec:MixedWhiteBlackAfrican a owl:Class ;
    rdfs:label "10" ;
    dct:title "Mixed or Multiple ethnic groups: White and Black African" ;
    rdfs:subClassOf p:ethnicity-code .

ec:MixedWhiteBlackCaribbean a owl:Class ;
    rdfs:label "11" ;
    dct:title "Mixed or Multiple ethnic groups: White and Black Caribbean" ;
    rdfs:subClassOf p:ethnicity-code .

ec:OtherAny a owl:Class ;
    rdfs:label "19" ;
    dct:title "Other ethnic group: Any other ethnic group" ;
    rdfs:subClassOf p:ethnicity-code .

ec:OtherArab a owl:Class ;
    rdfs:label "18" ;
    dct:title "Other ethnic group: Arab" ;
    rdfs:subClassOf p:ethnicity-code .

ec:WhiteBritish a owl:Class ;
    rdfs:label "13" ;
    dct:title "White: English, Welsh, Scottish, Northern Irish or British" ;
    rdfs:subClassOf p:ethnicity-code .

ec:WhiteGypsyOrIrishTraveller a owl:Class ;
    rdfs:label "15" ;
    dct:title "White: Gypsy or Irish Traveller" ;
    rdfs:subClassOf p:ethnicity-code .

ec:WhiteIrish a owl:Class ;
    rdfs:label "14" ;
    dct:title "White: Irish" ;
    rdfs:subClassOf p:ethnicity-code .

ec:WhiteOther a owl:Class ;
    rdfs:label "17" ;
    dct:title "White: Other White" ;
    rdfs:subClassOf p:ethnicity-code .

ec:WhiteRoma a owl:Class ;
    rdfs:label "16" ;
    dct:title "White: Roma" ;
    rdfs:subClassOf p:ethnicity-code .

gc:Female a owl:Class ;
    rdfs:label "2" ;
    dct:title "Female" ;
    rdfs:subClassOf p:gender-code ;
    skos:definition "The person identifies as female." .

gc:Indeterminate a owl:Class ;
    rdfs:label "9" ;
    dct:title "Indeterminate" ;
    rdfs:subClassOf p:gender-code ;
    skos:definition "Unable to be classified as either male or female." .

gc:Male a owl:Class ;
    rdfs:label "1" ;
    dct:title "Male" ;
    rdfs:subClassOf p:gender-code ;
    skos:definition "The person identifies as male." .

gc:NotKnown a owl:Class ;
    rdfs:label "X" ;
    dct:title "Not Known" ;
    rdfs:subClassOf p:gender-code ;
    skos:definition "Not recorded, or information unavailable." .

prc:ADOPTF a owl:Class ;
    rdfs:label "ADOPTF" ;
    dct:title "Adoptive father" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A male parent who legally adopted the scoping person." .

prc:ADOPTM a owl:Class ;
    rdfs:label "ADOPTM" ;
    dct:title "Adoptive mother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A female parent who legally adopted the scoping person." .

prc:ADOPTP a owl:Class ;
    rdfs:label "ADOPTP" ;
    dct:title "Adoptive parent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A parent who legally adopted the scoping person." .

prc:AUNT a owl:Class ;
    rdfs:label "AUNT" ;
    dct:title "Aunt" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Sister of the scoping person's parent." .

prc:BRO a owl:Class ;
    rdfs:label "BRO" ;
    dct:title "Brother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male sibling." .

prc:BROINLAW a owl:Class ;
    rdfs:label "BROINLAW" ;
    dct:title "Brother-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "The spouse's brother, or the husband of the scoping person's sister." .

prc:CHILD a owl:Class ;
    rdfs:label "CHILD" ;
    dct:title "Child" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Offspring of the scoping person." .

prc:CHLDADOPT a owl:Class ;
    rdfs:label "CHLDADOPT" ;
    dct:title "Adopted child" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A child legally adopted and raised by the scoping person." .

prc:CHLDFOST a owl:Class ;
    rdfs:label "CHLDFOST" ;
    dct:title "Foster child" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A child receiving parental care without legal or blood ties." .

prc:CHLDINLAW a owl:Class ;
    rdfs:label "CHLDINLAW" ;
    dct:title "Child-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Spouse of the scoping person's child." .

prc:COUSN a owl:Class ;
    rdfs:label "COUSN" ;
    dct:title "Cousin" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A relative descended from a common ancestor by multiple steps." .

prc:DAU a owl:Class ;
    rdfs:label "DAU" ;
    dct:title "Natural daughter" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Female offspring of the scoping person." .

prc:DAUADOPT a owl:Class ;
    rdfs:label "DAUADOPT" ;
    dct:title "Adopted daughter" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A female child legally adopted and raised by the scoping person." .

prc:DAUC a owl:Class ;
    rdfs:label "DAUC" ;
    dct:title "Daughter" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A female child (of any type) of the scoping person." .

prc:DAUFOST a owl:Class ;
    rdfs:label "DAUFOST" ;
    dct:title "Foster daughter" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A female child receiving foster parental care." .

prc:DAUINLAW a owl:Class ;
    rdfs:label "DAUINLAW" ;
    dct:title "Daughter-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Wife of the scoping person's son." .

prc:DOMPART a owl:Class ;
    rdfs:label "DOMPART" ;
    dct:title "Domestic partner" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A cohabiting partner who is not a spouse." .

prc:EXT a owl:Class ;
    rdfs:label "EXT" ;
    dct:title "Extended family member" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A non-immediate genetic or legal relative (e.g. aunt, cousin)." .

prc:FAMMEMB a owl:Class ;
    rdfs:label "FAMMEMB" ;
    dct:title "Family member" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A familial relationship between two people." .

prc:FMRSPS a owl:Class ;
    rdfs:label "FMRSPS" ;
    dct:title "Former spouse" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A previously married partner; the marriage has been dissolved." .

prc:FRND a owl:Class ;
    rdfs:label "FRND" ;
    dct:title "Friend" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A known, liked, and trusted person who is not a relative." .

prc:FTH a owl:Class ;
    rdfs:label "FTH" ;
    dct:title "Father" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male parent." .

prc:FTHFOST a owl:Class ;
    rdfs:label "FTHFOST" ;
    dct:title "Foster father" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male state-certified caregiver for the scoping person as a foster child." .

prc:FTHINLAW a owl:Class ;
    rdfs:label "FTHINLAW" ;
    dct:title "Father-in-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Father of the scoping person's spouse." .

prc:FTWIN a owl:Class ;
    rdfs:label "FTWIN" ;
    dct:title "Fraternal twin" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A twin from distinct egg/sperm pairs." .

prc:FTWINBRO a owl:Class ;
    rdfs:label "FTWINBRO" ;
    dct:title "Fraternal twin brother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male fraternal twin." .

prc:FTWINSIS a owl:Class ;
    rdfs:label "FTWINSIS" ;
    dct:title "Fraternal twin sister" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Female fraternal twin." .

prc:GESTM a owl:Class ;
    rdfs:label "GESTM" ;
    dct:title "Gestational mother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A woman whose womb carried the foetus (distinct from biological mother where surrogacy is involved)." .

prc:GGRFTH a owl:Class ;
    rdfs:label "GGRFTH" ;
    dct:title "Great-grandfather" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Father of the scoping person's grandparent." .

prc:GGRMTH a owl:Class ;
    rdfs:label "GGRMTH" ;
    dct:title "Great-grandmother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Mother of the scoping person's grandparent." .

prc:GGRPRN a owl:Class ;
    rdfs:label "GGRPRN" ;
    dct:title "Great-grandparent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Parent of the scoping person's grandparent." .

prc:GRFTH a owl:Class ;
    rdfs:label "GRFTH" ;
    dct:title "Grandfather" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Father of the scoping person's parent." .

prc:GRMTH a owl:Class ;
    rdfs:label "GRMTH" ;
    dct:title "Grandmother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Mother of the scoping person's parent." .

prc:GRNDCHILD a owl:Class ;
    rdfs:label "GRNDCHILD" ;
    dct:title "Grandchild" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Child of the scoping person's son or daughter." .

prc:GRNDDAU a owl:Class ;
    rdfs:label "GRNDDAU" ;
    dct:title "Granddaughter" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Daughter of the scoping person's child." .

prc:GRNDSON a owl:Class ;
    rdfs:label "GRNDSON" ;
    dct:title "Grandson" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Son of the scoping person's child." .

prc:GRPRN a owl:Class ;
    rdfs:label "GRPRN" ;
    dct:title "Grandparent" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Parent of the scoping person's parent." .

prc:HBRO a owl:Class ;
    rdfs:label "HBRO" ;
    dct:title "Half-brother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male sibling related by a single biological parent." .

prc:HSIB a owl:Class ;
    rdfs:label "HSIB" ;
    dct:title "Half-sibling" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Related to the scoping person by a single biological parent." .

prc:HSIS a owl:Class ;
    rdfs:label "HSIS" ;
    dct:title "Half-sister" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Female sibling related by a single biological parent." .

prc:HUSB a owl:Class ;
    rdfs:label "HUSB" ;
    dct:title "Husband" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A man joined in marriage." .

prc:INLAW a owl:Class ;
    rdfs:label "INLAW" ;
    dct:title "In-law" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A member of the scoping person's spouse's immediate family." .

prc:ITWIN a owl:Class ;
    rdfs:label "ITWIN" ;
    dct:title "Identical twin" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "A twin from the same egg/sperm pair as the scoping person." .

prc:ITWINBRO a owl:Class ;
    rdfs:label "ITWINBRO" ;
    dct:title "Identical twin brother" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Male identical twin." .

prc:ITWINSIS a owl:Class ;
    rdfs:label "ITWINSIS" ;
    dct:title "Identical twin sister" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Female identical twin." .

prc:MAUNT a owl:Class ;
    rdfs:label "MAUNT" ;
    dct:title "Maternal aunt" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological sister of the scoping person's biological mother." .

prc:MCOUSN a owl:Class ;
    rdfs:label "MCOUSN" ;
    dct:title "Maternal cousin" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological relative via the scoping person's mother's line." .

prc:MGGRFTH a owl:Class ;
    rdfs:label "MGGRFTH" ;
    dct:title "Maternal great-grandfather" ;
    rdfs:subClassOf p:person-relationship-code ;
    skos:definition "Biological father of the scoping person's maternal grandparent." .

prc:MGGRMTH a owl:Class ;
    rdfs:label "MGGRMTH" ;
    dct:title "Maternal great-grandmother" ;
    rdfs:subClassOf p:person-relationship-code ;
